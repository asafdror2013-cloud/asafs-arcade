    <Item class="Script" referent="21">
      <Properties>
        <string name="Name">AetherForgeServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
-- Aether Forge server entry point.
-- Builds the arena and the player character, then starts the services.

local ArenaBuilder = require(script.ArenaBuilder)
local CharacterService = require(script.CharacterService)
local EnemyService = require(script.EnemyService)
local CrystalService = require(script.CrystalService)
local WaveService = require(script.WaveService)
local CombatService = require(script.CombatService)

ArenaBuilder.setupCollisionGroups()
ArenaBuilder.setupLighting()
ArenaBuilder.build()

local ctx = {
	Characters = CharacterService,
	Enemies = EnemyService,
	Crystals = CrystalService,
	Waves = WaveService,
	Combat = CombatService,
}

CharacterService.init(ctx)
EnemyService.init(ctx)
CrystalService.init(ctx)
CombatService.init(ctx)
WaveService.init(ctx)

print("[Aether Forge] server ready")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ArenaBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ArenaBuilder: creates the floating arena Parts from ArenaLayout, sets up lighting and the
-- collision groups.

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local ArenaLayout = require(Shared.ArenaLayout)
local RigBuilder = require(Shared.RigBuilder)

local ArenaBuilder = {}

-- Collision groups used across the game.
--   Player        player characters
--   Enemy         enemy colliders (pass through players, each other and crystals; can fall off)
--   PlayerBarrier invisible ring that only stops players
--   Crystal       crystal nodes (block players, not enemies)
--   Fx            client-side debris (only touches the floor)
function ArenaBuilder.setupCollisionGroups()
	local groups = { "Player", "Enemy", "PlayerBarrier", "Crystal", "Fx" }
	for _, g in groups do
		if not PhysicsService:IsCollisionGroupRegistered(g) then
			PhysicsService:RegisterCollisionGroup(g)
		end
	end
	local function set(a, b, v)
		PhysicsService:CollisionGroupSetCollidable(a, b, v)
	end
	set("Player", "Enemy", false)
	set("Player", "Player", false)
	set("Enemy", "Enemy", false)
	set("Enemy", "PlayerBarrier", false)
	set("Enemy", "Crystal", false)
	set("Fx", "Player", false)
	set("Fx", "Enemy", false)
	set("Fx", "Fx", false)
	set("Fx", "PlayerBarrier", false)
	set("Fx", "Crystal", false)
end

function ArenaBuilder.setupLighting()
	-- Lighting.Technology = Future is set in the place file (scripts cannot change it).
	Lighting.ClockTime = 0.2
	Lighting.Brightness = 1.6
	Lighting.Ambient = Color3.fromRGB(28, 26, 44)
	Lighting.OutdoorAmbient = Color3.fromRGB(52, 50, 82)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.7
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0.15

	for _, c in Lighting:GetChildren() do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end

	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.36
	atmo.Offset = 0.25
	atmo.Color = Color3.fromRGB(96, 74, 150)
	atmo.Decay = Color3.fromRGB(34, 22, 70)
	atmo.Glare = 0.2
	atmo.Haze = 1.4
	atmo.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.StarCount = 5000
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.75
	bloom.Size = 28
	bloom.Threshold = 1.15
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "Grade"
	cc.Contrast = 0.14
	cc.Saturation = 0.12
	cc.TintColor = Color3.fromRGB(255, 248, 246)
	cc.Parent = Lighting
end

local function buildPart(spec, parent)
	local p = RigBuilder.makePart(spec.shape, spec.size, spec.color, spec.material)
	p.Name = spec.name or "Part"
	p.CFrame = spec.cf
	p.Anchored = true
	p.CanCollide = spec.collide == true
	p.CanTouch = false
	if spec.transparency then
		p.Transparency = spec.transparency
	end
	if spec.castShadow == false then
		p.CastShadow = false
	end
	if spec.group then
		p.CollisionGroup = spec.group
	end
	if spec.light then
		RigBuilder.addLight(p, spec.light)
	end
	if spec.kind then
		p:SetAttribute("Kind", spec.kind)
	end
	p.Parent = parent
	return p
end

function ArenaBuilder.build()
	local old = workspace:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	local arena = Instance.new("Folder")
	arena.Name = "Arena"
	for _, spec in ArenaLayout.build() do
		buildPart(spec, arena)
	end
	for _, spec in ArenaLayout.barrier() do
		buildPart(spec, arena)
	end
	arena.Parent = workspace

	for _, name in { "Enemies", "Crystals" } do
		if not workspace:FindFirstChild(name) then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = workspace
		end
	end
	return arena
end

return ArenaBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- CharacterService: builds the warrior-smith StarterCharacter, spawns players, owns player HP.
--
-- Player attributes (replicated): HP, MaxHP, Ore, Dead
-- Server-only per-player combat state lives in CharacterService.state[player].

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Rigs = require(Shared.Rigs)
local RigBuilder = require(Shared.RigBuilder)
local ArenaLayout = require(Shared.ArenaLayout)
local Net = require(Shared.Net)

local CharacterService = {}
CharacterService.state = {} -- [player] = { lastParryT, lastDashT, hurtUntil, riposteUntil, swing... }

local ctx

function CharacterService.buildStarterCharacter()
	local old = StarterPlayer:FindFirstChild("StarterCharacter")
	if old then
		old:Destroy()
	end
	local model = RigBuilder.build(Rigs.Player, {
		name = "StarterCharacter",
		weapon = Rigs.Weapons.EmberBlade,
	})
	local root = model.PrimaryPart
	local attach = Instance.new("Attachment")
	attach.Name = "RootAttachment"
	attach.Parent = root

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.HipHeight = Rigs.Player.hipHeight
	hum.WalkSpeed = Config.Player.WalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = 100
	hum.Health = 100
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.Parent = model

	model.Parent = StarterPlayer
	return model
end

local function spawnPoint(player)
	local list = Players:GetPlayers()
	local idx = table.find(list, player) or 1
	local offset = Vector3.new((idx - 1) % 4 * 5 - 7.5, 0, math.floor((idx - 1) / 4) * 5)
	return ArenaLayout.PlayerSpawn + offset
end

local function setupCharacter(player, char)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Player"
		end
	end
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = "Player"
		end
	end)
	task.defer(function()
		if char.Parent then
			char:PivotTo(CFrame.new(spawnPoint(player)))
		end
	end)
end

function CharacterService.resetPlayer(player)
	player:SetAttribute("MaxHP", Config.Player.MaxHP)
	player:SetAttribute("HP", Config.Player.MaxHP)
	player:SetAttribute("Ore", 0)
	player:SetAttribute("Dead", false)
	CharacterService.state[player] = {
		lastParryT = -100,
		lastDashT = -100,
		hurtUntil = 0,
		riposteUntil = 0,
		swingId = -1,
		swingMove = nil,
		swingHits = {},
		lastSwingStart = { Light = -100, Heavy = -100 },
	}
end

function CharacterService.spawn(player)
	CharacterService.resetPlayer(player)
	player:LoadCharacter()
end

function CharacterService.isAlive(player)
	return player.Parent ~= nil
		and player:GetAttribute("Dead") ~= true
		and player.Character ~= nil
		and player.Character.PrimaryPart ~= nil
end

function CharacterService.rootOf(player)
	local char = player.Character
	return char and char.PrimaryPart
end

function CharacterService.alivePlayers()
	local list = {}
	for _, p in Players:GetPlayers() do
		if CharacterService.isAlive(p) then
			table.insert(list, p)
		end
	end
	return list
end

-- Damage from an enemy. Returns true if it landed.
function CharacterService.damage(player, amount, fromPos)
	local st = CharacterService.state[player]
	if not st or not CharacterService.isAlive(player) then
		return false
	end
	local now = workspace:GetServerTimeNow()
	if now < st.hurtUntil then
		return false
	end
	st.hurtUntil = now + Config.Player.HurtIFrames
	local hp = math.max(0, (player:GetAttribute("HP") or 0) - amount)
	player:SetAttribute("HP", hp)
	Net.Fx:FireAllClients("PlayerHurt", { player = player, amount = amount, from = fromPos })
	if hp <= 0 then
		player:SetAttribute("Dead", true)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 0
		end
		Net.Fx:FireAllClients("PlayerDied", { player = player })
		if ctx and ctx.Waves then
			ctx.Waves.onPlayerDied(player)
		end
	end
	return true
end

function CharacterService.heal(player, amount)
	local max = player:GetAttribute("MaxHP") or Config.Player.MaxHP
	player:SetAttribute("HP", math.min(max, (player:GetAttribute("HP") or 0) + amount))
end

function CharacterService.addOre(player, amount)
	player:SetAttribute("Ore", (player:GetAttribute("Ore") or 0) + amount)
end

function CharacterService.init(context)
	ctx = context
	Players.CharacterAutoLoads = false
	CharacterService.buildStarterCharacter()

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(char)
			setupCharacter(player, char)
		end)
		CharacterService.spawn(player)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		CharacterService.state[player] = nil
	end)
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- CombatService: validates what clients claim and applies the results.
--   Action        records parry/dash timestamps (used to verify parry and dodge claims) and mirrors
--                 the move onto the character for other clients' animation
--   Hit           player hitbox results -> enemy damage / crystal chips (range + rate checked)
--   StrikeReport  forwarded to EnemyService
--   Debug         Studio-only commands from the tuning panel

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Moves = require(Shared.Moves)
local MathUtil = require(Shared.MathUtil)
local ArenaLayout = require(Shared.ArenaLayout)
local Net = require(Shared.Net)

local CombatService = {}

local ctx

local VALID_ACTIONS = {
	Light1 = true,
	Light2 = true,
	Light3 = true,
	Heavy = true,
	Dash = true,
	Parry = true,
	Riposte = true,
}

local function now()
	return workspace:GetServerTimeNow()
end

local function onAction(player, kind, t)
	if typeof(kind) ~= "string" or not VALID_ACTIONS[kind] or typeof(t) ~= "number" then
		return
	end
	local st = ctx.Characters.state[player]
	if not st or not ctx.Characters.isAlive(player) then
		return
	end
	local n = now()
	-- trust the client's timestamp only within a sane window around our own clock
	t = math.clamp(t, n - 1, n + 0.1)
	if kind == "Parry" then
		st.lastParryT = t
	elseif kind == "Dash" then
		st.lastDashT = t
	end
	local char = player.Character
	if char then
		char:SetAttribute("Act", kind)
		char:SetAttribute("ActT", t)
	end
end

local function reachOf(move, targetRadius)
	local h = move.hit
	if h.shape == "arc" then
		return h.range + targetRadius
	end
	return (h.offset or 0) + h.radius + targetRadius
end

local function onHit(player, moveName, swingId, targets)
	local move = Moves[moveName]
	if not move or not move.hit or typeof(swingId) ~= "number" or typeof(targets) ~= "table" then
		return
	end
	local st = ctx.Characters.state[player]
	local root = ctx.Characters.rootOf(player)
	if not st or not root or not ctx.Characters.isAlive(player) then
		return
	end
	local n = now()

	-- a new swing has to respect the move's minimum interval
	if swingId ~= st.swingId then
		local minGap = (Moves.MinSwingInterval[move.kind] or 0.1) * 0.7
		if n - (st.lastSwingStart[move.kind] or -100) < minGap then
			return
		end
		st.lastSwingStart[move.kind] = n
		st.swingId = swingId
		st.swingMove = moveName
		st.swingHits = {}
	elseif st.swingMove ~= moveName then
		return
	end

	local riposte = n < st.riposteUntil
	local dmgMult = if riposte then Config.Player.RiposteDamageMult else 1
	local origin = root.Position
	local facing = root.CFrame.LookVector
	local center = origin
	if move.hit.shape == "circle" then
		center = origin + MathUtil.flatUnit(facing) * (move.hit.offset or 0)
	end

	local count = 0
	for _, target in targets do
		count += 1
		if count > 12 then
			break
		end
		if typeof(target) ~= "Instance" or st.swingHits[target] then
			continue
		end
		local parent = target.Parent
		if parent == workspace.Enemies then
			local e = ctx.Enemies.list[target]
			if e and e.state ~= "Dead" then
				local tpos = e.root.Position
				local flat = Vector3.new(tpos.X - origin.X, 0, tpos.Z - origin.Z)
				if flat.Magnitude <= reachOf(move, e.cfg.Radius) + Moves.ServerRangeTolerance then
					st.swingHits[target] = true
					local knockDir = MathUtil.flatUnit(tpos - center, MathUtil.flatUnit(facing))
					ctx.Enemies.damage(e, move.damage * dmgMult, player, {
						knockDir = knockDir,
						knockback = move.knockback,
						launch = move.launch,
						stagger = move.stagger,
						breaksWindup = move.breaksWindup,
						hitstop = Config.Feel[move.hitstop] or 0,
					})
				end
			end
		elseif parent == workspace.Crystals then
			local c = ctx.Crystals.list[target]
			if c and target.PrimaryPart then
				local tpos = target.PrimaryPart.Position
				local flat = Vector3.new(tpos.X - origin.X, 0, tpos.Z - origin.Z)
				if flat.Magnitude <= reachOf(move, 2) + Moves.ServerRangeTolerance then
					st.swingHits[target] = true
					ctx.Crystals.damage(target, move.crystalDamage or 1, player)
				end
			end
		end
	end
end

local function onStrikeReport(player, enemyModel, strikeId, outcome)
	if typeof(enemyModel) ~= "Instance" then
		return
	end
	ctx.Enemies.report(player, enemyModel, strikeId, outcome)
end

local function onDebug(player, cmd, arg)
	if not RunService:IsStudio() then
		return
	end
	if cmd == "SpawnBrute" then
		local root = ctx.Characters.rootOf(player)
		local pos = ArenaLayout.Portals[math.random(1, #ArenaLayout.Portals)]
		if root then
			pos = root.Position + root.CFrame.LookVector * 16
			pos = Vector3.new(pos.X, 0, pos.Z)
			if pos.Magnitude > ArenaLayout.Radius - 6 then
				pos = pos.Unit * (ArenaLayout.Radius - 8)
			end
		end
		ctx.Enemies.spawn("Brute", pos, math.max(1, workspace:GetAttribute("Wave") or 1))
	elseif cmd == "Passive" then
		ctx.Enemies.passive = arg == true
		workspace:SetAttribute("EnemiesPassive", ctx.Enemies.passive)
	elseif cmd == "PauseWaves" then
		ctx.Waves.paused = arg == true
		workspace:SetAttribute("WavesPaused", ctx.Waves.paused)
	elseif cmd == "KillAll" then
		ctx.Enemies.killAll()
	elseif cmd == "Heal" then
		ctx.Characters.heal(player, 1000)
	elseif cmd == "ResetRun" then
		ctx.Waves.resetRun(true)
	elseif cmd == "God" then
		local st = ctx.Characters.state[player]
		if st then
			st.hurtUntil = if arg == true then math.huge else 0
		end
	end
end

function CombatService.init(context)
	ctx = context
	Net.Action.OnServerEvent:Connect(onAction)
	Net.Hit.OnServerEvent:Connect(onHit)
	Net.StrikeReport.OnServerEvent:Connect(onStrikeReport)
	Net.Debug.OnServerEvent:Connect(onDebug)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">CrystalService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- CrystalService: glowing crystal nodes you mine under pressure.
-- Light hits chip them, the Heavy Slam shatters them in one hit. Breaking one pays ore to the player
-- who broke it, and a new node grows at another spot a few seconds later.
--
-- Crystal model attributes: HP, MaxHP, Tier, Alive, Radius

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local ArenaLayout = require(Shared.ArenaLayout)
local RigBuilder = require(Shared.RigBuilder)
local Net = require(Shared.Net)

local CrystalService = {}
CrystalService.list = {} -- [model] = crystal

local ctx
local folder
local occupied = {} -- [spotIndex] = model

local ROCK = Color3.fromRGB(58, 52, 62)

local function buildNode(tierName, pos)
	local tier = Config.Crystal[tierName]
	local model = Instance.new("Model")
	model.Name = "Crystal"

	local core = RigBuilder.makePart("Block", Vector3.new(3.4, 4.6, 3.4), Color3.new(1, 1, 1), "SmoothPlastic")
	core.Name = "Core"
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = true
	core.CollisionGroup = "Crystal"
	core.CFrame = CFrame.new(pos + Vector3.new(0, 2.3, 0))
	core.Parent = model

	local function piece(shape, size, cf, color, material, glow)
		local p = RigBuilder.makePart(shape, size, color, material)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CFrame = CFrame.new(pos) * cf
		if glow then
			p.CastShadow = false
		end
		p.Parent = model
		return p
	end

	-- rocky base
	piece("Block", Vector3.new(3.6, 0.8, 3.2), CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0.4, 0.05), ROCK, "Basalt")
	piece("Block", Vector3.new(2.4, 0.7, 2.6), CFrame.new(0.6, 0.55, -0.3) * CFrame.Angles(0.1, 1.1, 0), ROCK, "Basalt")
	-- crystal shards (tall main spire + a cluster around it)
	local shards = {
		{ Vector3.new(1.1, 4.4, 1.1), CFrame.new(0, 2.5, 0) * CFrame.Angles(0.08, 0.7, -0.06) },
		{ Vector3.new(0.8, 3.0, 0.8), CFrame.new(1.0, 1.9, 0.4) * CFrame.Angles(0.2, 0.2, -0.45) },
		{ Vector3.new(0.75, 2.6, 0.75), CFrame.new(-1.0, 1.7, -0.2) * CFrame.Angles(-0.15, 1.2, 0.5) },
		{ Vector3.new(0.6, 2.0, 0.6), CFrame.new(0.2, 1.4, -1.1) * CFrame.Angles(-0.5, 0.4, 0.1) },
		{ Vector3.new(0.55, 1.7, 0.55), CFrame.new(-0.4, 1.3, 1.0) * CFrame.Angles(0.5, 0.9, 0.2) },
	}
	for i, s in shards do
		local p = piece("Block", s[1], s[2] * CFrame.Angles(0, math.rad(45), 0), tier.Color, "Neon", true)
		p.Name = "Shard" .. i
		-- pointed tip
		local tip = piece("Wedge", Vector3.new(s[1].X, s[1].X * 0.9, s[1].Z), s[2] * CFrame.new(0, s[1].Y / 2 + s[1].X * 0.45, 0) * CFrame.Angles(0, math.rad(45), 0), tier.Color, "Neon", true)
		tip.Name = "Tip" .. i
	end
	RigBuilder.addLight(core, { color = tier.Color, range = 14, brightness = 2.2 })

	model.PrimaryPart = core
	model:SetAttribute("Tier", tierName)
	model:SetAttribute("MaxHP", tier.HP)
	model:SetAttribute("HP", tier.HP)
	model:SetAttribute("Alive", true)
	model:SetAttribute("Radius", 2.0)
	return model
end

local function freeSpot()
	local options = {}
	for i, spot in ArenaLayout.CrystalSpots do
		if not occupied[i] then
			local clear = true
			for _, p in Players:GetPlayers() do
				local root = p.Character and p.Character.PrimaryPart
				if root and (root.Position - spot).Magnitude < 7 then
					clear = false
				end
			end
			if clear then
				table.insert(options, i)
			end
		end
	end
	if #options == 0 then
		return nil
	end
	return options[math.random(1, #options)]
end

function CrystalService.spawnOne()
	local idx = freeSpot()
	if not idx then
		return nil
	end
	local spot = ArenaLayout.CrystalSpots[idx]
	local model = buildNode("Common", spot)
	model.Parent = folder
	occupied[idx] = model
	local c = { model = model, spot = idx, tier = "Common", hp = Config.Crystal.Common.HP }
	CrystalService.list[model] = c
	return c
end

local function scheduleRespawn(delay)
	task.delay(delay, function()
		local active = 0
		for _ in CrystalService.list do
			active += 1
		end
		if active < Config.Crystal.Spots then
			if not CrystalService.spawnOne() then
				scheduleRespawn(1.5)
			end
		end
	end)
end

function CrystalService.damage(model, amount, player)
	local c = CrystalService.list[model]
	if not c then
		return false
	end
	c.hp -= amount
	model:SetAttribute("HP", math.max(0, c.hp))
	if c.hp > 0 then
		return true
	end
	-- shatter
	local tier = Config.Crystal[c.tier]
	CrystalService.list[model] = nil
	occupied[c.spot] = nil
	model:SetAttribute("Alive", false)
	if player then
		ctx.Characters.addOre(player, tier.Ore)
	end
	Net.Fx:FireAllClients("CrystalBreak", {
		pos = model.PrimaryPart.Position,
		color = tier.Color,
		ore = tier.Ore,
		player = player,
	})
	task.delay(0.05, function()
		model:Destroy()
	end)
	scheduleRespawn(tier.Respawn)
	return true
end

function CrystalService.reset()
	for model in CrystalService.list do
		model:Destroy()
	end
	table.clear(CrystalService.list)
	table.clear(occupied)
	for _ = 1, Config.Crystal.Spots do
		CrystalService.spawnOne()
	end
end

function CrystalService.init(context)
	ctx = context
	folder = workspace:WaitForChild("Crystals")
	CrystalService.reset()
end

return CrystalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- EnemyService: spawns Brutes and runs their AI on the server.
--
-- An enemy is a physics body (invisible collider "Root", pushed by a LinearVelocity, kept upright and
-- facing by an AlignOrientation) with a visual rig welded on. Clients animate the rig from replicated
-- attributes, so state changes are timestamped with server time:
--   State      Spawn | Chase | Windup | Strike | Recover | Stunned | Flinch | Dead
--   StateT     server time the state began
--   StrikeT    server time the current windup's strike lands (Windup only)
--   StrikeId   increments every windup; clients report how each strike resolved for them
--   HP / MaxHP, Kind
--
-- Strike resolution: the client of the targeted player decides parry / dodge / hurt at StrikeT (that
-- is what feels fair at any ping), reports it, and the server checks the claim against the actions it
-- saw (parry and dash timestamps). If no report arrives in time, the server checks range itself.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Moves = require(Shared.Moves)
local Rigs = require(Shared.Rigs)
local RigBuilder = require(Shared.RigBuilder)
local ArenaLayout = require(Shared.ArenaLayout)
local MathUtil = require(Shared.MathUtil)
local Net = require(Shared.Net)

local EnemyService = {}
EnemyService.list = {} -- [model] = enemy
EnemyService.passive = false -- debug: enemies never attack

local ctx
local pendingStrikes = {}
local folder

local function now()
	return workspace:GetServerTimeNow()
end

local function setState(e, state, extra)
	e.state = state
	e.stateT = now()
	e.model:SetAttribute("State", state)
	e.model:SetAttribute("StateT", e.stateT)
	if extra then
		for k, v in extra do
			e.model:SetAttribute(k, v)
		end
	end
end

local function flatDir(from, to)
	return MathUtil.flatUnit(to - from)
end

function EnemyService.count()
	local n = 0
	for _, e in EnemyService.list do
		if e.state ~= "Dead" then
			n += 1
		end
	end
	return n
end

function EnemyService.spawn(kind, position, wave)
	kind = kind or "Brute"
	local cfg = Config.Enemy[kind]
	local scale = 1 + (math.max(1, wave or 1) - 1) * Config.Waves.HPScale
	local model, built = RigBuilder.build(Rigs[kind], { name = kind, collisionGroup = "Enemy" })
	local root = built.parts.Root
	root.CustomPhysicalProperties = PhysicalProperties.new(4, 0, 0, 1, 1)
	root.CanQuery = true

	local att = Instance.new("Attachment")
	att.Name = "RootAttachment"
	att.Parent = root

	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.xAxis
	lv.SecondaryTangentAxis = Vector3.zAxis
	lv.PlaneVelocity = Vector2.zero
	lv.MaxForce = 1e6
	lv.Parent = root

	local ao = Instance.new("AlignOrientation")
	ao.Name = "Face"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.MaxAngularVelocity = math.huge
	ao.Responsiveness = 60
	ao.Parent = root

	local toCenter = flatDir(position, Vector3.zero)
	local yaw = MathUtil.yawFromDir(toCenter)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, yaw, 0))
	ao.CFrame = CFrame.Angles(0, yaw, 0)

	local hp = math.floor(cfg.MaxHP * scale + 0.5)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("MaxHP", hp)
	model:SetAttribute("HP", hp)
	model:SetAttribute("StrikeId", 0)
	model:SetAttribute("Radius", cfg.Radius)
	model.Parent = folder
	root:SetNetworkOwner(nil)

	local windup = math.max(Config.Waves.MinWindup, cfg.Windup * (1 - ((wave or 1) - 1) * Config.Waves.WindupScale))
	local e = {
		model = model,
		root = root,
		lv = lv,
		ao = ao,
		cfg = cfg,
		kind = kind,
		hp = hp,
		yaw = yaw,
		windup = windup,
		strikeId = 0,
		cooldownUntil = 0,
		knock = Vector3.zero,
		slowUntil = 0,
		flinchUntil = 0,
		stunUntil = 0,
		target = nil,
		earlyReports = {},
	}
	EnemyService.list[model] = e
	setState(e, "Spawn")
	return e
end

local function die(e, killer, reason)
	if e.state == "Dead" then
		return
	end
	setState(e, "Dead")
	e.model:SetAttribute("HP", 0)
	e.lv.PlaneVelocity = Vector2.zero
	Net.Fx:FireAllClients("EnemyDied", { pos = e.root.Position, reason = reason, kind = e.kind })
	if killer and ctx.Characters.state[killer] then
		ctx.Characters.addOre(killer, 1)
	end
	task.delay(0.8, function()
		EnemyService.list[e.model] = nil
		e.model:Destroy()
	end)
	if ctx.Waves then
		ctx.Waves.onEnemyDied(e)
	end
end

function EnemyService.killAll()
	for _, e in EnemyService.list do
		die(e, nil, "Debug")
	end
end

-- Player damage. `opts` = { knockDir, knockback, launch, stagger, breaksWindup, hitstop }
function EnemyService.damage(e, amount, player, opts)
	if e.state == "Dead" or e.state == "Spawn" then
		return false
	end
	if e.state == "Stunned" then
		amount *= 1.25
	end
	amount = math.floor(amount + 0.5)
	e.hp -= amount
	e.model:SetAttribute("HP", math.max(0, e.hp))
	if e.hp <= 0 then
		die(e, player, "Killed")
		-- dead bodies still get launched a bit so the shatter flies the right way
		e.knock = (opts.knockDir or Vector3.zero) * (opts.knockback or 0) * 0.5
		return true
	end

	-- Knockback lands after the attacker's hitstop so the freeze frame reads first.
	local delay = opts.hitstop or 0
	task.delay(delay, function()
		if e.state == "Dead" then
			return
		end
		local massScale = 30 / (e.cfg.Mass or 30)
		e.knock += (opts.knockDir or Vector3.zero) * (opts.knockback or 0) * massScale
		if opts.launch and opts.launch > 0 then
			local v = e.root.AssemblyLinearVelocity
			e.root.AssemblyLinearVelocity = Vector3.new(v.X, opts.launch * massScale, v.Z)
		end
	end)

	local stagger = opts.stagger or 0
	if e.state == "Windup" and not opts.breaksWindup then
		-- super armor: light hits do not interrupt a windup (parry or slam it instead)
		return true
	end
	if e.state == "Stunned" then
		return true
	end
	if stagger > 0 then
		e.flinchUntil = now() + stagger + delay
		if e.state ~= "Flinch" then
			setState(e, "Flinch")
		else
			e.model:SetAttribute("StateT", now())
		end
	end
	return true
end

local function slowNearby(pos, untilT)
	for _, other in EnemyService.list do
		if other.state ~= "Dead" and (other.root.Position - pos).Magnitude < Config.Enemy.ParrySlowRadius then
			other.slowUntil = math.max(other.slowUntil, untilT)
		end
	end
end

local function applyParry(e, player)
	if e.state == "Dead" then
		return
	end
	local t = now()
	e.stunUntil = t + e.cfg.ParryStun
	setState(e, "Stunned")
	local root = ctx.Characters.rootOf(player)
	if root then
		e.knock += flatDir(root.Position, e.root.Position) * 18
	end
	local st = ctx.Characters.state[player]
	if st then
		st.riposteUntil = t + Config.Player.RiposteDuration
	end
	slowNearby(e.root.Position, t + Config.Feel.ParrySlowmoDuration)
	Net.Fx:FireAllClients("Parried", { player = player, enemy = e.model })
end

local function inStrikeArc(origin, facing, pos, range, arc, slack)
	local d = Vector3.new(pos.X - origin.X, 0, pos.Z - origin.Z)
	local dist = d.Magnitude
	if dist > range + slack then
		return false, dist
	end
	if dist < 1.5 then
		return true, dist
	end
	local ang = math.deg(math.acos(math.clamp(facing:Dot(d / dist), -1, 1)))
	return ang <= arc / 2 + slack * 4, dist
end

local function resolve(pending, player, outcome)
	if pending.resolved[player] then
		return
	end
	pending.resolved[player] = true
	local e = pending.enemy
	local st = ctx.Characters.state[player]
	if not st or not ctx.Characters.isAlive(player) or e.state == "Dead" then
		return
	end
	local strikeT = pending.t
	local root = ctx.Characters.rootOf(player)
	local range, arc = e.cfg.AttackRange + Config.Player.BodyRadius, e.cfg.AttackArc

	if outcome == "parry" then
		local d = strikeT - st.lastParryT
		if d >= -0.08 and d <= Moves.Parry.active[2] + 0.15 then
			applyParry(e, player)
			return
		end
		outcome = "hurt"
	elseif outcome == "dodge" then
		local d = strikeT - st.lastDashT
		if (d >= -0.08 and d <= Moves.Dash.iframes[2] + 0.15) or strikeT < st.hurtUntil + 0.1 then
			return
		end
		outcome = "hurt"
	elseif outcome == "miss" or outcome == "timeout" then
		if not root then
			return
		end
		-- Accept a miss unless the player is clearly deep inside the strike zone.
		local slack = if outcome == "timeout" then 0.5 else -range * 0.4
		local hitNow = inStrikeArc(pending.origin, pending.facing, root.Position, range, arc, slack)
		if not hitNow then
			return
		end
		local d = strikeT - st.lastDashT
		if d >= -0.08 and d <= Moves.Dash.iframes[2] + 0.15 then
			return
		end
		outcome = "hurt"
	end

	if outcome == "hurt" then
		ctx.Characters.damage(player, pending.damage, pending.origin)
	end
end

local function beginStrike(e)
	local origin = e.root.Position
	local facing = MathUtil.dirFromYaw(e.yaw)
	local pending = {
		enemy = e,
		id = e.strikeId,
		t = e.strikeT,
		origin = origin,
		facing = facing,
		damage = e.cfg.Damage,
		candidates = {},
		resolved = {},
	}
	local range = e.cfg.AttackRange + Config.Player.BodyRadius
	for _, p in ctx.Characters.alivePlayers() do
		local root = ctx.Characters.rootOf(p)
		if root and inStrikeArc(origin, facing, root.Position, range, e.cfg.AttackArc, 4) then
			pending.candidates[p] = true
		end
	end
	table.insert(pendingStrikes, pending)
	-- reports that arrived before the server reached StrikeT
	local early = e.earlyReports[e.strikeId]
	if early then
		for p, outcome in early do
			resolve(pending, p, outcome)
		end
		e.earlyReports[e.strikeId] = nil
	end
	setState(e, "Strike")
	-- small forward lurch with the slam
	e.knock += facing * 10
end

function EnemyService.report(player, model, strikeId, outcome)
	local e = EnemyService.list[model]
	if not e or typeof(strikeId) ~= "number" then
		return
	end
	if outcome ~= "parry" and outcome ~= "dodge" and outcome ~= "hurt" and outcome ~= "miss" then
		return
	end
	for _, pending in pendingStrikes do
		if pending.enemy == e and pending.id == strikeId then
			resolve(pending, player, outcome)
			return
		end
	end
	if strikeId == e.strikeId and e.state == "Windup" then
		e.earlyReports[strikeId] = e.earlyReports[strikeId] or {}
		e.earlyReports[strikeId][player] = outcome
	end
end

local function nearestPlayer(pos)
	local best, bestD = nil, math.huge
	for _, p in ctx.Characters.alivePlayers() do
		local root = ctx.Characters.rootOf(p)
		if root then
			local d = (root.Position - pos).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best, bestD
end

-- Steering: seek the target, slide around the anvil, keep space between enemies.
local function steer(e, targetPos)
	local pos = e.root.Position
	local desired = flatDir(pos, targetPos)
	-- anvil avoidance
	local toAnvil = Vector3.new(ArenaLayout.AnvilPos.X - pos.X, 0, ArenaLayout.AnvilPos.Z - pos.Z)
	local anvilDist = toAnvil.Magnitude
	local avoidR = ArenaLayout.AnvilRadius + e.cfg.Radius + 1
	if anvilDist < avoidR + 6 and desired:Dot(toAnvil / math.max(anvilDist, 1e-3)) > 0.3 then
		local side = Vector3.new(-toAnvil.Z, 0, toAnvil.X).Unit
		if side:Dot(desired) < 0 then
			side = -side
		end
		local w = math.clamp((avoidR + 6 - anvilDist) / 6, 0, 1)
		desired = (desired * (1 - w) + side * w)
	end
	-- separation
	local sep = Vector3.zero
	for _, o in EnemyService.list do
		if o ~= e and o.state ~= "Dead" then
			local d = Vector3.new(pos.X - o.root.Position.X, 0, pos.Z - o.root.Position.Z)
			local m = d.Magnitude
			local minD = e.cfg.Radius + o.cfg.Radius + 1.5
			if m > 1e-3 and m < minD then
				sep += d / m * (minD - m) / minD
			end
		end
	end
	desired += sep * 1.6
	if desired.Magnitude > 1e-3 then
		desired = desired.Unit
	end
	return desired
end

local function update(e, dt)
	if e.state == "Dead" then
		e.knock *= math.exp(-4 * dt)
		e.lv.PlaneVelocity = Vector2.new(e.knock.X, e.knock.Z)
		return
	end
	local t = now()
	local timeScale = if t < e.slowUntil then 0.25 else 1
	local sdt = dt * timeScale
	local cfg = e.cfg
	local pos = e.root.Position
	local move = Vector3.zero
	local turnSharp = cfg.TurnSharpness

	if pos.Y < ArenaLayout.KillY then
		die(e, nil, "RingOut")
		return
	end

	local state = e.state
	if state == "Spawn" then
		if t - e.stateT >= cfg.SpawnTime then
			setState(e, "Chase")
		end
	elseif state == "Chase" then
		local target, dist = nearestPlayer(pos)
		e.target = target
		if target then
			local troot = ctx.Characters.rootOf(target)
			local tpos = troot.Position
			local faceDir = flatDir(pos, tpos)
			e.yaw = MathUtil.dampAngle(e.yaw, MathUtil.yawFromDir(faceDir), turnSharp, sdt)
			if dist > cfg.Engage then
				move = steer(e, tpos) * cfg.MoveSpeed
			else
				move = steer(e, pos) * cfg.MoveSpeed * 0.3 -- just separation when in range
			end
			if dist <= cfg.Engage and t >= e.cooldownUntil and not EnemyService.passive then
				e.strikeId += 1
				e.strikeT = t + e.windup
				setState(e, "Windup", { StrikeT = e.strikeT, StrikeId = e.strikeId, Target = target.UserId })
			end
		end
	elseif state == "Windup" then
		local progress = (t - e.stateT) / math.max(e.windup, 0.01)
		if progress < cfg.TrackUntil and e.target and ctx.Characters.isAlive(e.target) then
			local troot = ctx.Characters.rootOf(e.target)
			if troot then
				e.yaw = MathUtil.dampAngle(e.yaw, MathUtil.yawFromDir(flatDir(pos, troot.Position)), turnSharp * 0.8, sdt)
			end
		end
		if t >= e.strikeT then
			beginStrike(e)
		end
	elseif state == "Strike" then
		if t - e.stateT >= 0.25 then
			setState(e, "Recover")
		end
	elseif state == "Recover" then
		if t - e.stateT >= cfg.Recover then
			e.cooldownUntil = t + cfg.Cooldown * (0.7 + math.random() * 0.6)
			setState(e, "Chase")
		end
	elseif state == "Stunned" then
		if t >= e.stunUntil then
			e.cooldownUntil = t + 0.6
			setState(e, "Chase")
		end
	elseif state == "Flinch" then
		if t >= e.flinchUntil then
			setState(e, "Chase")
		end
	end

	-- slow time also stretches the state timers
	if timeScale < 1 then
		local lost = dt - sdt
		e.stateT += lost
		if e.strikeT and e.state == "Windup" then
			e.strikeT += lost
			e.model:SetAttribute("StrikeT", e.strikeT)
		end
		e.stunUntil += lost
		e.flinchUntil += lost
		e.model:SetAttribute("StateT", e.stateT)
	end

	e.knock *= math.exp(-6 * dt)
	if e.knock.Magnitude < 0.3 then
		e.knock = Vector3.zero
	end
	local v = move * timeScale + e.knock
	e.lv.PlaneVelocity = Vector2.new(v.X, v.Z)
	e.ao.CFrame = CFrame.Angles(0, e.yaw, 0)
end

local function updatePending()
	local t = now()
	for i = #pendingStrikes, 1, -1 do
		local pending = pendingStrikes[i]
		if t - pending.t > Config.Enemy.StrikeReportTimeout then
			for p in pending.candidates do
				if not pending.resolved[p] then
					resolve(pending, p, "timeout")
				end
			end
			table.remove(pendingStrikes, i)
		end
	end
end

function EnemyService.init(context)
	ctx = context
	folder = workspace:WaitForChild("Enemies")
	RunService.Heartbeat:Connect(function(dt)
		for _, e in EnemyService.list do
			update(e, dt)
		end
		updatePending()
	end)
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">WaveService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- WaveService: the run loop. Countdown -> wave (Brutes pour out of the portals) -> breather -> next.
-- When every player is down the run ends, then everything resets.
--
-- workspace attributes (replicated): Wave, Phase ("Countdown" | "Wave" | "Breather" | "Defeat"),
-- EnemiesLeft, PhaseEnds (server time), WavesPaused

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local ArenaLayout = require(Shared.ArenaLayout)
local Net = require(Shared.Net)

local WaveService = {}
WaveService.paused = false

local ctx
local runId = 0
local toSpawn = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function setPhase(phase, duration)
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEnds", if duration then now() + duration else 0)
end

local function updateLeft()
	workspace:SetAttribute("EnemiesLeft", ctx.Enemies.count() + toSpawn)
end

-- Pick the portal farthest from the players so enemies never pop out on top of someone.
local function pickPortal()
	local best, bestScore = ArenaLayout.Portals[1], -math.huge
	for _, portal in ArenaLayout.Portals do
		local score = math.random() * 12
		for _, p in Players:GetPlayers() do
			local root = p.Character and p.Character.PrimaryPart
			if root then
				score += math.min((root.Position - portal).Magnitude, 40)
			end
		end
		if score > bestScore then
			best, bestScore = portal, score
		end
	end
	return best
end

local function anyAlive()
	return #ctx.Characters.alivePlayers() > 0
end

function WaveService.onEnemyDied(_e)
	task.defer(updateLeft)
end

function WaveService.onPlayerDied(_player)
	-- the run loop polls for defeat
end

local function waitWhile(cond, myRun)
	while cond() and runId == myRun do
		task.wait(0.1)
	end
	return runId == myRun
end

function WaveService.resetRun(respawnPlayers)
	runId += 1
	toSpawn = 0
	ctx.Enemies.killAll()
	ctx.Crystals.reset()
	workspace:SetAttribute("Wave", 0)
	updateLeft()
	if respawnPlayers then
		for _, p in Players:GetPlayers() do
			ctx.Characters.spawn(p)
		end
	end
	Net.Run:FireAllClients("Reset", {})
	local myRun = runId
	task.spawn(function()
		WaveService.loop(myRun)
	end)
end

function WaveService.loop(myRun)
	-- wait for someone to be in the arena
	if not waitWhile(function()
		return not anyAlive()
	end, myRun) then
		return
	end
	setPhase("Countdown", Config.Waves.FirstDelay)
	Net.Run:FireAllClients("Countdown", { duration = Config.Waves.FirstDelay })
	task.wait(Config.Waves.FirstDelay)

	local wave = 0
	while runId == myRun do
		if not waitWhile(function()
			return WaveService.paused
		end, myRun) then
			return
		end
		wave += 1
		local count = math.min(Config.Waves.Max, Config.Waves.Base + (wave - 1) * Config.Waves.Growth)
		workspace:SetAttribute("Wave", wave)
		setPhase("Wave")
		toSpawn = count
		updateLeft()
		Net.Run:FireAllClients("Wave", { wave = wave, count = count })

		for _ = 1, count do
			if runId ~= myRun or not anyAlive() then
				break
			end
			ctx.Enemies.spawn("Brute", pickPortal(), wave)
			toSpawn -= 1
			updateLeft()
			task.wait(Config.Waves.SpawnInterval)
		end
		toSpawn = 0

		-- fight until the wave is gone or everyone is down
		if not waitWhile(function()
			return ctx.Enemies.count() > 0 and anyAlive()
		end, myRun) then
			return
		end

		if not anyAlive() then
			setPhase("Defeat", 5)
			Net.Run:FireAllClients("Defeat", { wave = wave })
			task.wait(5)
			if runId == myRun then
				WaveService.resetRun(true)
			end
			return
		end

		setPhase("Breather", Config.Waves.Breather)
		Net.Run:FireAllClients("WaveCleared", { wave = wave, breather = Config.Waves.Breather })
		for _, p in ctx.Characters.alivePlayers() do
			ctx.Characters.heal(p, 15)
		end
		task.wait(Config.Waves.Breather)
	end
end

function WaveService.init(context)
	ctx = context
	workspace:SetAttribute("WavesPaused", false)
	task.defer(WaveService.resetRun, false)
end

return WaveService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="28">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="29">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">21</float>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="30">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Replaces Roblox's default "Animate" script. Aether Forge animates the character procedurally
-- (see AetherForgeClient.RigAnimator), so the default animation player must not run.
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="32">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Replaces Roblox's default "Health" regeneration script. Player HP lives in the HP attribute and is
-- managed by the server's CharacterService.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">AetherForgeClient</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Aether Forge client entry point: wires input, camera, combat, enemy views, effects, HUD and the
-- tuning panel into one frame loop, and turns server events into effects.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Clock = require(script.Clock)
local Sfx = require(script.Sfx)
local Effects = require(script.Effects)
local Input = require(script.Input)
local CameraRig = require(script.CameraRig)
local EnemyViews = require(script.EnemyViews)
local Combat = require(script.Combat)
local OtherPlayers = require(script.OtherPlayers)
local Hud = require(script.Hud)
local TuningPanel = require(script.TuningPanel)

local player = Players.LocalPlayer
local P = Config.Palette

Effects.init()
Sfx.preload()
Input.init(Clock)
EnemyViews.init()
Combat.init()
OtherPlayers.init()
Hud.init(Combat)
TuningPanel.init(Combat)

Combat.hooks.onHits = function(_, total)
	Hud.combo(total)
end

CameraRig.init(function()
	local root = Combat.root()
	if not root or not root.Parent then
		return nil
	end
	local vel = root.AssemblyLinearVelocity
	local lead = Vector3.new(vel.X, 0, vel.Z) / math.max(Config.Player.WalkSpeed, 1)
	return root.Position - Vector3.new(0, 1.5, 0), lead
end)

------------------------------------------------------------------------ arena ambience
local spinners, cores, portals = {}, {}, {}
task.spawn(function()
	local arena = workspace:WaitForChild("Arena")
	local function scan(p)
		if p:IsA("BasePart") then
			local kind = p:GetAttribute("Kind")
			if kind == "Spin" then
				table.insert(spinners, { part = p, base = p.CFrame, speed = 0.6 + math.random() * 0.6 })
			elseif kind == "ForgeCore" then
				table.insert(cores, { part = p, base = p.CFrame })
			elseif kind == "Portal" then
				table.insert(portals, { part = p, base = p.Size })
			end
		end
	end
	for _, p in arena:GetChildren() do
		scan(p)
	end
	arena.ChildAdded:Connect(scan)
end)

local function updateAmbience()
	local t = Clock.real
	for _, s in spinners do
		s.part.CFrame = CFrame.new(s.base.Position + Vector3.new(0, math.sin(t * 1.2 + s.speed * 5) * 0.6, 0)) * CFrame.Angles(0, t * s.speed, 0) * s.base.Rotation
	end
	for _, c in cores do
		c.part.CFrame = CFrame.new(c.base.Position + Vector3.new(0, math.sin(t * 1.6) * 0.5, 0)) * CFrame.Angles(t * 0.7, t * 1.1, 0)
	end
	for i, p in portals do
		local s = 1 + 0.15 * math.sin(t * 3 + i)
		p.part.Size = Vector3.new(p.base.X, p.base.Y * s, p.base.Z * s)
	end
end

-- crystals grow in when they appear
task.spawn(function()
	local folder = workspace:WaitForChild("Crystals")
	folder.ChildAdded:Connect(function(model)
		if not model:IsA("Model") then
			return
		end
		task.defer(function()
			if not model.Parent then
				return
			end
			local ok = pcall(function()
				model:ScaleTo(0.15)
			end)
			if not ok then
				return
			end
			local t = 0
			local conn
			conn = RunService.Heartbeat:Connect(function(dt)
				t += dt
				local k = math.clamp(t / 0.45, 0, 1)
				local e = 1 - (1 - k) ^ 3
				if model.Parent then
					pcall(function()
						model:ScaleTo(0.15 + 0.85 * e + math.sin(k * math.pi) * 0.12)
					end)
				end
				if k >= 1 or not model.Parent then
					conn:Disconnect()
					if model.Parent then
						pcall(function()
							model:ScaleTo(1)
						end)
					end
				end
			end)
		end)
	end)
end)

------------------------------------------------------------------------ server events
local function charRoot(p)
	local c = p and p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

Net.Fx.OnClientEvent:Connect(function(kind, data)
	if kind == "CrystalBreak" then
		local pos = data.pos
		local color = data.color or P.Aether
		Effects.flash(pos, color, 7, 0.18)
		Effects.sparks(pos, Vector3.yAxis, color, 30, 1.2)
		Effects.debris(pos, { color }, 12, 0.7, 34)
		Effects.shockwave(Vector3.new(pos.X, 0, pos.Z), 7, color, 0.35)
		Sfx.play("CrystalBreak")
		local target = data.player
		Effects.oreFly(pos, function()
			local r = charRoot(target)
			return r and r.Position
		end, color, data.ore or 3, function()
			if target == player then
				Sfx.play("Ore")
				Hud.orePulse()
			end
		end)
	elseif kind == "EnemyDied" then
		if data.reason == "RingOut" then
			local p = data.pos
			local edge = Vector3.new(p.X, 0, p.Z)
			if edge.Magnitude > 1 then
				edge = edge.Unit * math.min(edge.Magnitude, Config.Arena.Radius - 4)
			end
			Effects.callout(edge, "RING OUT!", P.Ember)
		end
	elseif kind == "Parried" then
		if data.player ~= player and data.enemy and data.enemy.Parent then
			local root = data.enemy:FindFirstChild("Root")
			if root then
				Effects.sparks(root.Position + Vector3.new(0, 3, 0), Vector3.yAxis, P.Gold, 24, 1.2)
				Effects.flash(root.Position + Vector3.new(0, 3, 0), Color3.new(1, 1, 1), 5, 0.14)
				Sfx.play("Parry", 0.5)
			end
		end
	elseif kind == "PlayerHurt" then
		local r = charRoot(data.player)
		if r then
			Effects.number(r.Position + Vector3.new(0, 3, 0), "-" .. tostring(data.amount), P.Danger, false)
		end
		if data.player ~= player then
			OtherPlayers.hurt(data.player)
		end
	end
end)

Net.Run.OnClientEvent:Connect(function(kind, data)
	if kind == "Countdown" then
		Hud.banner("GET READY", "Smash crystals for ore. Parry on the flash.", P.Aether, 2.6)
	elseif kind == "Wave" then
		Hud.banner("WAVE " .. data.wave, data.count .. (if data.count == 1 then " Shard Brute" else " Shard Brutes"), Color3.new(1, 1, 1), 2)
		Sfx.play("Wave")
	elseif kind == "WaveCleared" then
		Hud.banner("WAVE CLEARED", "+15 HP  ·  next wave in " .. data.breather, P.Aether, 2.4)
	elseif kind == "Defeat" then
		Hud.banner("DEFEATED", "You reached wave " .. data.wave, P.Danger, 4.5)
	end
end)

------------------------------------------------------------------------ frame loop
RunService.PreSimulation:Connect(function(realDt)
	local simDt = Clock.step(realDt)
	Combat.update(realDt, simDt)
	EnemyViews.update(realDt, simDt, Combat.onStrike)
	OtherPlayers.update(realDt, simDt)
	Effects.update(realDt)
	updateAmbience()
	Hud.update(realDt)
end)

print("[Aether Forge] client ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CameraRig</string>
            <string name="Source"><![CDATA[--!nonstrict
-- CameraRig: angled arena camera that follows the player, with game-feel layers:
--   trauma shake (strength grows with trauma squared, smooth noise), directional kick (spring),
--   FOV punch (spring), slight lead toward where you move/aim, mouse-wheel zoom.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local MathUtil = require(Shared.MathUtil)

local CameraRig = {}

local trauma = 0
local focus = nil
local focusVel = Vector3.zero
local kick, kickVel = Vector3.zero, Vector3.zero
local fov, fovVel = 0, 0
local lead = Vector3.zero
local zoom = 0 -- mouse-wheel offset on top of Config.Camera.Distance
local t = 0
local getTarget -- function() -> (position, leadDir)

function CameraRig.shake(amount)
	trauma = math.clamp(trauma + amount, 0, 1)
end

-- Push the camera along a world direction (it springs back).
function CameraRig.kick(dir, strength)
	kickVel += dir * strength * 60
end

-- Negative = zoom in for a moment.
function CameraRig.punch(amount)
	fovVel += amount * 60
end

local function update(dt)
	local cam = workspace.CurrentCamera
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	t += dt
	local cfg = Config.Camera
	local pos, leadDir = getTarget()
	if not pos then
		return
	end
	lead = MathUtil.damp(lead, (leadDir or Vector3.zero) * cfg.Lead, 4, dt)
	local goal = pos + lead
	if not focus then
		focus = goal
	end
	focus, focusVel = MathUtil.spring(focus, focusVel, goal, cfg.FollowSharpness, dt)

	kick, kickVel = MathUtil.spring(kick, kickVel, Vector3.zero, 22, dt)
	fov, fovVel = MathUtil.spring(fov, fovVel, 0, 18, dt)
	trauma = math.max(0, trauma - cfg.TraumaDecay * dt)

	local pitch = math.rad(cfg.Pitch)
	local distance = math.clamp(cfg.Distance + zoom, cfg.MinDistance, cfg.MaxDistance)
	zoom = distance - cfg.Distance
	local back = Vector3.new(0, math.sin(pitch), math.cos(pitch)) * distance
	local cf = CFrame.lookAt(focus + back + kick, focus + kick)

	local s = trauma * trauma
	if s > 0 then
		local f = cfg.ShakeFrequency
		local ox = MathUtil.noise1(t * f, 1) * cfg.ShakeMaxOffset * s
		local oy = MathUtil.noise1(t * f, 2) * cfg.ShakeMaxOffset * s
		local roll = MathUtil.noise1(t * f, 3) * math.rad(cfg.ShakeMaxRoll) * s
		cf = cf * CFrame.new(ox, oy, 0) * CFrame.Angles(0, 0, roll)
	end
	cam.CFrame = cf
	cam.FieldOfView = math.clamp(cfg.FOV + fov, 20, 100)
end

function CameraRig.init(targetFn)
	getTarget = targetFn
	UserInputService.InputChanged:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			zoom -= input.Position.Z * 3
		end
	end)
	RunService:BindToRenderStep("AetherCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

function CameraRig.snap()
	focus = nil
end

return CameraRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Clock</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Clock: the client's game-feel time. Hitstop freezes local simulation (your swing, enemy poses);
-- slow-motion scales it. Everything that should feel the freeze advances by Clock.dt instead of the
-- real frame time. Defensive windows (parry, i-frames) use server time and are never slowed.

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("AetherForge").Config)

local Clock = {
	real = 0, -- real seconds since start
	sim = 0, -- simulated (scaled) seconds since start
	dt = 0, -- scaled delta of the current frame
	realDt = 0,
	hitstopUntil = 0,
	slowUntil = 0,
	slowStart = 0,
	slowScale = 1,
}

function Clock.hitstop(duration)
	Clock.hitstopUntil = math.max(Clock.hitstopUntil, Clock.real + duration)
end

function Clock.slowmo(scale, duration)
	Clock.slowScale = scale
	Clock.slowStart = Clock.real
	Clock.slowUntil = Clock.real + duration
end

function Clock.inHitstop()
	return Clock.real < Clock.hitstopUntil
end

function Clock.scale()
	local s = Config.Feel.DebugTimeScale or 1
	if Clock.real < Clock.hitstopUntil then
		return 0
	end
	if Clock.real < Clock.slowUntil then
		-- ease back to full speed over the last 40% of the slow-mo
		local total = Clock.slowUntil - Clock.slowStart
		local left = Clock.slowUntil - Clock.real
		local k = math.clamp(left / (total * 0.4), 0, 1)
		s *= Clock.slowScale + (1 - Clock.slowScale) * (1 - k)
	end
	return s
end

function Clock.step(realDt)
	Clock.realDt = realDt
	Clock.real += realDt
	Clock.dt = realDt * Clock.scale()
	Clock.sim += Clock.dt
	return Clock.dt
end

function Clock.server()
	return workspace:GetServerTimeNow()
end

return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Combat: the local player's controller. Owns the move state machine and all the moment-to-moment
-- feel: buffered inputs, combo chains, cancels, lunges with aim assist, hit detection, hitstop,
-- dash i-frames, parry -> riposte, and how enemy strikes resolve against you.
--
-- States: Free | Attack | Dash | Parry | Riposte | Hurt | Dead
-- Move timings come from Moves.luau; feel numbers from Config.Feel (live-tunable).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Moves = require(Shared.Moves)
local Rigs = require(Shared.Rigs)
local Clips = require(Shared.Clips)
local MathUtil = require(Shared.MathUtil)
local Net = require(Shared.Net)

local RigAnimator = require(script.Parent.RigAnimator)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local Clock = require(script.Parent.Clock)
local Input = require(script.Parent.Input)
local CameraRig = require(script.Parent.CameraRig)
local EnemyViews = require(script.Parent.EnemyViews)

local Combat = {}
Combat.hooks = {} -- onHits(count, total), onParry(), onHurt(), onRiposte(untilServerT)
Combat.debugHitbox = false

local player = Players.LocalPlayer
local AETHER = Config.Palette.Aether
local GOLD = Config.Palette.Gold
local UP = Vector3.yAxis

-- character refs
local char, root, humanoid, anim, drive, face, trail

-- state
local state = "Free"
local move = nil
local moveT = 0
local swingId = 0
local hitSet = {}
local attackYaw, facingYaw = 0, 0
local lockTarget = nil -- { pos = fn, radius = n }
local comboNext, comboExpire = nil, 0
local lastDashReal, lastParryReal = -100, -100
local dashDir = Vector3.new(0, 0, -1)
local dashServerT, parryServerT = -100, -100
local hurtIFramesUntil = 0
local riposteUntil = 0
local knockVel = Vector3.zero
local lastAfterimage = 0
local swingSoundDone, slamDone = false, false
local comboCount, comboTimer = 0, 0
local lastPredictedHurt = -100
local prevVel = Vector3.zero
local leanCF = CFrame.identity
local debugParts = {}

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function facingDir()
	return MathUtil.dirFromYaw(facingYaw)
end

local function stunned(model)
	return model:GetAttribute("State") == "Stunned"
end

------------------------------------------------------------------------ targeting

local function crystalTargets()
	local list = {}
	local folder = workspace:FindFirstChild("Crystals")
	if folder then
		for _, m in folder:GetChildren() do
			if m:GetAttribute("Alive") and m.PrimaryPart then
				table.insert(list, m)
			end
		end
	end
	return list
end

-- Best target inside the aim-assist cone: enemies first, crystals if no enemy fits.
local function findLock(aimDir)
	local rp = root.Position
	local best, bestScore = nil, math.huge
	local range, maxAng = Config.Feel.SoftLockRange, Config.Feel.SoftLockAngle
	local function consider(model, pos, radius, bias)
		local d = flat(pos - rp)
		local dist = d.Magnitude
		if dist > range + radius or dist < 0.05 then
			return
		end
		local ang = math.deg(math.acos(math.clamp(aimDir:Dot(d / dist), -1, 1)))
		if ang > maxAng then
			return
		end
		local score = ang / maxAng + dist / range * 0.7 + bias
		if score < bestScore then
			best, bestScore = { model = model, part = model.PrimaryPart, radius = radius }, score
		end
	end
	for _, view in EnemyViews.alive() do
		consider(view.model, view.root.Position, view.cfg.Radius, 0)
	end
	for _, m in crystalTargets() do
		consider(m, m.PrimaryPart.Position, 2, 0.35)
	end
	return best
end

local function aimFor(useLock)
	local aim = Input.aimDirection(root.Position, humanoid.MoveDirection, facingDir())
	aim = MathUtil.flatUnit(aim, facingDir())
	lockTarget = nil
	if useLock then
		lockTarget = findLock(aim)
		if lockTarget and lockTarget.part then
			aim = MathUtil.flatUnit(lockTarget.part.Position - root.Position, aim)
		end
	end
	return aim
end

------------------------------------------------------------------------ hitboxes

local function inHitbox(m, pos, radius)
	local rp = root.Position
	if math.abs(pos.Y - rp.Y) > 8 then
		return false
	end
	local f = MathUtil.dirFromYaw(attackYaw)
	local h = m.hit
	if h.shape == "arc" then
		local d = flat(pos - rp)
		local dist = d.Magnitude
		if dist - radius > h.range then
			return false
		end
		if dist < radius + 1 then
			return true
		end
		local ang = math.deg(math.acos(math.clamp(f:Dot(d / dist), -1, 1)))
		local widen = math.deg(math.asin(math.clamp(radius / dist, 0, 1)))
		return ang <= h.arc / 2 + widen
	else
		local c = rp + f * (h.offset or 0)
		return flat(pos - c).Magnitude - radius <= h.radius
	end
end

local function cutAcross(m, f)
	local across = f:Cross(UP)
	if m.name == "Light1" then
		return (across + UP * 0.3).Unit
	elseif m.name == "Light2" then
		return (across - UP * 0.3).Unit
	elseif m.kind == "Heavy" then
		return (UP + across * 0.25).Unit
	end
	return across
end

local function detectHits()
	local m = move
	if not m or not m.hit or moveT < m.active[1] or moveT > m.active[2] then
		return
	end
	local newEnemies, newCrystals, models = {}, {}, {}
	for _, view in EnemyViews.alive() do
		if not hitSet[view.model] and inHitbox(m, view.root.Position, view.cfg.Radius) then
			hitSet[view.model] = true
			table.insert(newEnemies, view)
			table.insert(models, view.model)
		end
	end
	for _, c in crystalTargets() do
		if not hitSet[c] and inHitbox(m, c.PrimaryPart.Position, 2) then
			hitSet[c] = true
			table.insert(newCrystals, c)
			table.insert(models, c)
		end
	end
	if #models == 0 then
		return
	end
	Net.Hit:FireServer(m.name, swingId, models)

	local f = MathUtil.dirFromYaw(attackYaw)
	local isBig = m.kind == "Heavy" or m.name == "Light3"
	local riposte = Clock.server() < riposteUntil
	if #newEnemies > 0 then
		local hs = Config.Feel[m.hitstop] or 0.05
		Clock.hitstop(hs)
		CameraRig.shake(Config.Feel[m.shake] or 0.2)
		CameraRig.kick(f, if isBig then 0.6 else 0.25)
		if isBig then
			CameraRig.punch(-4)
			Effects.grade(0.1, 0.25, 0.04, 0.2)
		end
		for _, view in newEnemies do
			local epos = view.root.Position
			local dir = MathUtil.flatUnit(epos - root.Position, f)
			local dmg = m.damage * (if riposte then Config.Player.RiposteDamageMult else 1) * (if stunned(view.model) then 1.25 else 1)
			EnemyViews.onLocalHit(view.model, hs, dir, dmg, isBig or riposte)
			local impact = epos + UP * 1.2 - dir * 1.4
			local color = if riposte then GOLD else AETHER
			Effects.sparks(impact, (-dir + UP * 0.4).Unit, color, if isBig then 28 else 16, if isBig then 1.4 else 1)
			Effects.flash(impact, Color3.new(1, 1, 1), if isBig then 7 else 3.6, 0.1)
			Effects.cutLine(impact, cutAcross(m, f), color, if isBig then 10 else 7, 0.16)
		end
		Sfx.play(if isBig then "HitBig" else "Hit")
		comboCount += #newEnemies
		comboTimer = 2.4
		if Combat.hooks.onHits then
			Combat.hooks.onHits(#newEnemies, comboCount)
		end
	end
	for _, c in newCrystals do
		local cpos = c.PrimaryPart.Position
		local dir = MathUtil.flatUnit(cpos - root.Position, f)
		if #newEnemies == 0 then
			Clock.hitstop(Config.Feel.HitstopCrystal)
			CameraRig.shake(0.14)
		end
		local color = c.PrimaryPart:FindFirstChildOfClass("PointLight") and c.PrimaryPart:FindFirstChildOfClass("PointLight").Color or AETHER
		Effects.sparks(cpos - dir * 1.5, (-dir + UP).Unit, color, 14, 0.9)
		Effects.flash(cpos - dir * 1.2, color, 3, 0.1)
		Sfx.play("CrystalHit")
	end
end

local function drawDebugHitbox()
	for _, p in debugParts do
		p.Transparency = 1
	end
	if not Combat.debugHitbox or not move or not move.hit or state ~= "Attack" then
		return
	end
	local active = moveT >= move.active[1] and moveT <= move.active[2]
	local f = MathUtil.dirFromYaw(attackYaw)
	local rp = Vector3.new(root.Position.X, 0.3, root.Position.Z)
	local h = move.hit
	local n = 28
	for i = 1, n do
		local p = debugParts[i]
		if not p then
			p = Effects.newPart("Block", Vector3.new(0.5, 0.1, 0.5), Color3.new(1, 0, 0))
			debugParts[i] = p
		end
		local pos
		if h.shape == "arc" then
			local a = attackYaw - math.rad(h.arc / 2) + (i - 1) / (n - 1) * math.rad(h.arc)
			pos = rp + MathUtil.dirFromYaw(a) * h.range
		else
			local a = (i - 1) / n * math.pi * 2
			pos = rp + f * (h.offset or 0) + Vector3.new(math.sin(a), 0, math.cos(a)) * h.radius
		end
		p.CFrame = CFrame.new(pos)
		p.Color = if active then Color3.fromRGB(255, 60, 60) else Color3.fromRGB(255, 200, 60)
		p.Transparency = 0.2
	end
end

------------------------------------------------------------------------ moves

local function setTrail(on, gold)
	if not trail then
		return
	end
	if on and not trail.Enabled then
		local c = if gold then GOLD else AETHER
		trail.Color = ColorSequence.new(Color3.new(1, 1, 1), c)
	end
	trail.Enabled = on
end

local function startAttack(name)
	move = Moves[name]
	state = "Attack"
	moveT = 0
	swingId += 1
	hitSet = {}
	swingSoundDone, slamDone = false, false
	local aim = aimFor(true)
	attackYaw = MathUtil.yawFromDir(aim)
	facingYaw = attackYaw
	anim:play(move.clip, { fadeIn = 0.035 })
	Net.Action:FireServer(name, Clock.server())
	comboNext = move.next
	comboExpire = Clock.sim + move.length + (move.comboGrace or 0)
end

local function startDash()
	local md = humanoid.MoveDirection
	if md.Magnitude > 0.1 then
		dashDir = MathUtil.flatUnit(md)
	else
		dashDir = aimFor(false)
	end
	move = Moves.Dash
	state = "Dash"
	moveT = 0
	facingYaw = MathUtil.yawFromDir(dashDir)
	lastDashReal = Clock.real
	dashServerT = Clock.server()
	Net.Action:FireServer("Dash", dashServerT)
	anim:play("Dash", { fadeIn = 0.02 })
	setTrail(false)
	Sfx.play("Dash")
	CameraRig.punch(3)
	Effects.afterimage(char, AETHER, 0.3)
	Effects.dust(Vector3.new(root.Position.X, 0.3, root.Position.Z), 6)
	lastAfterimage = Clock.real
end

local function startParry()
	local aim = aimFor(true)
	facingYaw = MathUtil.yawFromDir(aim)
	move = Moves.Parry
	state = "Parry"
	moveT = 0
	lastParryReal = Clock.real
	parryServerT = Clock.server()
	Net.Action:FireServer("Parry", parryServerT)
	anim:play("Parry", { fadeIn = 0.025 })
	setTrail(false)
end

local function canDashCancel()
	if state == "Free" or state == "Riposte" then
		return true
	end
	if state == "Attack" then
		local dc = move.dashCancel
		if dc == "any" then
			return true
		end
		if type(dc) == "table" then
			for _, w in dc do
				if moveT >= w[1] and moveT <= w[2] then
					return true
				end
			end
		end
		return false
	end
	if state == "Hurt" then
		return moveT >= Config.Player.HurtStun
	end
	return false
end

local function tryAction(action)
	if state == "Dead" then
		return false
	end
	if state == "Hurt" and moveT < Config.Player.HurtStun then
		return false
	end
	if action == "Dash" then
		if Clock.real - lastDashReal < Moves.Dash.cooldown or not canDashCancel() then
			return false
		end
		startDash()
		return true
	elseif action == "Light" then
		local nextName = "Light1"
		if comboNext and Clock.sim <= comboExpire then
			nextName = comboNext
		end
		if state == "Free" or state == "Riposte" or state == "Hurt" then
			startAttack(nextName)
			return true
		elseif state == "Attack" then
			if moveT >= move.chainFrom then
				startAttack(if move.next then move.next else "Light1")
				return true
			end
		elseif state == "Dash" then
			if moveT >= Moves.Dash.attackFrom then
				startAttack("Light1")
				return true
			end
		end
		return false
	elseif action == "Heavy" then
		local can = state == "Free"
			or state == "Riposte"
			or state == "Hurt"
			or (state == "Attack" and move.kind == "Light" and moveT >= move.chainFrom)
			or (state == "Dash" and moveT >= Moves.Dash.attackFrom)
		if can then
			startAttack("Heavy")
		end
		return can
	elseif action == "Parry" then
		if Clock.real - lastParryReal < Moves.Parry.cooldown then
			return false
		end
		local can = state == "Free"
			or state == "Riposte"
			or state == "Hurt"
			or (state == "Attack" and move.kind == "Light" and moveT >= move.active[2])
		if can then
			startParry()
		end
		return can
	end
	return false
end

local function processInput()
	local i = 1
	while i <= #Input.buffer do
		local entry = Input.buffer[i]
		if Clock.real - entry.time > Config.Feel.InputBuffer then
			table.remove(Input.buffer, i)
		elseif tryAction(entry.action) then
			table.remove(Input.buffer, i)
			-- one new action per frame keeps buffered chains readable
			return
		else
			i += 1
		end
	end
end

------------------------------------------------------------------------ incoming strikes

local function parrySuccess(view)
	comboNext = nil
	state = "Riposte"
	move = Moves.Riposte
	moveT = 0
	anim:play("Riposte", { fadeIn = 0 })
	riposteUntil = Clock.server() + Config.Player.RiposteDuration
	Clock.hitstop(Config.Feel.HitstopParry)
	Clock.slowmo(Config.Feel.ParrySlowmoScale, Config.Feel.ParrySlowmoDuration)
	local epos = view.root.Position
	local mid = root.Position:Lerp(epos, 0.45) + UP * 1.5
	Effects.sparks(mid, UP, GOLD, 40, 1.5)
	Effects.sparks(mid, MathUtil.flatUnit(root.Position - epos), Color3.new(1, 1, 1), 20, 1.2)
	Effects.flash(mid, Color3.new(1, 1, 1), 7, 0.16)
	Effects.screenFlash(Color3.new(1, 1, 1), 0.35, 0.2)
	Effects.grade(-0.75, 0.25, 0.05, Config.Feel.ParrySlowmoDuration + 0.25)
	Effects.shockwave(Vector3.new(epos.X, 0, epos.Z), 9, GOLD, 0.4)
	Effects.callout(epos, "PARRY!", GOLD)
	CameraRig.shake(Config.Feel.ShakeParry)
	CameraRig.punch(-8)
	EnemyViews.onLocalHit(view.model, Config.Feel.HitstopParry + 0.05, MathUtil.flatUnit(epos - root.Position), nil, true)
	Sfx.play("Parry")
	setTrail(true, true)
	if Combat.hooks.onParry then
		Combat.hooks.onParry(riposteUntil)
	end
end

local function takeHit(fromPos)
	state = "Hurt"
	move = Moves.Hurt
	moveT = 0
	anim:play("Hurt", { fadeIn = 0 })
	setTrail(false)
	hurtIFramesUntil = Clock.server() + Config.Player.HurtIFrames
	local dir = if fromPos then MathUtil.flatUnit(root.Position - fromPos, -facingDir()) else -facingDir()
	knockVel = dir * Config.Player.HurtKnockback
	Clock.hitstop(0.06)
	Effects.vignette(Config.Palette.Danger, 0.65, 0.55)
	Effects.screenFlash(Config.Palette.Danger, 0.78, 0.14)
	Effects.sparks(root.Position + UP, dir, Config.Palette.Danger, 14, 1)
	CameraRig.shake(Config.Feel.ShakeHurt)
	CameraRig.kick(dir, 0.5)
	Sfx.play("Hurt")
	lastPredictedHurt = Clock.real
	Input.clear()
	if Combat.hooks.onHurt then
		Combat.hooks.onHurt()
	end
end

-- Called by EnemyViews the moment an enemy's strike lands (server-scheduled StrikeT).
function Combat.onStrike(view, strikeId)
	if not root or state == "Dead" then
		return
	end
	local model = view.model
	local cfg = view.cfg
	local origin = view.root.Position
	local f = MathUtil.flatUnit(view.root.CFrame.LookVector)
	local range = cfg.AttackRange + Config.Player.BodyRadius
	local d = flat(root.Position - origin)
	local dist = d.Magnitude
	local inArc = dist <= range and (dist < 1.5 or math.deg(math.acos(math.clamp(f:Dot(d / dist), -1, 1))) <= cfg.AttackArc / 2)
	if not inArc then
		if dist < range + 10 then
			Net.StrikeReport:FireServer(model, strikeId, "miss")
		end
		return
	end
	local strikeT = model:GetAttribute("StrikeT") or Clock.server()
	local sinceParry = strikeT - parryServerT
	local sinceDash = strikeT - dashServerT
	-- a press up to 50ms after impact still counts (latency + frame timing grace)
	if sinceParry >= -0.05 and sinceParry <= Moves.Parry.active[2] + 0.02 then
		parrySuccess(view)
		Net.StrikeReport:FireServer(model, strikeId, "parry")
	elseif sinceDash >= -0.03 and sinceDash <= Moves.Dash.iframes[2] + 0.02 then
		Net.StrikeReport:FireServer(model, strikeId, "dodge")
		Effects.afterimage(char, Color3.new(1, 1, 1), 0.35)
		Effects.callout(root.Position, "DODGE", Color3.new(1, 1, 1))
	elseif Clock.server() < hurtIFramesUntil then
		Net.StrikeReport:FireServer(model, strikeId, "dodge")
	else
		takeHit(origin)
		Net.StrikeReport:FireServer(model, strikeId, "hurt")
	end
end

------------------------------------------------------------------------ per-frame

local function stepState(simDt)
	moveT += simDt
	if state == "Attack" then
		local m = move
		if not swingSoundDone and moveT >= m.active[1] - 0.03 then
			swingSoundDone = true
			Sfx.play(m.swingSound or "Swing")
		end
		if m.kind == "Heavy" and not slamDone and moveT >= m.active[1] then
			slamDone = true
			local f = MathUtil.dirFromYaw(attackYaw)
			local pos = Vector3.new(root.Position.X, 0, root.Position.Z) + f * m.hit.offset
			Effects.shockwave(pos, m.hit.radius + 3, AETHER, 0.42, 7)
			Effects.dust(pos + UP * 0.3, 16)
			Effects.sparks(pos + UP * 0.4, UP, AETHER, 26, 1.3)
			Effects.flash(pos + UP, AETHER, 8, 0.14)
			CameraRig.shake(Config.Feel.ShakeSlamWhiff)
			CameraRig.punch(-6)
			Sfx.play("Slam")
		end
		local tw = m.trail
		setTrail(tw ~= nil and moveT >= tw[1] and moveT <= tw[2], Clock.server() < riposteUntil)
		detectHits()
		if moveT >= m.length then
			state = "Free"
			move = nil
			setTrail(false)
		end
	elseif state == "Dash" then
		if Clock.real - lastAfterimage > 0.045 and moveT < Moves.Dash.length * 0.85 then
			lastAfterimage = Clock.real
			Effects.afterimage(char, AETHER, 0.25)
		end
		if moveT >= Moves.Dash.length then
			state = "Free"
			move = nil
		end
	elseif state == "Parry" then
		if moveT >= Moves.Parry.length then
			state = "Free"
			move = nil
		end
	elseif state == "Riposte" then
		setTrail(moveT >= 0.02 and moveT <= 0.14, true)
		if moveT >= Moves.Riposte.length then
			state = "Free"
			move = nil
			setTrail(false)
		end
	elseif state == "Hurt" then
		knockVel *= math.exp(-9 * simDt)
		if moveT >= Moves.Hurt.length then
			state = "Free"
			move = nil
		end
	end
end

local function controlBody(simDt)
	local ts = Clock.scale()
	local walk = Config.Player.WalkSpeed
	local driveVel = nil
	if state == "Free" then
		humanoid.WalkSpeed = walk * ts
		local md = humanoid.MoveDirection
		if md.Magnitude > 0.1 then
			facingYaw = MathUtil.dampAngle(facingYaw, MathUtil.yawFromDir(md), Config.Player.TurnSharpness, simDt)
		end
	elseif state == "Attack" then
		humanoid.WalkSpeed = Config.Player.AttackWalkSpeed * ts
		facingYaw = attackYaw
		local l = move.lunge
		if l and moveT >= l.from and moveT <= l.to then
			local speed = l.speed
			if lockTarget and lockTarget.part and lockTarget.part.Parent then
				local gap = flat(lockTarget.part.Position - root.Position).Magnitude - lockTarget.radius - 2.4
				local left = math.max(l.to - moveT, 0.02)
				if gap > Config.Feel.LungeMagnet then
					speed = l.speed
				else
					speed = math.clamp(gap / left, 0, l.speed * 1.6)
				end
			end
			driveVel = MathUtil.dirFromYaw(attackYaw) * speed
		end
	elseif state == "Dash" then
		humanoid.WalkSpeed = 0
		local k = MathUtil.Ease.outQuad(math.clamp(moveT / Moves.Dash.length, 0, 1))
		local speed = Moves.Dash.speedStart + (Moves.Dash.speedEnd - Moves.Dash.speedStart) * k
		driveVel = dashDir * speed
	elseif state == "Hurt" then
		humanoid.WalkSpeed = 0
		driveVel = knockVel
	else -- Parry, Riposte, Dead: planted
		humanoid.WalkSpeed = 0
		driveVel = Vector3.zero
	end
	if Clock.inHitstop() and driveVel == nil then
		driveVel = Vector3.zero
	end
	if driveVel then
		drive.Enabled = true
		local v = driveVel * ts
		drive.PlaneVelocity = Vector2.new(v.X, v.Z)
	else
		drive.Enabled = false
	end
	face.CFrame = CFrame.Angles(0, facingYaw, 0)

	-- soft body: slide out of enemies instead of walking through them (not while dashing)
	if state ~= "Dash" then
		local rp = root.Position
		local push = Vector3.zero
		for _, view in EnemyViews.alive() do
			local d = flat(rp - view.root.Position)
			local minD = Config.Player.BodyRadius + view.cfg.Radius
			local m = d.Magnitude
			if m < minD and m > 1e-3 then
				push += d / m * (minD - m)
			end
		end
		if push.Magnitude > 0.01 then
			root.CFrame += push * 0.35
		end
	end
end

local function animate(dt, simDt)
	local vel = flat(root.AssemblyLinearVelocity)
	local speed = vel.Magnitude
	local moveLocal = if speed > 0.5 then root.CFrame:VectorToObjectSpace(vel / speed) else Vector3.new(0, 0, -1)
	-- lean into acceleration
	if dt > 0 then
		local accel = (vel - prevVel) / dt
		local a = root.CFrame:VectorToObjectSpace(accel)
		local k = 0.0022
		local target = CFrame.Angles(math.clamp(a.Z * k, -0.18, 0.18), 0, math.clamp(-a.X * k, -0.18, 0.18))
		if state ~= "Free" then
			target = CFrame.identity
		end
		leanCF = leanCF:Lerp(target, math.clamp(dt * 10, 0, 1))
	end
	prevVel = vel
	anim.lean = leanCF
	local frozen = Clock.inHitstop()
	if frozen and not anim.frozen then
		anim:freeze(true, 0.08)
	elseif not frozen and anim.frozen then
		anim:freeze(false)
	end
	anim:update(simDt, { speed = if state == "Free" then speed else speed * 0.3, moveLocal = Vector3.new(moveLocal.X, 0, moveLocal.Z) })
end

function Combat.update(dt, simDt)
	if not char or not root or not root.Parent or not humanoid then
		return
	end
	if player:GetAttribute("Dead") == true and state ~= "Dead" then
		state = "Dead"
		move = nil
		setTrail(false)
		anim:play("Hurt", { fadeIn = 0.05, hold = true })
		anim.lean = CFrame.new(0, -0.6, 0) * CFrame.Angles(0.5, 0, 0)
	end
	if state ~= "Dead" then
		processInput()
	end
	stepState(simDt)
	controlBody(simDt)
	animate(dt, simDt)
	drawDebugHitbox()
	if comboTimer > 0 then
		comboTimer -= dt
		if comboTimer <= 0 then
			comboCount = 0
			if Combat.hooks.onHits then
				Combat.hooks.onHits(0, 0)
			end
		end
	end
end

------------------------------------------------------------------------ setup

local function onCharacter(c)
	char = c
	root = c:WaitForChild("HumanoidRootPart")
	humanoid = c:WaitForChild("Humanoid")
	humanoid.AutoRotate = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	humanoid.WalkSpeed = Config.Player.WalkSpeed
	anim = RigAnimator.new(c, Rigs.Player, Clips.Player)

	local att = root:FindFirstChild("RootAttachment") or Instance.new("Attachment")
	att.Name = "RootAttachment"
	att.Parent = root

	drive = Instance.new("LinearVelocity")
	drive.Name = "AF_Drive"
	drive.Attachment0 = att
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.xAxis
	drive.SecondaryTangentAxis = Vector3.zAxis
	drive.MaxForce = 1e6
	drive.Enabled = false
	drive.Parent = root

	face = Instance.new("AlignOrientation")
	face.Name = "AF_Face"
	face.Mode = Enum.OrientationAlignmentMode.OneAttachment
	face.Attachment0 = att
	face.RigidityEnabled = true
	face.Parent = root

	local weapon = c:WaitForChild("Weapon")
	trail = Instance.new("Trail")
	trail.Attachment0 = weapon:WaitForChild("TrailBase")
	trail.Attachment1 = weapon:WaitForChild("TrailTip")
	trail.Lifetime = 0.13
	trail.MinLength = 0.02
	trail.FaceCamera = false
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), AETHER)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.5, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.35) })
	trail.Enabled = false
	trail.Parent = weapon

	state = "Free"
	move = nil
	moveT = 0
	comboNext = nil
	knockVel = Vector3.zero
	hurtIFramesUntil = 0
	riposteUntil = 0
	facingYaw = 0
	Input.clear()
	CameraRig.snap()

end

function Combat.state()
	return state
end

function Combat.root()
	return root
end

function Combat.riposteUntil()
	return riposteUntil
end

function Combat.dashReady()
	return math.clamp((Clock.real - lastDashReal) / Moves.Dash.cooldown, 0, 1)
end

function Combat.init()
	local lastHp = player:GetAttribute("HP") or 100
	player:GetAttributeChangedSignal("HP"):Connect(function()
		local hp = player:GetAttribute("HP") or 0
		if hp < lastHp and root and Clock.real - lastPredictedHurt > 0.6 and state ~= "Dead" then
			-- the server landed a hit we did not predict (late report / lag)
			local nearest, nd = nil, math.huge
			for _, view in EnemyViews.alive() do
				local dd = (view.root.Position - root.Position).Magnitude
				if dd < nd then
					nearest, nd = view, dd
				end
			end
			takeHit(nearest and nearest.root.Position or nil)
		end
		lastHp = hp
	end)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Effects: client-side VFX, all local (nothing here replicates). Everything animates in Effects.update
-- with real time, so impacts keep sparking through hitstop freezes.

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)

local Effects = {}

local SPARK_TEX = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE_TEX = "rbxasset://textures/particles/smoke_main.dds"

local folder, anchor, overlayGui, flashFrame, vignette, pulse
local active = {}

local function add(fn)
	table.insert(active, fn)
end

local function newPart(shape, size, color, material)
	local p
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end
Effects.newPart = newPart

local function frameAlong(pos, up)
	up = up.Unit
	local ref = if math.abs(up.Y) < 0.95 then Vector3.yAxis else Vector3.xAxis
	local right = ref:Cross(up).Unit
	return CFrame.fromMatrix(pos, right, up)
end

local function ns(a, b)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- Particle burst. props override the defaults below.
local function burst(pos, dir, count, props)
	local att = Instance.new("Attachment")
	att.CFrame = frameAlong(pos, dir or Vector3.yAxis)
	att.Parent = anchor
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	pe.Texture = SPARK_TEX
	pe.LightEmission = 1
	pe.LightInfluence = 0
	pe.EmissionDirection = Enum.NormalId.Top
	for k, v in props do
		pe[k] = v
	end
	pe.Parent = att
	pe:Emit(count)
	Debris:AddItem(att, 2)
	return pe
end
Effects.burst = burst

function Effects.sparks(pos, dir, color, count, speed)
	burst(pos, dir, count or 14, {
		Color = ColorSequence.new(Color3.new(1, 1, 1), color),
		Size = ns(0.45, 0),
		Speed = NumberRange.new((speed or 1) * 22, (speed or 1) * 52),
		SpreadAngle = Vector2.new(60, 60),
		Lifetime = NumberRange.new(0.12, 0.32),
		Drag = 7,
		Acceleration = Vector3.new(0, -45, 0),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Brightness = 4,
	})
end

function Effects.dust(pos, count, color, size)
	burst(pos, Vector3.yAxis, count or 10, {
		Texture = SMOKE_TEX,
		Color = ColorSequence.new(color or Color3.fromRGB(120, 110, 130)),
		LightEmission = 0,
		LightInfluence = 1,
		Size = ns(size or 1.2, (size or 1.2) * 3),
		Transparency = ns(0.35, 1),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(90, 10),
		Lifetime = NumberRange.new(0.35, 0.7),
		Drag = 5,
		RotSpeed = NumberRange.new(-90, 90),
		Rotation = NumberRange.new(0, 360),
	})
end

-- Bright expanding ball that fades fast: the core of every impact.
function Effects.flash(pos, color, size, duration)
	local p = newPart("Ball", Vector3.one * size * 0.3, color)
	p.CFrame = CFrame.new(pos)
	local t, T = 0, duration or 0.12
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		local s = size * (0.3 + 0.9 * (1 - (1 - k) ^ 3))
		p.Size = Vector3.one * s
		p.Transparency = k * k
		if k >= 1 then
			p:Destroy()
			return false
		end
		return true
	end)
end

-- A thin bright line across the target, like the blade's cut hanging in the air.
function Effects.cutLine(pos, across, color, length, duration)
	across = Vector3.new(across.X, across.Y, across.Z)
	if across.Magnitude < 1e-3 then
		across = Vector3.xAxis
	end
	local p = newPart("Block", Vector3.new(0.18, 0.18, 0.1), color)
	local base = CFrame.lookAt(pos, pos + across.Unit)
	local t, T = 0, duration or 0.16
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		local grow = math.clamp(k / 0.3, 0, 1)
		local thick = 0.32 * (1 - k)
		p.Size = Vector3.new(thick + 0.02, thick + 0.02, (length or 6) * (0.4 + 0.6 * grow))
		p.CFrame = base
		p.Transparency = k ^ 2
		if k >= 1 then
			p:Destroy()
			return false
		end
		return true
	end)
end

-- Expanding ring of neon segments on the floor + radial cracks (Heavy Slam, parries, deaths).
function Effects.shockwave(pos, radius, color, duration, cracks)
	local n = 28
	local segs = {}
	for i = 1, n do
		segs[i] = newPart("Block", Vector3.new(1, 0.25, 0.6), color)
	end
	local disc = newPart("Cylinder", Vector3.new(0.15, 1, 1), color)
	local t, T = 0, duration or 0.38
	local floorY = pos.Y
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		local e = 1 - (1 - k) ^ 3
		local r = 1 + (radius - 1) * e
		local segLen = 2 * math.pi * r / n * 1.08
		for i, s in segs do
			local a = (i / n) * math.pi * 2
			local p = Vector3.new(pos.X + math.sin(a) * r, floorY + 0.25, pos.Z + math.cos(a) * r)
			s.Size = Vector3.new(segLen, 0.3 * (1 - k) + 0.05, 0.9 * (1 - k) + 0.1)
			s.CFrame = CFrame.new(p) * CFrame.Angles(0, a, 0)
			s.Transparency = k ^ 1.5
		end
		local dr = r * 0.9
		disc.Size = Vector3.new(0.12, dr * 2, dr * 2)
		disc.CFrame = CFrame.new(pos.X, floorY + 0.1, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
		disc.Transparency = 0.55 + 0.45 * k
		if k >= 1 then
			for _, s in segs do
				s:Destroy()
			end
			disc:Destroy()
			return false
		end
		return true
	end)
	if cracks then
		for i = 1, cracks do
			local a = (i / cracks) * math.pi * 2 + math.random() * 0.5
			local len = radius * (0.35 + math.random() * 0.35)
			local dir = Vector3.new(math.sin(a), 0, math.cos(a))
			local c = newPart("Block", Vector3.new(0.25, 0.12, len), color)
			c.CFrame = CFrame.lookAt(pos + dir * (len / 2 + 0.6) + Vector3.new(0, 0.12, 0), pos + dir * (len + 1) + Vector3.new(0, 0.12, 0))
			local ct = 0
			add(function(dt)
				ct += dt
				local k = math.clamp(ct / 1.1, 0, 1)
				c.Transparency = k ^ 2
				if k >= 1 then
					c:Destroy()
					return false
				end
				return true
			end)
		end
	end
end

-- Ghost copy of a character's current pose (dash afterimages).
function Effects.afterimage(model, color, duration)
	local ghosts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.95 and d.Name ~= "HumanoidRootPart" then
			local g = d:Clone()
			g:ClearAllChildren()
			g.Anchored = true
			g.CanCollide = false
			g.CanQuery = false
			g.CanTouch = false
			g.CastShadow = false
			g.Material = Enum.Material.Neon
			g.Color = color
			g.Transparency = 0.5
			g.CollisionGroup = "Fx"
			g.Parent = folder
			table.insert(ghosts, g)
		end
	end
	local t, T = 0, duration or 0.28
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		for _, g in ghosts do
			g.Transparency = 0.5 + 0.5 * k
		end
		if k >= 1 then
			for _, g in ghosts do
				g:Destroy()
			end
			return false
		end
		return true
	end)
end

-- Floating damage number.
function Effects.number(pos, text, color, big)
	local bb = Instance.new("BillboardGui")
	bb.Adornee = anchor
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(160, 60)
	bb.StudsOffsetWorldSpace = pos
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.15
	label.TextSize = 1
	label.Parent = bb
	bb.Parent = folder
	local base = if big then 38 else 26
	local drift = Vector3.new((math.random() - 0.5) * 2, 0, 0)
	local t, T = 0, 0.8
	add(function(dt)
		t += dt
		local k = t / T
		local pop = if t < 0.08 then t / 0.08 * 1.6 else 1.6 - math.min(1, (t - 0.08) / 0.12) * 0.6
		label.TextSize = base * pop
		bb.StudsOffsetWorldSpace = pos + Vector3.new(0, 1.5 + t * 3, 0) + drift * t
		label.TextTransparency = math.clamp((k - 0.6) / 0.4, 0, 1)
		label.TextStrokeTransparency = 0.15 + 0.85 * math.clamp((k - 0.6) / 0.4, 0, 1)
		if k >= 1 then
			bb:Destroy()
			return false
		end
		return true
	end)
end

-- Big text that pops at a world position (PARRY!, RING OUT!).
function Effects.callout(pos, text, color)
	local bb = Instance.new("BillboardGui")
	bb.Adornee = anchor
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(320, 80)
	bb.StudsOffsetWorldSpace = pos + Vector3.new(0, 7, 0)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextSize = 1
	label.Rotation = -6
	label.Parent = bb
	bb.Parent = folder
	local t = 0
	add(function(dt)
		t += dt
		local pop = if t < 0.1 then t / 0.1 * 1.3 else math.max(1, 1.3 - (t - 0.1) * 3)
		label.TextSize = 48 * pop
		bb.StudsOffsetWorldSpace = pos + Vector3.new(0, 7 + t * 1.5, 0)
		local fade = math.clamp((t - 0.7) / 0.3, 0, 1)
		label.TextTransparency = fade
		label.TextStrokeTransparency = fade
		if t >= 1 then
			bb:Destroy()
			return false
		end
		return true
	end)
end

-- Full-screen flash.
function Effects.screenFlash(color, startTransparency, duration)
	flashFrame.BackgroundColor3 = color
	local t, T = 0, duration or 0.15
	local s = startTransparency or 0.5
	flashFrame.BackgroundTransparency = s
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		flashFrame.BackgroundTransparency = s + (1 - s) * k
		return k < 1
	end)
end

-- Red edges when you get hit.
function Effects.vignette(color, strength, duration)
	local t, T = 0, duration or 0.5
	for _, f in vignette do
		f.BackgroundColor3 = color
	end
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		local a = 1 - strength * (1 - k)
		for _, f in vignette do
			f.BackgroundTransparency = a
		end
		return k < 1
	end)
end

-- Brief color grade change (parry desaturates the world, heavy hits punch the contrast).
function Effects.grade(saturation, contrast, brightness, duration)
	local t, T = 0, duration or 0.3
	add(function(dt)
		t += dt
		local k = math.clamp(t / T, 0, 1)
		local w = (1 - k) ^ 2
		pulse.Saturation = saturation * w
		pulse.Contrast = contrast * w
		pulse.Brightness = brightness * w
		return k < 1
	end)
end

-- Chunks that fly out and bounce (enemy shatter, crystal break).
function Effects.debris(pos, colors, count, size, speed, material)
	for _ = 1, count do
		local s = size * (0.5 + math.random() * 0.8)
		local color = colors[math.random(1, #colors)]
		local p = newPart(if math.random() < 0.4 then "Wedge" else "Block", Vector3.new(s, s * (0.6 + math.random() * 0.8), s), color, material)
		p.CastShadow = true
		local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.8, math.random() - 0.5).Unit
		local vel = dir * speed * (0.5 + math.random() * 0.7)
		local rot = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 18
		local cpos = pos + Vector3.new(math.random() - 0.5, math.random() * 2, math.random() - 0.5) * 2
		local life, maxLife = 0, 1.2 + math.random() * 0.8
		add(function(dt)
			life += dt
			vel += Vector3.new(0, -workspace.Gravity * 0.5, 0) * dt
			cpos += vel * dt
			if cpos.Y < s * 0.5 and cpos.Magnitude < Config.Arena.Radius then
				cpos = Vector3.new(cpos.X, s * 0.5, cpos.Z)
				vel = Vector3.new(vel.X * 0.6, math.abs(vel.Y) * 0.3, vel.Z * 0.6)
				spin *= 0.6
			end
			rot = rot * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt)
			p.CFrame = CFrame.new(cpos) * rot
			local k = math.clamp((life - maxLife * 0.6) / (maxLife * 0.4), 0, 1)
			p.Transparency = k
			if life >= maxLife then
				p:Destroy()
				return false
			end
			return true
		end)
	end
end

-- Ore shards that arc out of a broken crystal and home into a character.
function Effects.oreFly(from, getTarget, color, count, onArrive)
	for i = 1, count do
		local p = newPart("Block", Vector3.new(0.5, 0.5, 0.5), color)
		local pos = from + Vector3.new(0, 2, 0)
		local vel = Vector3.new(math.random() - 0.5, 1.4, math.random() - 0.5).Unit * (26 + math.random() * 10)
		local t = -i * 0.04
		local done = false
		add(function(dt)
			t += dt
			if t < 0 then
				p.Transparency = 1
				return true
			end
			p.Transparency = 0
			local target = getTarget()
			if not target then
				p:Destroy()
				return false
			end
			local to = target - pos
			local pull = math.clamp(t * 3, 0, 1)
			vel = vel:Lerp(to.Unit * math.max(45, to.Magnitude * 6), pull * math.clamp(dt * 8, 0, 1))
			vel += Vector3.new(0, -60, 0) * dt * (1 - pull)
			pos += vel * dt
			p.CFrame = CFrame.new(pos) * CFrame.Angles(t * 9, t * 7, 0)
			if (to.Magnitude < 1.8 and t > 0.15) or t > 2.5 then
				if not done then
					done = true
					if onArrive then
						onArrive()
					end
				end
				p:Destroy()
				return false
			end
			return true
		end)
	end
end

-- Two wedges that form any triangle (used for the ground telegraphs).
function Effects.triangle(a, b, c, w1, w2, thickness)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab)
	if right.Magnitude < 1e-6 then
		w1.Transparency, w2.Transparency = 1, 1
		return
	end
	right = right.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	thickness = thickness or 0.05
	w1.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
	w2.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
end

function Effects.update(dt)
	for i = #active, 1, -1 do
		local ok, alive = pcall(active[i], dt)
		if not ok or not alive then
			table.remove(active, i)
		end
	end
end

function Effects.folder()
	return folder
end

function Effects.init()
	folder = Instance.new("Folder")
	folder.Name = "AF_FX"
	folder.Parent = workspace

	anchor = Instance.new("Part")
	anchor.Name = "FxAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.identity
	anchor.Parent = folder

	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	overlayGui = Instance.new("ScreenGui")
	overlayGui.Name = "AF_Overlay"
	overlayGui.IgnoreGuiInset = true
	overlayGui.ResetOnSpawn = false
	overlayGui.DisplayOrder = 5
	overlayGui.Parent = pg

	flashFrame = Instance.new("Frame")
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.Parent = overlayGui

	vignette = {}
	local edges = {
		{ UDim2.new(0.22, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.22, 0, 1, 0), UDim2.fromScale(0.78, 0), 180 },
		{ UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0.75), 270 },
	}
	for _, e in edges do
		local f = Instance.new("Frame")
		f.Size = e[1]
		f.Position = e[2]
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Config.Palette.Danger
		f.BackgroundTransparency = 1
		local g = Instance.new("UIGradient")
		g.Rotation = e[3]
		g.Transparency = ns(0, 1)
		g.Parent = f
		f.Parent = overlayGui
		table.insert(vignette, f)
	end

	pulse = Instance.new("ColorCorrectionEffect")
	pulse.Name = "AF_Pulse"
	pulse.Parent = Lighting
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">EnemyViews</string>
            <string name="Source"><![CDATA[--!nonstrict
-- EnemyViews: everything the player sees of an enemy. Animation follows the server's timestamped
-- states (so every client agrees on when a strike lands) and adds local feel on top:
--   * ground telegraph: the strike zone fills up as the windup runs out
--   * glint: a bright flash + ping right as the parry window opens (parry on the flash)
--   * hit flash + hitstop freeze + flinch when you hit it
--   * stun stars, HP bar, death shatter

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Rigs = require(Shared.Rigs)
local Clips = require(Shared.Clips)
local MathUtil = require(Shared.MathUtil)

local RigAnimator = require(script.Parent.RigAnimator)
local Effects = require(script.Parent.Effects)
local Sfx = require(script.Parent.Sfx)
local Clock = require(script.Parent.Clock)

local EnemyViews = {}
EnemyViews.views = {} -- [model] = view

local TELE_SLICES = 9
local MOLTEN = Config.Palette.Molten
local DANGER = Config.Palette.Danger

local function makeTelegraph()
	local tg = { fill = {}, edge = {} }
	for i = 1, TELE_SLICES * 2 do
		local w = Effects.newPart("Wedge", Vector3.new(0.05, 1, 1), DANGER, Enum.Material.Neon)
		w.Transparency = 1
		tg.fill[i] = w
	end
	for i = 1, TELE_SLICES + 2 do
		local b = Effects.newPart("Block", Vector3.new(0.3, 0.08, 1), MOLTEN, Enum.Material.Neon)
		b.Transparency = 1
		tg.edge[i] = b
	end
	return tg
end

local function hideTelegraph(tg)
	for _, p in tg.fill do
		p.Transparency = 1
	end
	for _, p in tg.edge do
		p.Transparency = 1
	end
end

local function destroyTelegraph(tg)
	for _, p in tg.fill do
		p:Destroy()
	end
	for _, p in tg.edge do
		p:Destroy()
	end
end

-- Draw the strike sector: outline at full range, fill growing with progress.
local function drawTelegraph(tg, origin, yaw, range, arc, progress, hot)
	local y = 0.22
	local center = Vector3.new(origin.X, y, origin.Z)
	local half = math.rad(arc / 2)
	local fillR = range * MathUtil.Ease.outQuad(math.clamp(progress, 0, 1))
	local fillColor = if hot then Color3.fromRGB(255, 230, 200) else DANGER
	local fillT = if hot then 0.35 else 0.62 - 0.2 * progress
	for i = 1, TELE_SLICES do
		local a0 = yaw - half + (i - 1) / TELE_SLICES * half * 2
		local a1 = yaw - half + i / TELE_SLICES * half * 2
		local p0 = center + MathUtil.dirFromYaw(a0) * fillR
		local p1 = center + MathUtil.dirFromYaw(a1) * fillR
		local w1, w2 = tg.fill[i * 2 - 1], tg.fill[i * 2]
		if fillR > 0.2 then
			Effects.triangle(center, p0, p1, w1, w2, 0.05)
			w1.Color, w2.Color = fillColor, fillColor
			w1.Transparency, w2.Transparency = fillT, fillT
		else
			w1.Transparency, w2.Transparency = 1, 1
		end
	end
	-- outline: arc segments + two side edges
	for i = 1, TELE_SLICES do
		local a0 = yaw - half + (i - 1) / TELE_SLICES * half * 2
		local a1 = yaw - half + i / TELE_SLICES * half * 2
		local p0 = center + MathUtil.dirFromYaw(a0) * range
		local p1 = center + MathUtil.dirFromYaw(a1) * range
		local b = tg.edge[i]
		b.Size = Vector3.new(0.3, 0.08, (p1 - p0).Magnitude + 0.25)
		b.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
		b.Transparency = 0.1
	end
	for k = 0, 1 do
		local a = yaw + (if k == 0 then -half else half)
		local p1 = center + MathUtil.dirFromYaw(a) * range
		local b = tg.edge[TELE_SLICES + 1 + k]
		b.Size = Vector3.new(0.3, 0.08, range)
		b.CFrame = CFrame.lookAt((center + p1) / 2, p1)
		b.Transparency = 0.25
	end
end

local function makeHpBar(root)
	local bb = Instance.new("BillboardGui")
	bb.Name = "AF_HP"
	bb.Adornee = root
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(90, 9)
	bb.StudsOffset = Vector3.new(0, 5.2, 0)
	bb.Enabled = false
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(20, 16, 24)
	back.BorderSizePixel = 0
	back.Parent = bb
	local trail = Instance.new("Frame")
	trail.Size = UDim2.fromScale(1, 1)
	trail.BackgroundColor3 = Color3.new(1, 1, 1)
	trail.BorderSizePixel = 0
	trail.Parent = back
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = MOLTEN
	fill.BorderSizePixel = 0
	fill.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = back
	bb.Parent = Effects.folder()
	return { gui = bb, fill = fill, trail = trail, shown = 0, trailFrac = 1 }
end

local function newView(model)
	local root = model:WaitForChild("Root", 5)
	if not root then
		return nil
	end
	local kind = model:GetAttribute("Kind") or "Brute"
	local view = {
		model = model,
		root = root,
		kind = kind,
		cfg = Config.Enemy[kind],
		anim = RigAnimator.new(model, Rigs[kind], Clips[kind]),
		telegraph = makeTelegraph(),
		hp = makeHpBar(root),
		highlight = Instance.new("Highlight"),
		lastState = nil,
		glintFor = -1,
		reportedStrike = model:GetAttribute("StrikeId") or 0,
		freezeUntil = 0,
		flashUntil = 0,
		stars = nil,
		dead = false,
		parts = {},
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			table.insert(view.parts, d)
		end
	end
	local h = view.highlight
	h.Adornee = model
	h.FillTransparency = 1
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = model
	return view
end

local function makeStars()
	local stars = {}
	for i = 1, 3 do
		local s = Effects.newPart("Block", Vector3.new(0.5, 0.5, 0.5), Config.Palette.Gold)
		stars[i] = s
	end
	return stars
end

local function removeStars(view)
	if view.stars then
		for _, s in view.stars do
			s:Destroy()
		end
		view.stars = nil
	end
end

local function shatter(view)
	if view.dead then
		return
	end
	view.dead = true
	hideTelegraph(view.telegraph)
	removeStars(view)
	view.hp.gui.Enabled = false
	local pos = view.root.Position
	for _, p in view.parts do
		p.LocalTransparencyModifier = 1
	end
	view.highlight.Enabled = false
	Effects.flash(pos + Vector3.new(0, 3, 0), MOLTEN, 9, 0.2)
	Effects.debris(pos + Vector3.new(0, 2, 0), { Color3.fromRGB(42, 38, 48), Color3.fromRGB(78, 70, 78) }, 14, 1.3, 38, Enum.Material.Basalt)
	Effects.debris(pos + Vector3.new(0, 3, 0), { MOLTEN }, 8, 0.6, 46)
	Effects.sparks(pos + Vector3.new(0, 3, 0), Vector3.yAxis, MOLTEN, 30, 1.3)
	Effects.shockwave(Vector3.new(pos.X, 0, pos.Z), 10, MOLTEN, 0.4)
	Sfx.play("EnemyDie")
end

-- The local player's hit landed on this enemy: flash white, freeze, flinch.
function EnemyViews.onLocalHit(model, hitstop, dirWorld, damage, isBig)
	local view = EnemyViews.views[model]
	if not view or view.dead then
		return
	end
	view.flashUntil = Clock.real + 0.07
	view.freezeUntil = Clock.real + hitstop
	view.anim:freeze(true, if isBig then 0.35 else 0.18)
	local local_ = view.root.CFrame:VectorToObjectSpace(dirWorld)
	view.anim:addFlinch(Vector3.new(local_.X, 0, local_.Z), if isBig then 1.2 else 0.7)
	view.hp.shown = 3
	if damage then
		local pos = view.root.Position + Vector3.new(0, 4, 0)
		Effects.number(pos, tostring(math.floor(damage + 0.5)), if isBig then Config.Palette.Gold else Color3.new(1, 1, 1), isBig)
	end
end

local function updateView(view, dt, simDt, onStrike)
	local model = view.model
	if not model.Parent then
		return false
	end
	local state = model:GetAttribute("State")
	if state == "Dead" then
		shatter(view)
		return true
	end
	local now = Clock.server()
	local stateT = model:GetAttribute("StateT") or now
	local elapsed = now - stateT
	local cfg = view.cfg

	-- state entry
	if state ~= view.lastState then
		if view.lastState == "Stunned" then
			removeStars(view)
		end
		if state == "Stunned" then
			view.stars = makeStars()
		end
		if state == "Strike" then
			Effects.dust(Vector3.new(view.root.Position.X, 0.3, view.root.Position.Z) + MathUtil.dirFromYaw(MathUtil.yawFromDir(view.root.CFrame.LookVector)) * 4, 10)
		end
		if state ~= "Windup" then
			hideTelegraph(view.telegraph)
		end
		-- clip-driven states restart their own clip via setTime; everything else blends back
		view.anim:stop(0.1)
		view.lastState = state
	end

	-- hitstop freeze
	if view.freezeUntil > Clock.real then
		view.anim:update(0)
	else
		if view.anim.frozen then
			view.anim:freeze(false)
		end
		local vel = view.root.AssemblyLinearVelocity
		local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local loco = { speed = speed }
		if state == "Spawn" then
			view.anim:setTime("Spawn", elapsed / cfg.SpawnTime)
			view.anim:update(simDt, loco)
		elseif state == "Windup" then
			local strikeT = model:GetAttribute("StrikeT") or (stateT + 1)
			local dur = math.max(strikeT - stateT, 0.05)
			local u = math.clamp(elapsed / dur, 0, 1)
			view.anim:setTime("Windup", u)
			-- tremble harder as the strike approaches
			view.anim.lean = CFrame.new((math.random() - 0.5) * 0.12 * u, 0, (math.random() - 0.5) * 0.12 * u)
			view.anim:update(simDt, { speed = 0 })
			-- glint marks the parry timing: react to it and the parry lands in the window
			local strikeId = model:GetAttribute("StrikeId") or 0
			local glintAt = strikeT - Config.Feel.GlintLead
			local yaw = MathUtil.yawFromDir(view.root.CFrame.LookVector)
			drawTelegraph(view.telegraph, view.root.Position, yaw, cfg.AttackRange, cfg.AttackArc, u, now >= glintAt)
			if now >= glintAt and view.glintFor ~= strikeId then
				view.glintFor = strikeId
				local head = view.root.Position + Vector3.new(0, 6.5, 0) + view.root.CFrame.LookVector * -1.2
				Effects.flash(head, Color3.new(1, 1, 1), 3.2, 0.14)
				Effects.sparks(head, Vector3.yAxis, Config.Palette.Gold, 10, 0.6)
				Sfx.play("Glint")
			end
			-- strike time: the local player decides parry / dodge / hurt
			if now >= strikeT and view.reportedStrike ~= strikeId then
				view.reportedStrike = strikeId
				onStrike(view, strikeId)
			end
		elseif state == "Strike" then
			view.anim.lean = CFrame.identity
			view.anim:setTime("Strike", elapsed)
			view.anim:update(simDt, { speed = 0 })
			-- if our clock was behind and we never saw StrikeT pass inside Windup
			local strikeId = model:GetAttribute("StrikeId") or 0
			if view.reportedStrike ~= strikeId then
				view.reportedStrike = strikeId
				onStrike(view, strikeId)
			end
		elseif state == "Recover" then
			view.anim:setTime("Recover", elapsed)
			view.anim:update(simDt, { speed = 0 })
		elseif state == "Stunned" then
			view.anim:update(simDt, loco, Clips.Brute.stunned(Clock.real))
		else
			view.anim.lean = CFrame.identity
			view.anim:update(simDt, loco)
		end
	end

	-- stun stars orbit the head
	if view.stars then
		local head = view.root.Position + Vector3.new(0, 7.2, 0)
		for i, s in view.stars do
			local a = Clock.real * 5 + i * math.pi * 2 / 3
			s.CFrame = CFrame.new(head + Vector3.new(math.cos(a) * 1.8, math.sin(a * 2) * 0.2, math.sin(a) * 1.8)) * CFrame.Angles(a, a, 0)
		end
	end

	-- highlight: white hit flash > windup glow > stun shimmer
	local h = view.highlight
	if Clock.real < view.flashUntil then
		h.FillColor = Color3.new(1, 1, 1)
		h.FillTransparency = 0.05
		h.OutlineTransparency = 1
	elseif state == "Windup" then
		local strikeT = model:GetAttribute("StrikeT") or now
		local u = math.clamp(1 - (strikeT - now) / 0.8, 0, 1)
		h.FillColor = MOLTEN
		h.OutlineColor = Color3.fromRGB(255, 200, 120)
		h.FillTransparency = 1 - 0.45 * u
		h.OutlineTransparency = 0.2
	elseif state == "Stunned" then
		h.FillColor = Config.Palette.Gold
		h.OutlineColor = Config.Palette.Gold
		h.FillTransparency = 0.75 + 0.15 * math.sin(Clock.real * 12)
		h.OutlineTransparency = 0.3
	else
		h.FillTransparency = 1
		h.OutlineTransparency = 1
	end

	-- HP bar
	local hp, maxHp = model:GetAttribute("HP") or 1, model:GetAttribute("MaxHP") or 1
	local frac = math.clamp(hp / maxHp, 0, 1)
	view.hp.shown -= dt
	view.hp.gui.Enabled = view.hp.shown > 0 or frac < 1
	view.hp.fill.Size = UDim2.fromScale(frac, 1)
	view.hp.trailFrac = MathUtil.damp(view.hp.trailFrac, frac, 5, dt)
	view.hp.trail.Size = UDim2.fromScale(view.hp.trailFrac, 1)
	return true
end

function EnemyViews.update(dt, simDt, onStrike)
	for model, view in EnemyViews.views do
		local ok, alive = pcall(updateView, view, dt, simDt, onStrike)
		if not ok then
			warn("[Aether Forge] enemy view error: ", alive)
		end
		if not ok or not alive then
			destroyTelegraph(view.telegraph)
			removeStars(view)
			view.hp.gui:Destroy()
			EnemyViews.views[model] = nil
		end
	end
end

-- Enemies close to the player (used for aim assist, soft collision and hit detection).
function EnemyViews.alive()
	local list = {}
	for model, view in EnemyViews.views do
		if not view.dead and model.Parent and model:GetAttribute("State") ~= "Dead" then
			table.insert(list, view)
		end
	end
	return list
end

function EnemyViews.init()
	local folder = workspace:WaitForChild("Enemies")
	local function add(model)
		task.spawn(function()
			local view = newView(model)
			if view then
				EnemyViews.views[model] = view
			end
		end)
	end
	folder.ChildAdded:Connect(add)
	for _, m in folder:GetChildren() do
		add(m)
	end
end

return EnemyViews
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hud: HP bar (with a trailing damage bar), riposte badge, dash meter, ore counter, wave info,
-- combo counter, big center banners and the controls hint (H toggles it).

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local MathUtil = require(Shared.MathUtil)

local Clock = require(script.Parent.Clock)

local Hud = {}

local player = Players.LocalPlayer
local P = Config.Palette

local gui
local hpFill, hpTrail, hpText, hpTrailFrac = nil, nil, nil, 1
local riposte, riposteBar
local dashFill
local oreText, oreIcon, orePop = nil, nil, 0
local waveText, waveSub
local comboNum, comboLabel, comboPop, comboShown = nil, nil, 0, 0
local banner, bannerSub, bannerT, bannerDur = nil, nil, 99, 2
local hint
local combat

local function label(parent, text, size, font, color, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.Font = font or Enum.Font.GothamBold
	l.TextColor3 = color or Color3.new(1, 1, 1)
	if props then
		for k, v in props do
			l[k] = v
		end
	end
	l.Parent = parent
	return l
end

local function stroke(inst, thickness, color, transparency)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1.5
	s.Color = color or Color3.new(0, 0, 0)
	s.Transparency = transparency or 0
	s.Parent = inst
	return s
end

local function corner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 4)
	c.Parent = inst
	return c
end

local function frame(parent, size, pos, color, transparency)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos or UDim2.new()
	f.BackgroundColor3 = color or Color3.new(0, 0, 0)
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "AF_Hud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	-- HP block (top-left)
	local hpBox = frame(gui, UDim2.fromOffset(300, 62), UDim2.fromOffset(18, 14), Color3.new(0, 0, 0), 1)
	label(hpBox, "WARRIOR-SMITH", 12, Enum.Font.GothamBlack, Color3.fromRGB(200, 210, 230), {
		Size = UDim2.fromOffset(200, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local hpBack = frame(hpBox, UDim2.fromOffset(300, 18), UDim2.fromOffset(0, 18), Color3.fromRGB(16, 14, 24), 0.15)
	corner(hpBack, 4)
	stroke(hpBack, 1.5, Color3.fromRGB(120, 130, 160), 0.4)
	hpTrail = frame(hpBack, UDim2.fromScale(1, 1), nil, Color3.new(1, 1, 1), 0.1)
	corner(hpTrail, 4)
	hpFill = frame(hpBack, UDim2.fromScale(1, 1), nil, P.Aether)
	corner(hpFill, 4)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(110, 255, 220), P.AetherDeep)
	grad.Parent = hpFill
	hpText = label(hpBack, "100 / 100", 13, Enum.Font.GothamBlack, Color3.new(1, 1, 1), {
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
	})
	local pad = Instance.new("UIPadding")
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = hpText
	stroke(hpText, 1.2)

	-- dash meter
	local dashBack = frame(hpBox, UDim2.fromOffset(120, 5), UDim2.fromOffset(0, 42), Color3.fromRGB(16, 14, 24), 0.2)
	corner(dashBack, 2)
	dashFill = frame(dashBack, UDim2.fromScale(1, 1), nil, Color3.fromRGB(220, 240, 255))
	corner(dashFill, 2)
	label(hpBox, "DASH", 10, Enum.Font.GothamBlack, Color3.fromRGB(170, 180, 200), {
		Size = UDim2.fromOffset(40, 10),
		Position = UDim2.fromOffset(126, 39),
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- riposte badge
	riposte = frame(gui, UDim2.fromOffset(170, 26), UDim2.fromOffset(18, 70), P.Gold, 0.15)
	corner(riposte, 4)
	label(riposte, "RIPOSTE  x" .. Config.Player.RiposteDamageMult, 14, Enum.Font.GothamBlack, Color3.fromRGB(40, 26, 6), {
		Size = UDim2.fromScale(1, 1),
	})
	riposteBar = frame(riposte, UDim2.new(1, 0, 0, 3), UDim2.new(0, 0, 1, -3), Color3.new(1, 1, 1))
	riposte.Visible = false

	-- ore (top-right)
	local oreBox = frame(gui, UDim2.fromOffset(170, 48), UDim2.new(1, -188, 0, 12), Color3.new(0, 0, 0), 1)
	oreIcon = frame(oreBox, UDim2.fromOffset(22, 22), UDim2.fromOffset(14, 12), P.Aether)
	oreIcon.Rotation = 45
	stroke(oreIcon, 2, Color3.fromRGB(10, 40, 60))
	oreText = label(oreBox, "0", 34, Enum.Font.GothamBlack, Color3.new(1, 1, 1), {
		Size = UDim2.fromOffset(90, 40),
		Position = UDim2.fromOffset(46, 2),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	stroke(oreText, 2)
	label(oreBox, "ORE", 12, Enum.Font.GothamBlack, Color3.fromRGB(150, 220, 240), {
		Size = UDim2.fromOffset(40, 12),
		Position = UDim2.fromOffset(122, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- wave (top-center)
	waveText = label(gui, "", 28, Enum.Font.GothamBlack, Color3.new(1, 1, 1), {
		Size = UDim2.fromOffset(300, 32),
		Position = UDim2.new(0.5, -150, 0, 8),
	})
	stroke(waveText, 2)
	waveSub = label(gui, "", 14, Enum.Font.GothamBold, Color3.fromRGB(200, 205, 225), {
		Size = UDim2.fromOffset(300, 18),
		Position = UDim2.new(0.5, -150, 0, 40),
	})
	stroke(waveSub, 1.5)

	-- combo (right-center)
	comboNum = label(gui, "", 64, Enum.Font.GothamBlack, Color3.new(1, 1, 1), {
		Size = UDim2.fromOffset(200, 70),
		Position = UDim2.new(1, -230, 0.38, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	stroke(comboNum, 3)
	comboLabel = label(gui, "HIT COMBO", 16, Enum.Font.GothamBlack, P.Aether, {
		Size = UDim2.fromOffset(200, 20),
		Position = UDim2.new(1, -230, 0.38, 66),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	stroke(comboLabel, 2)

	-- banner (center)
	banner = label(gui, "", 72, Enum.Font.GothamBlack, Color3.new(1, 1, 1), {
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.new(0, 0, 0.26, 0),
		TextTransparency = 1,
	})
	stroke(banner, 4, Color3.new(0, 0, 0), 1)
	bannerSub = label(gui, "", 22, Enum.Font.GothamBold, Color3.fromRGB(220, 225, 240), {
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.new(0, 0, 0.26, 88),
		TextTransparency = 1,
	})
	stroke(bannerSub, 2, Color3.new(0, 0, 0), 1)

	-- controls hint (bottom-left)
	hint = frame(gui, UDim2.fromOffset(250, 126), UDim2.new(0, 18, 1, -146), Color3.fromRGB(10, 10, 18), 0.35)
	corner(hint, 6)
	local lines = {
		{ "LMB", "Slash combo (3 hits)" },
		{ "RMB", "Heavy Slam" },
		{ "SPACE / SHIFT", "Dash (i-frames)" },
		{ "F", "Parry (on the flash)" },
		{ "WHEEL", "Zoom" },
		{ "H", "Hide this" },
	}
	for i, l in lines do
		label(hint, l[1], 12, Enum.Font.GothamBlack, P.Aether, {
			Size = UDim2.fromOffset(100, 18),
			Position = UDim2.fromOffset(10, 6 + (i - 1) * 19),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		label(hint, l[2], 12, Enum.Font.GothamBold, Color3.fromRGB(215, 220, 235), {
			Size = UDim2.fromOffset(140, 18),
			Position = UDim2.fromOffset(108, 6 + (i - 1) * 19),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
	end
	hint.Visible = not UserInputService.TouchEnabled
end

function Hud.banner(text, sub, color, duration)
	banner.Text = text
	banner.TextColor3 = color or Color3.new(1, 1, 1)
	bannerSub.Text = sub or ""
	bannerT = 0
	bannerDur = duration or 2.2
end

function Hud.combo(count)
	if count > 0 then
		comboShown = 2.4
		comboPop = 1
		comboNum.Text = tostring(count)
		comboLabel.Text = if count >= 10 then "BRUTAL COMBO" elseif count >= 5 then "HIT COMBO" else "HITS"
	end
end

function Hud.orePulse()
	orePop = 1
end

function Hud.update(dt)
	if not gui then
		return
	end
	-- HP
	local hp = player:GetAttribute("HP") or 0
	local maxHp = player:GetAttribute("MaxHP") or Config.Player.MaxHP
	local frac = math.clamp(hp / maxHp, 0, 1)
	hpFill.Size = UDim2.fromScale(frac, 1)
	if hpTrailFrac < frac then
		hpTrailFrac = frac
	else
		hpTrailFrac = MathUtil.damp(hpTrailFrac, frac, 3.5, dt)
	end
	hpTrail.Size = UDim2.fromScale(hpTrailFrac, 1)
	hpText.Text = string.format("%d / %d", math.floor(hp + 0.5), math.floor(maxHp + 0.5))
	if frac < 0.3 then
		hpFill.BackgroundColor3 = P.Danger:Lerp(Color3.new(1, 1, 1), 0.3 + 0.3 * math.sin(Clock.real * 10))
		hpFill:FindFirstChildOfClass("UIGradient").Enabled = false
	else
		hpFill:FindFirstChildOfClass("UIGradient").Enabled = true
		hpFill.BackgroundColor3 = Color3.new(1, 1, 1)
	end

	-- riposte + dash
	if combat then
		local left = combat.riposteUntil() - Clock.server()
		riposte.Visible = left > 0
		if left > 0 then
			riposteBar.Size = UDim2.new(math.clamp(left / Config.Player.RiposteDuration, 0, 1), 0, 0, 3)
		end
		local d = combat.dashReady()
		dashFill.Size = UDim2.fromScale(d, 1)
		dashFill.BackgroundColor3 = if d >= 1 then Color3.fromRGB(220, 240, 255) else Color3.fromRGB(90, 100, 130)
	end

	-- ore
	oreText.Text = tostring(player:GetAttribute("Ore") or 0)
	orePop = math.max(0, orePop - dt * 4)
	oreText.TextSize = 34 * (1 + 0.35 * orePop)
	oreIcon.Rotation = 45 + orePop * 90

	-- wave info
	local wave = workspace:GetAttribute("Wave") or 0
	local phase = workspace:GetAttribute("Phase")
	local ends = workspace:GetAttribute("PhaseEnds") or 0
	local left = math.max(0, math.ceil(ends - Clock.server()))
	waveText.Text = if wave > 0 then "WAVE " .. wave else "AETHER FORGE"
	if workspace:GetAttribute("WavesPaused") then
		waveSub.Text = "waves paused (training)"
	elseif phase == "Wave" then
		local n = workspace:GetAttribute("EnemiesLeft") or 0
		waveSub.Text = n .. (if n == 1 then " brute left" else " brutes left")
	elseif phase == "Breather" then
		waveSub.Text = "next wave in " .. left
	elseif phase == "Countdown" then
		waveSub.Text = "starting in " .. left
	elseif phase == "Defeat" then
		waveSub.Text = "restarting in " .. left
	else
		waveSub.Text = ""
	end

	-- combo
	comboShown -= dt
	comboPop = math.max(0, comboPop - dt * 6)
	local cv = comboShown > 0
	comboNum.Visible = cv
	comboLabel.Visible = cv
	comboNum.TextSize = 64 * (1 + 0.3 * comboPop)
	comboNum.Rotation = -4 * comboPop

	-- banner
	bannerT += dt
	local a
	if bannerT < 0.15 then
		a = bannerT / 0.15
	elseif bannerT < bannerDur - 0.4 then
		a = 1
	else
		a = math.clamp((bannerDur - bannerT) / 0.4, 0, 1)
	end
	local tr = 1 - a
	banner.TextTransparency = tr
	bannerSub.TextTransparency = tr
	banner:FindFirstChildOfClass("UIStroke").Transparency = tr
	bannerSub:FindFirstChildOfClass("UIStroke").Transparency = tr
	banner.TextSize = 72 * (1 + 0.25 * math.max(0, 1 - bannerT / 0.15))
end

function Hud.init(combatModule)
	combat = combatModule
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
	build()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.H then
			hint.Visible = not hint.Visible
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Input: binds the four core moves for mouse+keyboard, gamepad and touch, buffers presses, and
-- works out the aim direction.
--   Light  LMB / ButtonX / touch       Heavy  RMB / ButtonY / touch
--   Dash   Space or Shift / ButtonA    Parry  F / ButtonB or R1 / touch

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("AetherForge").Config)

local Input = {}
Input.buffer = {} -- { action, time }
Input.usingMouse = true
Input.listeners = {}

local clock -- set in init (Clock module) so buffering uses real time

local function push(action)
	table.insert(Input.buffer, { action = action, time = clock.real })
	for _, fn in Input.listeners do
		fn(action)
	end
end

local function bind(name, action, title, position, ...)
	ContextActionService:BindActionAtPriority(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			push(action)
		end
		return Enum.ContextActionResult.Sink
	end, true, 3000, ...)
	ContextActionService:SetTitle(name, title)
	ContextActionService:SetPosition(name, position)
end

function Input.init(clockModule)
	clock = clockModule
	bind("AF_Light", "Light", "Slash", UDim2.new(1, -170, 1, -120), Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
	bind("AF_Heavy", "Heavy", "Slam", UDim2.new(1, -95, 1, -190), Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonY)
	bind("AF_Dash", "Dash", "Dash", UDim2.new(1, -95, 1, -115), Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonA)
	bind("AF_Parry", "Parry", "Parry", UDim2.new(1, -170, 1, -195), Enum.KeyCode.F, Enum.KeyCode.ButtonB, Enum.KeyCode.ButtonR1)

	UserInputService.LastInputTypeChanged:Connect(function(t)
		if t == Enum.UserInputType.Touch or t.Name:sub(1, 7) == "Gamepad" then
			Input.usingMouse = false
		elseif t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Keyboard then
			Input.usingMouse = true
		end
	end)
end

-- Take the oldest buffered press of `action` that is still fresh.
function Input.peek(action)
	local now = clock.real
	for i = #Input.buffer, 1, -1 do
		if now - Input.buffer[i].time > Config.Feel.InputBuffer then
			table.remove(Input.buffer, i)
		end
	end
	for _, b in Input.buffer do
		if action == nil or b.action == action then
			return b
		end
	end
	return nil
end

function Input.consume(entry)
	local i = table.find(Input.buffer, entry)
	if i then
		table.remove(Input.buffer, i)
	end
end

function Input.clear()
	table.clear(Input.buffer)
end

-- World-space flat aim direction from the character root.
-- Mouse: toward the cursor on the floor. Gamepad/touch: the stick direction, else current facing.
function Input.aimDirection(rootPos, moveDir, facing)
	if Input.usingMouse then
		local cam = workspace.CurrentCamera
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local floorY = rootPos.Y - 3
		if math.abs(ray.Direction.Y) > 1e-3 then
			local t = (floorY - ray.Origin.Y) / ray.Direction.Y
			if t > 0 then
				local hit = ray.Origin + ray.Direction * t
				local d = Vector3.new(hit.X - rootPos.X, 0, hit.Z - rootPos.Z)
				if d.Magnitude > 0.5 then
					return d.Unit
				end
			end
		end
	end
	if moveDir and moveDir.Magnitude > 0.1 then
		return Vector3.new(moveDir.X, 0, moveDir.Z).Unit
	end
	return facing
end

function Input.player()
	return Players.LocalPlayer
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">OtherPlayers</string>
            <string name="Source"><![CDATA[--!nonstrict
-- OtherPlayers: animates other players' characters on this client. Their moves arrive as the
-- character attributes Act/ActT (set by the server), their locomotion comes from their velocity.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Moves = require(Shared.Moves)
local Rigs = require(Shared.Rigs)
local Clips = require(Shared.Clips)

local RigAnimator = require(script.Parent.RigAnimator)
local Clock = require(script.Parent.Clock)

local OtherPlayers = {}
local views = {} -- [character] = view

local function attach(player, char)
	task.spawn(function()
		local root = char:WaitForChild("HumanoidRootPart", 10)
		local weapon = char:WaitForChild("Weapon", 10)
		if not root or not weapon then
			return
		end
		local trail = Instance.new("Trail")
		trail.Attachment0 = weapon:WaitForChild("TrailBase")
		trail.Attachment1 = weapon:WaitForChild("TrailTip")
		trail.Lifetime = 0.13
		trail.FaceCamera = false
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.Color = ColorSequence.new(Color3.new(1, 1, 1), Config.Palette.Aether)
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Enabled = false
		trail.Parent = weapon
		views[char] = {
			player = player,
			char = char,
			root = root,
			trail = trail,
			anim = RigAnimator.new(char, Rigs.Player, Clips.Player),
			act = nil,
			actT = 0,
		}
	end)
end

local function onPlayer(player)
	if player == Players.LocalPlayer then
		return
	end
	player.CharacterAdded:Connect(function(char)
		attach(player, char)
	end)
	if player.Character then
		attach(player, player.Character)
	end
end

function OtherPlayers.hurt(player)
	for _, v in views do
		if v.player == player then
			v.anim:play("Hurt", { fadeIn = 0 })
		end
	end
end

function OtherPlayers.update(_dt, simDt)
	local now = Clock.server()
	for char, v in views do
		if not char.Parent or not v.root.Parent then
			views[char] = nil
			continue
		end
		local act = char:GetAttribute("Act")
		local actT = char:GetAttribute("ActT") or 0
		if act and actT ~= v.actT then
			v.actT = actT
			v.act = act
			local move = Moves[act]
			if move and move.clip then
				v.anim:play(move.clip, { fadeIn = 0.03, startAt = math.clamp(now - actT, 0, 0.2) })
			end
		end
		local move = v.act and Moves[v.act]
		local t = now - v.actT
		v.trail.Enabled = move ~= nil and move.trail ~= nil and t >= move.trail[1] and t <= move.trail[2]
		local vel = v.root.AssemblyLinearVelocity
		local flat = Vector3.new(vel.X, 0, vel.Z)
		local speed = flat.Magnitude
		local moveLocal = if speed > 0.5 then v.root.CFrame:VectorToObjectSpace(flat / speed) else Vector3.new(0, 0, -1)
		v.anim:update(simDt, { speed = speed, moveLocal = Vector3.new(moveLocal.X, 0, moveLocal.Z) })
	end
end

function OtherPlayers.init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

return OtherPlayers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">RigAnimator</string>
            <string name="Source"><![CDATA[--!nonstrict
-- RigAnimator: plays AnimCore clips on a built rig by writing Motor6D.Transform every frame.
-- Layers: locomotion (idle/run) -> one action clip with fade in/out -> additive overlays
-- (lean, flinch, hitstop jitter) -> IK (legs, arms, wrist).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local AnimCore = require(Shared.AnimCore)
local MathUtil = require(Shared.MathUtil)
local Rigs = require(Shared.Rigs)
local RigBuilder = require(Shared.RigBuilder)

local RigAnimator = {}
RigAnimator.__index = RigAnimator

-- clipSet = Clips.Player or Clips.Brute (needs .clips, .locomotion, .cycleDistance)
function RigAnimator.new(model, rig, clipSet)
	local self = setmetatable({}, RigAnimator)
	self.model = model
	self.rig = rig
	self.clipSet = clipSet
	self.motors = RigBuilder.findMotors(model)
	self.joints = Rigs.computeJoints(rig)
	self.ik = AnimCore.ikInfo(rig, self.joints)
	self.t = 0
	self.phase = 0
	self.action = nil
	self.cross = nil
	self.lastOutput = nil
	self.lean = CFrame.identity
	self.flinch = 0
	self.flinchDir = Vector3.zero
	self.jitter = 0
	self.lastPose = nil
	self.frozen = false
	return self
end

-- Play a clip from the clip set. opts = { fadeIn, speed, startAt, hold }
-- The new clip crossfades from whatever pose is on screen (so combo chains never pop).
-- hold = true keeps the final pose until stop() (used for enemy states driven by server time).
function RigAnimator:play(name, opts)
	opts = opts or {}
	local clip = self.clipSet.clips[name]
	if not clip then
		return
	end
	local fade = opts.fadeIn or 0.05
	self.action = {
		name = name,
		clip = clip,
		t = opts.startAt or 0,
		speed = opts.speed or 1,
		hold = opts.hold,
	}
	if self.lastOutput and fade > 0 then
		self.cross = { pose = self.lastOutput, time = fade, left = fade }
	else
		self.cross = nil
	end
end

-- Pose an arbitrary clip at an explicit time (server-time driven enemy states).
function RigAnimator:setTime(name, t)
	if not self.action or self.action.name ~= name then
		self:play(name, { fadeIn = 0.06, hold = true, speed = 0 })
	end
	self.action.t = t
end

-- Blend back to locomotion.
function RigAnimator:stop(fadeOut)
	if self.action then
		self.action = nil
		local fade = fadeOut or 0.12
		if self.lastOutput and fade > 0 then
			self.cross = { pose = self.lastOutput, time = fade, left = fade }
		end
	end
end

function RigAnimator:isPlaying(name)
	return self.action ~= nil and (name == nil or self.action.name == name)
end

function RigAnimator:addFlinch(dirLocal, amount)
	self.flinchDir = dirLocal
	self.flinch = math.max(self.flinch, amount)
end

-- loco = { speed = number, moveLocal = Vector3 }, custom = optional pose override (e.g. stunned)
function RigAnimator:update(dt, loco, custom)
	if self.frozen then
		self:write(self.lastPose, true)
		return
	end
	self.t += dt
	local speed = loco and loco.speed or 0
	self.phase = (self.phase + speed * dt / self.clipSet.cycleDistance * math.pi * 2) % (math.pi * 2)

	local pose = custom
	if not pose then
		pose = self.clipSet.locomotion({
			t = self.t,
			speed = speed,
			moveLocal = loco and loco.moveLocal or Vector3.new(0, 0, -1),
			phase = self.phase,
		})
	end

	local a = self.action
	if a then
		a.t += dt * a.speed
		pose = AnimCore.sample(a.clip, a.t)
		if a.t >= a.clip.length and not a.hold then
			self.lastOutput = pose
			self:stop(0.12)
		end
	end

	local c = self.cross
	if c then
		c.left -= dt
		local w = math.clamp(1 - c.left / c.time, 0, 1)
		pose = AnimCore.blend(c.pose, pose, MathUtil.Ease.outQuad(w))
		if c.left <= 0 then
			self.cross = nil
		end
	end
	self.lastOutput = pose

	pose = AnimCore.copy(pose)
	-- overlays
	if self.lean ~= CFrame.identity then
		AnimCore.addPre(pose, "Root", self.lean)
	end
	if self.flinch > 0.001 then
		local f = self.flinch
		local d = self.flinchDir
		AnimCore.addPre(pose, "Root", CFrame.new(d.X * 0.25 * f, 0, d.Z * 0.25 * f) * CFrame.Angles(d.Z * 0.35 * f, 0, -d.X * 0.35 * f))
		AnimCore.addPre(pose, "Waist", CFrame.Angles(d.Z * 0.3 * f, 0, -d.X * 0.3 * f))
		self.flinch *= math.exp(-14 * dt)
	end
	self.lastPose = pose
	self:write(pose, false)
end

function RigAnimator:write(pose, jitter)
	if not pose then
		return
	end
	local transforms = AnimCore.solve(pose, self.joints, self.ik)
	if jitter and self.jitter > 0 then
		local j = self.jitter
		transforms.Root = CFrame.new((math.random() - 0.5) * j, (math.random() - 0.5) * j * 0.5, (math.random() - 0.5) * j) * (transforms.Root or CFrame.identity)
	end
	for name, motor in self.motors do
		local t = transforms[name]
		if t then
			motor.Transform = t
		end
	end
end

-- Freeze the current pose (hitstop) with an optional shake amount in studs.
function RigAnimator:freeze(on, jitter)
	self.frozen = on
	self.jitter = jitter or 0
end

return RigAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sfx: sound effects. Sound is one of the biggest parts of game feel, and these placeholders use
-- sounds that ship inside Roblox itself. Swap any id for a Creator Store sound ("rbxassetid://123..."),
-- the Creator Store has hundreds of free sword, impact and crystal sounds uploaded by Roblox.
-- Each entry can layer several sounds; pitch is randomized a little so repeats don't sound robotic.

local SoundService = game:GetService("SoundService")

local Sfx = {}

local SLASH = "rbxasset://sounds/swordslash.wav"
local LUNGE = "rbxasset://sounds/swordlunge.wav"
local UNSHEATH = "rbxasset://sounds/unsheath.wav"
local PING = "rbxasset://sounds/electronicpingshort.wav"
local THUD = "rbxasset://sounds/action_jump_land.mp3"
local CLICK = "rbxasset://sounds/clickfast.wav"

-- name = { { id, volume, pitch, pitchJitter }, ... }
Sfx.defs = {
	Swing = { { SLASH, 0.55, 1.25, 0.08 } },
	SwingBig = { { SLASH, 0.7, 0.95, 0.05 }, { LUNGE, 0.35, 1.3, 0.05 } },
	SwingHeavy = { { LUNGE, 0.7, 0.8, 0.04 } },
	Hit = { { THUD, 0.9, 1.35, 0.1 }, { SLASH, 0.35, 1.7, 0.1 } },
	HitBig = { { THUD, 1.2, 0.85, 0.06 }, { LUNGE, 0.4, 1.5, 0.05 } },
	Slam = { { THUD, 1.6, 0.45, 0.03 }, { THUD, 0.8, 0.7, 0.05 } },
	Parry = { { UNSHEATH, 1.0, 1.7, 0.04 }, { PING, 0.6, 0.8, 0.02 }, { THUD, 0.6, 1.8, 0.02 } },
	Glint = { { PING, 0.45, 2.2, 0.02 } },
	Dash = { { LUNGE, 0.4, 1.8, 0.1 } },
	Hurt = { { THUD, 1.0, 0.75, 0.05 }, { SLASH, 0.3, 0.6, 0.05 } },
	CrystalHit = { { PING, 0.6, 1.5, 0.2 } },
	CrystalBreak = { { PING, 0.8, 0.9, 0.05 }, { PING, 0.5, 1.6, 0.05 }, { THUD, 0.7, 1.1, 0.05 } },
	Ore = { { PING, 0.25, 2.4, 0.15 } },
	EnemyDie = { { THUD, 1.2, 0.6, 0.05 }, { PING, 0.4, 0.5, 0.05 } },
	Wave = { { UNSHEATH, 0.6, 0.7, 0 } },
	UI = { { CLICK, 0.5, 1, 0.05 } },
}

local cache = {}

local function template(id)
	local s = cache[id]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = SoundService
		cache[id] = s
	end
	return s
end

function Sfx.play(name, volumeScale)
	local def = Sfx.defs[name]
	if not def then
		return
	end
	for _, layer in def do
		local s = template(layer[1]):Clone()
		s.Volume = layer[2] * (volumeScale or 1)
		s.PlaybackSpeed = layer[3] * (1 + (math.random() * 2 - 1) * (layer[4] or 0))
		s.Parent = SoundService
		s:Play()
		s.Ended:Once(function()
			s:Destroy()
		end)
		task.delay(4, function()
			if s.Parent then
				s:Destroy()
			end
		end)
	end
end

function Sfx.preload()
	for _, def in Sfx.defs do
		for _, layer in def do
			template(layer[1])
		end
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">TuningPanel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- TuningPanel (Studio only, press T): change game-feel numbers live while you play, flip debug
-- helpers, and print the current values so you can paste them back into Config.luau.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AetherForge")
local Config = require(Shared.Config)
local Moves = require(Shared.Moves)
local Net = require(Shared.Net)

local Sfx = require(script.Parent.Sfx)

local TuningPanel = {}

-- { label, getter, setter, step, min, max }
local function cfgRow(label, tbl, key, step, min, max)
	return {
		label = label,
		get = function()
			return tbl[key]
		end,
		set = function(v)
			tbl[key] = v
		end,
		step = step,
		min = min,
		max = max,
	}
end

local ROWS = {
	{ header = "HITSTOP (seconds)" },
	cfgRow("Light hit", Config.Feel, "HitstopLight", 0.01, 0, 0.3),
	cfgRow("Finisher hit", Config.Feel, "HitstopFinisher", 0.01, 0, 0.3),
	cfgRow("Heavy hit", Config.Feel, "HitstopHeavy", 0.01, 0, 0.4),
	cfgRow("Crystal hit", Config.Feel, "HitstopCrystal", 0.01, 0, 0.3),
	cfgRow("Parry", Config.Feel, "HitstopParry", 0.01, 0, 0.3),
	{ header = "SCREEN SHAKE (trauma)" },
	cfgRow("Light", Config.Feel, "ShakeLight", 0.04, 0, 1),
	cfgRow("Finisher", Config.Feel, "ShakeFinisher", 0.04, 0, 1),
	cfgRow("Heavy", Config.Feel, "ShakeHeavy", 0.04, 0, 1),
	cfgRow("Parry", Config.Feel, "ShakeParry", 0.04, 0, 1),
	cfgRow("Getting hit", Config.Feel, "ShakeHurt", 0.04, 0, 1),
	{ header = "TIMING" },
	{
		label = "Parry window",
		get = function()
			return Moves.Parry.active[2]
		end,
		set = function(v)
			Moves.Parry.active[2] = v
		end,
		step = 0.01,
		min = 0.05,
		max = 0.3,
	},
	{
		label = "Dash i-frames",
		get = function()
			return Moves.Dash.iframes[2]
		end,
		set = function(v)
			Moves.Dash.iframes[2] = v
		end,
		step = 0.01,
		min = 0.05,
		max = 0.35,
	},
	cfgRow("Glint lead (parry cue)", Config.Feel, "GlintLead", 0.02, 0.1, 0.8),
	cfgRow("Parry slow-mo scale", Config.Feel, "ParrySlowmoScale", 0.05, 0.05, 1),
	cfgRow("Parry slow-mo time", Config.Feel, "ParrySlowmoDuration", 0.05, 0, 1.5),
	cfgRow("Input buffer", Config.Feel, "InputBuffer", 0.02, 0, 0.5),
	{ header = "AIM ASSIST + CAMERA" },
	cfgRow("Lock angle", Config.Feel, "SoftLockAngle", 5, 0, 120),
	cfgRow("Lock range", Config.Feel, "SoftLockRange", 1, 0, 40),
	cfgRow("Camera distance", Config.Camera, "Distance", 2, 20, 70),
	cfgRow("Camera pitch", Config.Camera, "Pitch", 2, 25, 85),
	cfgRow("Camera FOV", Config.Camera, "FOV", 2, 30, 90),
	cfgRow("Walk speed", Config.Player, "WalkSpeed", 1, 8, 40),
}

local TOGGLES = {
	{ label = "Slow-mo x0.25", key = "slowmo" },
	{ label = "Show hitboxes", key = "hitbox" },
	{ label = "Pause waves", key = "pause" },
	{ label = "Passive enemies", key = "passive" },
	{ label = "God mode", key = "god" },
}

local BUTTONS = {
	{ label = "Spawn Brute", cmd = "SpawnBrute" },
	{ label = "Kill all", cmd = "KillAll" },
	{ label = "Heal", cmd = "Heal" },
	{ label = "Reset run", cmd = "ResetRun" },
}

local function fmt(v, step)
	if step >= 1 then
		return string.format("%d", v)
	end
	return string.format("%.2f", v)
end

local function printValues()
	local lines = { "-- Aether Forge tuning (paste into Config.luau / Moves.luau)" }
	for _, r in ROWS do
		if r.get then
			table.insert(lines, string.format("%-22s = %s", r.label, fmt(r.get(), r.step)))
		end
	end
	print(table.concat(lines, "\n"))
end

function TuningPanel.init(combat)
	if not RunService:IsStudio() then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "AF_Tuning"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local panel = Instance.new("ScrollingFrame")
	panel.Size = UDim2.new(0, 300, 1, -140)
	panel.Position = UDim2.new(1, -316, 0, 70)
	panel.BackgroundColor3 = Color3.fromRGB(12, 12, 20)
	panel.BackgroundTransparency = 0.1
	panel.BorderSizePixel = 0
	panel.ScrollBarThickness = 6
	panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
	panel.CanvasSize = UDim2.new()
	panel.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = panel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 3)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = panel

	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local function text(parent, t, size, color, font)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Text = t
		l.TextSize = size
		l.Font = font or Enum.Font.GothamBold
		l.TextColor3 = color or Color3.new(1, 1, 1)
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = parent
		return l
	end

	local function button(parent, t, size, pos, color, onClick)
		local b = Instance.new("TextButton")
		b.Size = size
		b.Position = pos
		b.BackgroundColor3 = color
		b.BorderSizePixel = 0
		b.Text = t
		b.TextSize = 13
		b.Font = Enum.Font.GothamBlack
		b.TextColor3 = Color3.new(1, 1, 1)
		b.AutoButtonColor = true
		local cc = Instance.new("UICorner")
		cc.CornerRadius = UDim.new(0, 4)
		cc.Parent = b
		b.Parent = parent
		b.MouseButton1Click:Connect(function()
			Sfx.play("UI")
			onClick(b)
		end)
		return b
	end

	local title = text(panel, "TUNING  (T to close)", 15, Config.Palette.Aether, Enum.Font.GothamBlack)
	title.Size = UDim2.new(1, 0, 0, 22)
	title.LayoutOrder = nextOrder()

	for _, r in ROWS do
		if r.header then
			local h = text(panel, r.header, 12, Color3.fromRGB(150, 160, 190), Enum.Font.GothamBlack)
			h.Size = UDim2.new(1, 0, 0, 20)
			h.LayoutOrder = nextOrder()
		else
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 24)
			row.BackgroundTransparency = 1
			row.LayoutOrder = nextOrder()
			row.Parent = panel
			local l = text(row, r.label, 13)
			l.Size = UDim2.new(1, -110, 1, 0)
			local value = text(row, fmt(r.get(), r.step), 13, Color3.fromRGB(255, 220, 120), Enum.Font.GothamBlack)
			value.Size = UDim2.fromOffset(46, 24)
			value.Position = UDim2.new(1, -78, 0, 0)
			value.TextXAlignment = Enum.TextXAlignment.Center
			local function change(d)
				local v = math.clamp(r.get() + d, r.min, r.max)
				v = math.floor(v / r.step + 0.5) * r.step
				r.set(v)
				value.Text = fmt(v, r.step)
			end
			button(row, "-", UDim2.fromOffset(26, 22), UDim2.new(1, -108, 0, 1), Color3.fromRGB(60, 60, 84), function()
				change(-r.step)
			end)
			button(row, "+", UDim2.fromOffset(26, 22), UDim2.new(1, -28, 0, 1), Color3.fromRGB(60, 60, 84), function()
				change(r.step)
			end)
		end
	end

	local h = text(panel, "DEBUG", 12, Color3.fromRGB(150, 160, 190), Enum.Font.GothamBlack)
	h.Size = UDim2.new(1, 0, 0, 20)
	h.LayoutOrder = nextOrder()

	local toggles = {}
	for _, t in TOGGLES do
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 26)
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = nextOrder()
		holder.Parent = panel
		toggles[t.key] = false
		button(holder, t.label .. ": OFF", UDim2.new(1, 0, 1, -2), UDim2.new(), Color3.fromRGB(50, 50, 70), function(b)
			local on = not toggles[t.key]
			toggles[t.key] = on
			b.Text = t.label .. (if on then ": ON" else ": OFF")
			b.BackgroundColor3 = if on then Color3.fromRGB(30, 120, 150) else Color3.fromRGB(50, 50, 70)
			if t.key == "slowmo" then
				Config.Feel.DebugTimeScale = if on then 0.25 else 1
			elseif t.key == "hitbox" then
				combat.debugHitbox = on
			elseif t.key == "pause" then
				Net.Debug:FireServer("PauseWaves", on)
			elseif t.key == "passive" then
				Net.Debug:FireServer("Passive", on)
			elseif t.key == "god" then
				Net.Debug:FireServer("God", on)
			end
		end)
	end

	for _, bdef in BUTTONS do
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 26)
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = nextOrder()
		holder.Parent = panel
		button(holder, bdef.label, UDim2.new(1, 0, 1, -2), UDim2.new(), Color3.fromRGB(110, 60, 40), function()
			Net.Debug:FireServer(bdef.cmd)
		end)
	end

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 26)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = nextOrder()
	holder.Parent = panel
	button(holder, "Print values to Output", UDim2.new(1, 0, 1, -2), UDim2.new(), Color3.fromRGB(40, 110, 70), printValues)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.T then
			gui.Enabled = not gui.Enabled
		end
	end)
end

return TuningPanel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="46">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>