      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">AnimCore</string>
          <string name="Source"><![CDATA[--!nonstrict
-- AnimCore: the procedural animation engine (pure math, no Roblox instances).
--
-- A pose holds:
--   j      Motor6D.Transform values for directly-posed joints (Root, Waist, Neck, ...)
--   feet   { L, R } foot-target offsets from the rest ankle            (legs are solved with IK)
--   hand   { L, R } hand targets, absolute, relative to the root part   (arms are solved with IK)
--   pole   { L, R } which way each elbow should point
--   blade  Vector3(pitch, yaw, roll) in degrees: where the weapon points (the wrist is solved)
--   hilt   0..1, how much the left hand grips the hilt (two-handed moves)
-- feet/hand/pole/blade live in "root-yaw space": they turn with the Root joint's yaw (so spins carry
-- the body around) but ignore its pitch and height (so leans and crouches keep feet planted).
-- Rigs without `legs`/`arms` (the Brute) are posed purely by joint angles.
--
-- Clips are keyframes. Joint = { x, y, z, px, py, pz } degrees/studs; RHand/LHand = { x, y, z };
-- RPole/LPole = { x, y, z }; Blade = { pitch, yaw, roll }; Hilt = number. Anything missing in a key
-- holds the previous key (or the clip's base pose). A key with arc = true moves the hands along an
-- arc around the body instead of a straight line (use it for slashes).

local MathUtil = require(script.Parent.MathUtil)

local AnimCore = {}

local rad = math.rad
local Ease = MathUtil.Ease
local ZERO = Vector3.new(0, 0, 0)

function AnimCore.angles(a)
	local c = CFrame.fromEulerAnglesYXZ(rad(a[1] or 0), rad(a[2] or 0), rad(a[3] or 0))
	if a[4] or a[5] or a[6] then
		c = CFrame.new(a[4] or 0, a[5] or 0, a[6] or 0) * c
	end
	return c
end

function AnimCore.newPose()
	return {
		j = {},
		feet = { L = ZERO, R = ZERO },
		hand = {},
		pole = {},
		blade = nil,
		hilt = 0,
	}
end

function AnimCore.copy(p)
	return {
		j = table.clone(p.j),
		feet = { L = p.feet.L, R = p.feet.R },
		hand = { L = p.hand.L, R = p.hand.R },
		pole = { L = p.pole.L, R = p.pole.R },
		blade = p.blade,
		hilt = p.hilt,
	}
end

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

-- Build a pose from an authoring table (on top of an optional base pose).
function AnimCore.pose(def, base)
	local p = if base then AnimCore.copy(base) else AnimCore.newPose()
	for name, v in def do
		if name == "LFoot" then
			p.feet.L = v3(v)
		elseif name == "RFoot" then
			p.feet.R = v3(v)
		elseif name == "RHand" then
			p.hand.R = v3(v)
		elseif name == "LHand" then
			p.hand.L = v3(v)
		elseif name == "RPole" then
			p.pole.R = v3(v)
		elseif name == "LPole" then
			p.pole.L = v3(v)
		elseif name == "Blade" then
			p.blade = v3(v)
		elseif name == "Hilt" then
			p.hilt = v
		else
			p.j[name] = AnimCore.angles(v)
		end
	end
	return p
end

-- Cylindrical helper for authoring: angle (deg, 0 = in front, + = to the left), radius, height.
function AnimCore.cyl(a, r, h)
	local ar = rad(a)
	return { -math.sin(ar) * r, h, -math.cos(ar) * r }
end

local function lerpArc(a, b, w)
	-- interpolate around the vertical axis (angle, radius, height) so hands travel on an arc
	local aa = math.atan2(-a.X, -a.Z)
	local ab = math.atan2(-b.X, -b.Z)
	local d = MathUtil.angleDiff(aa, ab)
	local ang = aa + d * w
	local ra = math.sqrt(a.X * a.X + a.Z * a.Z)
	local rb = math.sqrt(b.X * b.X + b.Z * b.Z)
	local r = ra + (rb - ra) * w
	return Vector3.new(-math.sin(ang) * r, a.Y + (b.Y - a.Y) * w, -math.cos(ang) * r)
end

local function lerpV(a, b, w, arc)
	if a == nil then
		return b
	elseif b == nil then
		return a
	end
	if arc then
		return lerpArc(a, b, w)
	end
	return a:Lerp(b, w)
end

-- raw = { length = n, loop = bool?, keys = { { t = n, ease = "outCubic"?, arc = bool?, pose = {...} } } }
function AnimCore.compile(raw, base)
	local keys = {}
	local prev = base or AnimCore.newPose()
	for i, k in raw.keys do
		local p = AnimCore.pose(k.pose, prev)
		local ease = Ease[k.ease or "inOut"]
		assert(ease, "unknown ease " .. tostring(k.ease))
		keys[i] = { t = k.t, ease = ease, arc = k.arc, pose = p }
		prev = p
	end
	return { length = raw.length, loop = raw.loop, keys = keys }
end

function AnimCore.blend(a, b, w, arc)
	if w <= 0 then
		return a
	elseif w >= 1 then
		return b
	end
	local out = AnimCore.newPose()
	for name, ca in a.j do
		local cb = b.j[name]
		out.j[name] = if cb then ca:Lerp(cb, w) else ca
	end
	for name, cb in b.j do
		if out.j[name] == nil then
			out.j[name] = cb
		end
	end
	out.feet.L = a.feet.L:Lerp(b.feet.L, w)
	out.feet.R = a.feet.R:Lerp(b.feet.R, w)
	out.hand.R = lerpV(a.hand.R, b.hand.R, w, arc)
	out.hand.L = lerpV(a.hand.L, b.hand.L, w, arc)
	out.pole.R = lerpV(a.pole.R, b.pole.R, w)
	out.pole.L = lerpV(a.pole.L, b.pole.L, w)
	out.blade = lerpV(a.blade, b.blade, w)
	out.hilt = (a.hilt or 0) + ((b.hilt or 0) - (a.hilt or 0)) * w
	return out
end

function AnimCore.sample(clip, t)
	local keys = clip.keys
	if clip.loop and clip.length > 0 then
		t = t % clip.length
	end
	if t <= keys[1].t then
		return keys[1].pose
	end
	for i = 2, #keys do
		local k = keys[i]
		if t < k.t then
			local a = keys[i - 1]
			local span = k.t - a.t
			local u = if span > 0 then (t - a.t) / span else 1
			return AnimCore.blend(a.pose, k.pose, k.ease(u), k.arc)
		end
	end
	return keys[#keys].pose
end

-- Pre-multiply additive offsets (lean, flinch, jitter) onto a joint, in place.
function AnimCore.addPre(pose, joint, c)
	local cur = pose.j[joint] or CFrame.identity
	pose.j[joint] = c * cur
end

function AnimCore.addPost(pose, joint, c)
	local cur = pose.j[joint] or CFrame.identity
	pose.j[joint] = cur * c
end

local function yawOf(c)
	local look = c.LookVector
	if math.abs(look.Y) > 0.999 then
		return 0
	end
	return math.atan2(-look.X, -look.Z)
end
AnimCore.yawOf = yawOf

-- Two-bone IK in the parent's space. Returns the upper bone rotation and the middle joint angle.
-- Legs: the knee is pushed toward `pole` and bends with a negative angle.
-- Arms (flip = true): same geometry, but the frame is turned so the elbow bends with a positive
-- angle and the upper arm keeps its outward side facing out.
local function solve2Bone(root, target, pole, a, b, flip)
	local toT = target - root
	local dist = toT.Magnitude
	local dir = if dist > 1e-5 then toT / dist else Vector3.new(0, -1, 0)
	local d = math.clamp(dist, math.abs(a - b) + 1e-3, a + b - 1e-3)
	local axis = dir:Cross(pole)
	if axis.Magnitude < 1e-4 then
		axis = Vector3.new(if flip then -1 else 1, 0, 0)
	else
		axis = axis.Unit
	end
	local cosA = (a * a + d * d - b * b) / (2 * a * d)
	local alpha = math.acos(math.clamp(cosA, -1, 1))
	local upperDir = MathUtil.rotateAround(dir, axis, alpha)
	local cosK = (a * a + b * b - d * d) / (2 * a * b)
	local inner = math.acos(math.clamp(cosK, -1, 1))
	local bend = -(math.pi - inner)
	local Y = -upperDir
	local X = axis
	if flip then
		X = -axis
		bend = -bend
	end
	local Z = X:Cross(Y)
	return CFrame.fromMatrix(ZERO, X, Y, Z), bend
end
AnimCore.solve2Bone = solve2Bone

local function boneNamed(rig, jointName)
	for _, b in rig.bones do
		if b.joint == jointName then
			return b
		end
	end
	return nil
end

-- Precompute what the IK needs from a rig definition.
function AnimCore.ikInfo(rig, joints)
	local rootPos = rig.root.pos
	local info = { legs = nil, arms = nil, grip = nil }
	if rig.legs then
		info.legs = {}
		for side, leg in rig.legs do
			info.legs[side] = {
				hip = leg.hip,
				knee = leg.knee,
				ankle = leg.ankle,
				thigh = leg.thigh,
				shin = leg.shin,
				hipPivot = joints[leg.hip].c0.Position, -- in hips space
				restAnkle = boneNamed(rig, leg.ankle).pivot - rootPos, -- in root space
			}
		end
	end
	if rig.arms then
		info.arms = {}
		for side, arm in rig.arms do
			info.arms[side] = {
				shoulder = arm.shoulder,
				elbow = arm.elbow,
				upper = arm.upper,
				fore = arm.fore,
				pivot = joints[arm.shoulder].c0.Position, -- in chest space
				defaultPole = arm.pole,
			}
		end
		info.grip = rig.grip
	end
	return info
end

local function inParent(joints, name, t)
	local j = joints[name]
	return j.c0 * t * j.c1:Inverse()
end

local HILT_OFFSET = Vector3.new(0, 0, 0.55)

-- Elbow direction that never lines up with the arm: elbows point down-and-out when the hand is
-- raised or level, and back-and-out when the hand is low. `dir` = shoulder->hand (root-yaw space).
local function autoPole(dir, side)
	local down = math.clamp((-dir.Y - 0.3) / 0.6, 0, 1)
	down = down * down * (3 - 2 * down)
	local high = Vector3.new(side * 0.5, -1, 0.25)
	local low = Vector3.new(side * 0.5, -0.2, 1)
	return high:Lerp(low, down).Unit
end
AnimCore.autoPole = autoPole

-- Final transforms for a rig: copies pose.j and fills in IK-driven joints.
function AnimCore.solve(pose, joints, ik)
	local out = table.clone(pose.j)
	if not ik or (not ik.legs and not ik.arms) then
		return out
	end
	local rootT = out.Root or CFrame.identity
	local hipsInRoot = inParent(joints, "Root", rootT)
	local yawC = CFrame.Angles(0, yawOf(rootT), 0)

	if ik.legs then
		local hipsRot = hipsInRoot.Rotation
		local poleRoot = yawC.LookVector
		for side, leg in ik.legs do
			local target = yawC * (leg.restAnkle + pose.feet[side])
			local targetInHips = hipsInRoot:PointToObjectSpace(target)
			local pole = hipsInRoot:VectorToObjectSpace(poleRoot)
			local hipRot, kneeAngle = solve2Bone(leg.hipPivot, targetInHips, pole, leg.thigh, leg.shin, false)
			local kneeRot = CFrame.Angles(kneeAngle, 0, 0)
			out[leg.hip] = hipRot
			out[leg.knee] = kneeRot
			out[leg.ankle] = (hipsRot * hipRot * kneeRot):Inverse() * yawC
		end
	end

	if ik.arms and pose.hand.R then
		local chestInRoot = hipsInRoot * inParent(joints, "Waist", out.Waist or CFrame.identity)
		local chestRot = chestInRoot.Rotation
		local bladeLocal = nil
		if pose.blade then
			local b = pose.blade
			bladeLocal = CFrame.fromEulerAnglesYXZ(rad(b.X), rad(b.Y), rad(b.Z))
		end
		for side, arm in ik.arms do
			local handLocal = pose.hand[side]
			if side == "L" and bladeLocal and pose.hilt > 0 and pose.hand.R then
				local hiltPos = pose.hand.R + bladeLocal:VectorToWorldSpace(HILT_OFFSET)
				handLocal = if handLocal then handLocal:Lerp(hiltPos, pose.hilt) else hiltPos
			end
			if handLocal then
				local target = yawC * handLocal
				local poleLocal = pose.pole[side]
				if not poleLocal then
					local shoulderYaw = yawC:PointToObjectSpace(chestInRoot * arm.pivot)
					local toHand = handLocal - shoulderYaw
					local dir = if toHand.Magnitude > 1e-4 then toHand.Unit else Vector3.new(0, -1, 0)
					poleLocal = autoPole(dir, if side == "R" then 1 else -1)
				end
				local poleRoot = yawC:VectorToWorldSpace(poleLocal)
				local targetInChest = chestInRoot:PointToObjectSpace(target)
				local poleInChest = chestInRoot:VectorToObjectSpace(poleRoot)
				local upRot, elbowAngle = solve2Bone(arm.pivot, targetInChest, poleInChest, arm.upper, arm.fore, true)
				out[arm.shoulder] = upRot
				out[arm.elbow] = CFrame.Angles(elbowAngle, 0, 0)
				if side == "R" and bladeLocal and ik.grip then
					local foreRot = chestRot * upRot * out[arm.elbow]
					out[ik.grip] = foreRot:Inverse() * yawC * bladeLocal
				end
			end
		end
	end
	return out
end

-- Root-space CFrames of every bone for a set of transforms (preview tool and debug views).
function AnimCore.boneWorld(rig, joints, transforms, rootCF)
	local world = { [rig.root.name] = rootCF }
	-- bones are listed parent-first in the rig definitions
	for _, b in rig.bones do
		local j = joints[b.joint]
		local t = transforms[b.joint] or CFrame.identity
		world[b.name] = world[b.parent] * j.c0 * t * j.c1:Inverse()
	end
	return world
end

return AnimCore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ArenaLayout</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ArenaLayout: the floating arena as pure data. The server builds Parts from this list; the preview
-- tool renders the same list. Floor top is y = 0, the anvil sits at the origin, the camera looks
-- toward -Z.
--
-- Part spec: { name, shape, size, cf, color, material, transparency?, collide?, group?, light?,
--              castShadow?, kind? }

local ArenaLayout = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local rad = math.rad

local RADIUS = 60
ArenaLayout.Radius = RADIUS

local FLOOR = rgb(46, 46, 58)
local FLOOR_INNER = rgb(58, 56, 70)
local ROCK = rgb(40, 36, 46)
local ROCK2 = rgb(58, 52, 62)
local BRONZE = rgb(200, 134, 66)
local STEEL = rgb(70, 74, 90)
local AETHER = rgb(70, 225, 255)
local AETHER_DEEP = rgb(40, 110, 255)
local MOLTEN = rgb(255, 86, 36)

-- Vertical cylinder whose top face sits at `top`.
local function disc(list, name, radius, top, height, color, material, extra)
	local p = {
		name = name,
		shape = "Cylinder",
		size = V(height, radius * 2, radius * 2),
		cf = CFrame.new(0, top - height / 2, 0) * CFrame.Angles(0, 0, rad(90)),
		color = color,
		material = material,
		collide = true,
	}
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	table.insert(list, p)
	return p
end

local function discAt(list, name, pos, radius, top, height, color, material, extra)
	local p = disc(list, name, radius, top, height, color, material, extra)
	p.cf = CFrame.new(pos.X, top - height / 2, pos.Z) * CFrame.Angles(0, 0, rad(90))
	return p
end

local function block(list, name, size, cf, color, material, extra)
	local p = { name = name, shape = "Block", size = size, cf = cf, color = color, material = material, collide = true }
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	table.insert(list, p)
	return p
end

local function wedge(list, name, size, cf, color, material, extra)
	local p = block(list, name, size, cf, color, material, extra)
	p.shape = "Wedge"
	return p
end

-- Small deterministic PRNG so the arena decoration is identical every run.
local function rng(seed)
	local s = seed
	return function(a, b)
		s = (s * 1103515245 + 12345) % 2147483648
		local u = s / 2147483648
		return a + (b - a) * u
	end
end

local function polar(r, deg, y)
	local a = rad(deg)
	return V(math.sin(a) * r, y or 0, -math.cos(a) * r)
end
ArenaLayout.polar = polar

-- Gameplay points ---------------------------------------------------------------------------
ArenaLayout.PlayerSpawn = V(0, 4, 20)
ArenaLayout.AnvilPos = V(0, 0, 0)
ArenaLayout.AnvilRadius = 4.6 -- enemies steer around this circle
ArenaLayout.KillY = -60

ArenaLayout.Portals = {}
for i, deg in { 45, 135, 225, 315 } do
	ArenaLayout.Portals[i] = polar(46, deg)
end

ArenaLayout.CrystalSpots = {}
for _, deg in { 0, 90, 180, 270 } do
	table.insert(ArenaLayout.CrystalSpots, polar(24, deg))
end
for _, deg in { 22.5, 112.5, 202.5, 292.5 } do
	table.insert(ArenaLayout.CrystalSpots, polar(38, deg))
end

-- Geometry -----------------------------------------------------------------------------------
function ArenaLayout.build()
	local list = {}
	local r = rng(7)

	-- floor slab and the engraved rings (layered discs with tiny height offsets)
	disc(list, "Floor", RADIUS, 0, 4, FLOOR, "Slate")
	disc(list, "RingOuterGlow", RADIUS - 2.2, 0.02, 0.2, AETHER_DEEP, "Neon", { castShadow = false })
	disc(list, "RingOuterFill", RADIUS - 2.8, 0.04, 0.2, FLOOR, "Slate")
	disc(list, "RingMidGlow", 34.6, 0.06, 0.2, AETHER_DEEP, "Neon", { castShadow = false })
	disc(list, "RingMidFill", 34.0, 0.08, 0.2, FLOOR, "Slate")
	disc(list, "InnerPlate", 14.5, 0.1, 0.2, FLOOR_INNER, "Slate")
	disc(list, "RingInnerGlow", 13.6, 0.12, 0.2, AETHER, "Neon", { castShadow = false })
	disc(list, "RingInnerFill", 13.0, 0.14, 0.2, FLOOR_INNER, "Slate")

	-- rune spokes between the inner and mid rings
	for i = 0, 7 do
		local deg = i * 45 + 22.5
		local mid = polar(24.3, deg, 0.1)
		block(list, "Spoke", V(0.3, 0.2, 19), CFrame.new(mid) * CFrame.Angles(0, -rad(deg), 0), AETHER_DEEP, "Neon", { castShadow = false, collide = false, transparency = 0.25 })
	end

	-- floor tiles: a ring of slightly raised stone slabs near the edge for texture
	for i = 0, 35 do
		local deg = i * 10 + 5
		local pos = polar(RADIUS - 6.5, deg, 0.06)
		block(list, "Tile", V(7.2, 0.2, 5.2), CFrame.new(pos) * CFrame.Angles(0, -rad(deg), 0), if i % 2 == 0 then FLOOR_INNER else FLOOR, "Slate")
	end

	-- broken rim stones around the edge (decor only, enemies can still be knocked off)
	for i = 0, 47 do
		local deg = i * 7.5 + r(-1.5, 1.5)
		local h = r(0.5, 1.6)
		local pos = polar(RADIUS - 0.6, deg, h / 2 - 0.2)
		if i % 6 ~= 0 then
			block(list, "Rim", V(r(3, 4.5), h, 1.6), CFrame.new(pos) * CFrame.Angles(0, -rad(deg), rad(r(-6, 6))), ROCK2, "Basalt", { collide = false })
		end
	end

	-- island underside: stacked tapering rock
	local layers = { { 57, -4, 6 }, { 48, -10, 7 }, { 36, -17, 8 }, { 23, -25, 9 }, { 12, -34, 10 }, { 5, -44, 10 } }
	for i, l in layers do
		disc(list, "Underside" .. i, l[1], l[2], l[3], if i % 2 == 0 then ROCK else ROCK2, "Basalt", { collide = false })
	end
	-- jagged hanging rocks and glowing veins
	for i = 0, 15 do
		local deg = i * 22.5 + r(-8, 8)
		local rr = r(18, 50)
		local depth = -6 - (60 - rr) * 0.55
		local pos = polar(rr, deg, depth)
		local s = r(5, 10)
		wedge(list, "Jag", V(s, s * 1.6, s), CFrame.new(pos) * CFrame.Angles(rad(180), rad(r(0, 360)), rad(r(-15, 15))), ROCK, "Basalt", { collide = false })
		if i % 3 == 0 then
			block(list, "Vein", V(0.6, s * 1.2, 0.6), CFrame.new(pos + V(0, -s * 0.4, 0)) * CFrame.Angles(rad(r(-20, 20)), 0, rad(r(-20, 20))), AETHER, "Neon", { collide = false, castShadow = false })
		end
	end

	-- the forge anvil at the center
	discAt(list, "AnvilPedestal", V(0, 0, 0), 3.4, 1.2, 1.2, STEEL, "DiamondPlate")
	discAt(list, "AnvilRune", V(0, 0, 0), 4.1, 0.16, 0.2, MOLTEN, "Neon", { castShadow = false, collide = false })
	discAt(list, "AnvilRuneFill", V(0, 0, 0), 3.7, 0.18, 0.2, FLOOR_INNER, "Slate", { collide = false })
	block(list, "AnvilBase", V(2.6, 0.7, 2.0), CFrame.new(0, 1.55, 0), STEEL, "Metal")
	block(list, "AnvilWaist", V(1.6, 1.0, 1.3), CFrame.new(0, 2.4, 0), STEEL, "Metal")
	block(list, "AnvilFace", V(4.2, 0.7, 1.9), CFrame.new(0.3, 3.25, 0), rgb(96, 100, 118), "Metal")
	wedge(list, "AnvilHorn", V(1.9, 0.7, 1.6), CFrame.new(-2.75, 3.25, 0) * CFrame.Angles(0, rad(90), 0), rgb(96, 100, 118), "Metal")
	block(list, "AnvilHeel", V(0.8, 0.5, 1.5), CFrame.new(2.6, 3.0, 0), rgb(96, 100, 118), "Metal")
	block(list, "AnvilGlow", V(3.6, 0.08, 0.5), CFrame.new(0.3, 3.62, 0), MOLTEN, "Neon", { castShadow = false, collide = false, light = { color = MOLTEN, range = 16, brightness = 2 } })
	block(list, "AnvilBand", V(1.7, 0.2, 1.4), CFrame.new(0, 2.0, 0), BRONZE, "Metal")
	block(list, "ForgeCore", V(1.4, 1.4, 1.4), CFrame.new(0, 7.2, 0) * CFrame.Angles(rad(45), rad(45), 0), AETHER, "Neon", { castShadow = false, collide = false, kind = "ForgeCore", light = { color = AETHER, range = 22, brightness = 2.2 } })

	-- spawn portals
	for i, p in ArenaLayout.Portals do
		discAt(list, "PortalGlow" .. i, p, 4.4, 0.16, 0.2, MOLTEN, "Neon", { castShadow = false, collide = false })
		discAt(list, "PortalFill" .. i, p, 3.8, 0.18, 0.2, rgb(26, 20, 28), "Basalt", { collide = false })
		discAt(list, "PortalCore" .. i, p, 1.4, 0.2, 0.2, MOLTEN, "Neon", { castShadow = false, collide = false, transparency = 0.4, kind = "Portal", light = { color = MOLTEN, range = 10, brightness = 1 } })
		for k = 0, 2 do
			local deg = k * 120 + i * 30
			local sp = p + polar(5.4, deg, 1.4)
			block(list, "PortalStone", V(1.0, 2.8, 1.0), CFrame.new(sp) * CFrame.Angles(rad(8), rad(-deg), 0), ROCK2, "Basalt", { collide = false })
			block(list, "PortalStoneGlow", V(1.04, 0.2, 1.04), CFrame.new(sp + V(0, 0.9, 0)) * CFrame.Angles(rad(8), rad(-deg), 0), MOLTEN, "Neon", { castShadow = false, collide = false })
		end
	end

	-- floating obelisks framing the arena (outside the floor)
	for i = 0, 5 do
		local deg = i * 60 + 30
		local base = polar(70, deg, -2)
		disc(list, "ObeliskRock", 5, -1, 5, ROCK2, "Basalt", { collide = false }).cf = CFrame.new(base + V(0, -2.5, 0)) * CFrame.Angles(0, 0, rad(90))
		block(list, "Obelisk", V(3, 18, 3), CFrame.new(base + V(0, 8, 0)) * CFrame.Angles(0, rad(deg + 45), 0), ROCK, "Basalt", { collide = false })
		block(list, "ObeliskRune", V(3.1, 0.4, 3.1), CFrame.new(base + V(0, 13, 0)) * CFrame.Angles(0, rad(deg + 45), 0), AETHER, "Neon", { castShadow = false, collide = false })
		block(list, "ObeliskCrystal", V(2, 3.4, 2), CFrame.new(base + V(0, 20.5, 0)) * CFrame.Angles(rad(45), rad(deg), rad(45)), AETHER, "Neon", { castShadow = false, collide = false, kind = "Spin", light = { color = AETHER, range = 24, brightness = 1.6 } })
	end

	-- distant floating rocks to sell the "sky island" feel
	for i = 0, 17 do
		local deg = i * 20 + r(-8, 8)
		local pos = polar(r(105, 170), deg, r(-45, 25))
		local s = r(7, 22)
		block(list, "FarRock", V(s, s * 0.7, s * 0.9), CFrame.new(pos) * CFrame.Angles(rad(r(-20, 20)), rad(r(0, 90)), rad(r(-20, 20))), ROCK2, "Basalt", { collide = false })
		wedge(list, "FarRockBottom", V(s * 0.8, s * 1.2, s * 0.7), CFrame.new(pos + V(0, -s * 0.9, 0)) * CFrame.Angles(rad(180), rad(r(0, 90)), 0), ROCK, "Basalt", { collide = false })
		if i % 2 == 0 then
			block(list, "FarCrystal", V(1.6, s * 0.4, 1.6), CFrame.new(pos + V(0, s * 0.5, 0)) * CFrame.Angles(rad(r(-25, 25)), 0, rad(r(-25, 25))), if i % 4 == 0 then AETHER else MOLTEN, "Neon", { collide = false, castShadow = false })
		end
	end

	return list
end

-- Invisible ring wall that keeps players on the island (enemies are not blocked, so heavy slams
-- can knock them off the edge).
function ArenaLayout.barrier()
	local list = {}
	local n = 40
	for i = 0, n - 1 do
		local deg = i * 360 / n
		local pos = polar(RADIUS + 0.5, deg, 6)
		local width = 2 * math.pi * (RADIUS + 0.5) / n + 0.6
		block(list, "Barrier", V(width, 14, 1), CFrame.new(pos) * CFrame.Angles(0, -rad(deg), 0), rgb(0, 0, 0), "SmoothPlastic", { transparency = 1, group = "PlayerBarrier", castShadow = false })
	end
	return list
end

return ArenaLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Clips</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Clips: hand-authored keyframe animation for the player and the Brute, plus the procedural
-- idle/run/walk cycles. Angles are degrees: Joint = { x, y, z, px, py, pz }.
--   arms/legs: x+ swings forward,   torso/head/root: x+ leans back
--   y+ turns left, z+ raises the right arm out (left arm: z-)
-- Feet: LFoot/RFoot = { x, y, z } offset of the foot target from rest (y+ lifts, z- steps forward).
-- The player's arms and wrist are IK-driven: keys give hand positions and the blade direction
-- (see AnimCore). The Brute is posed with joint angles only.
-- Timings line up with Moves.luau (each slash crosses the front inside the move's active window).

local AnimCore = require(script.Parent.AnimCore)
local MathUtil = require(script.Parent.MathUtil)

local Clips = {}

local sin, cos, abs = math.sin, math.cos, math.abs
local P = AnimCore.pose

------------------------------------------------------------------------------------------------
-- Player
------------------------------------------------------------------------------------------------
local Player = {}
Clips.Player = Player

local C = AnimCore.cyl

-- Merge authoring tables (later ones win).
local function with(...)
	local out = {}
	for _, t in { ... } do
		for k, v in t do
			out[k] = v
		end
	end
	return out
end

-- Hands are positions relative to the root part (y = 0 is about belt height, the floor is y = -3.1).
-- C(angle, radius, height) places a hand around the body: angle 0 = in front, + = to the left.
-- Blade = { pitch (+ up), yaw (+ left), roll }.
local READY = {
	Root = { 0, -14, 0, 0, -0.22, 0 },
	Waist = { -4, 8, 0 },
	Neck = { 2, 6, 0 },
	RHand = C(-24, 1.55, -0.35),
	Blade = { 28, 10, 0 },
	LHand = C(18, 1.35, -0.15),
	Hilt = 0,
	LFoot = { -0.18, 0, -0.55 },
	RFoot = { 0.18, 0, 0.5 },
}

-- Combat-ready stance: left foot forward, blade held forward and up.
Player.Ready = P(READY)

local raw = {}

-- Light 1: horizontal slash, right to left.
raw.Light1 = {
	length = 0.34,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { 0, -28, 0, 0, -0.3, 0.1 }, Waist = { -6, -24, 0 }, Neck = { 0, 36, 0 },
			RHand = C(-112, 1.5, 0.85), Blade = { 14, -132, -70 }, LHand = C(30, 1.4, 0.0),
			LFoot = { -0.2, 0, -0.6 }, RFoot = { 0.2, 0, 0.55 },
		} },
		{ t = 0.06, ease = "outQuad", pose = {
			Root = { 0, -32, 0, 0, -0.32, 0.1 }, RHand = C(-118, 1.5, 0.9), Blade = { 16, -140, -70 },
		} },
		{ t = 0.11, ease = "outQuad", arc = true, pose = {
			Root = { -6, 20, 0, 0, -0.38, -0.25 }, Waist = { -10, 26, 0 }, Neck = { 0, -30, 0 },
			RHand = C(25, 2.15, 0.15), Blade = { -4, 60, -85 }, LHand = C(120, 1.3, -0.3),
			LFoot = { -0.15, 0, -1.05 }, RFoot = { 0.2, 0, 0.7 },
		} },
		{ t = 0.19, ease = "outQuad", arc = true, pose = {
			Root = { -4, 26, 0, 0, -0.34, -0.25 }, Waist = { -8, 32, 0 }, Neck = { 0, -40, 0 },
			RHand = C(72, 1.85, -0.05), Blade = { -12, 118, -85 },
		} },
		{ t = 0.34, ease = "inOut", arc = true, pose = {
			Root = { 0, 4, 0, 0, -0.26, -0.1 }, Waist = { -5, 14, 0 }, Neck = { 0, -12, 0 },
			RHand = C(20, 1.6, -0.3), Blade = { 22, 40, -30 }, LHand = C(30, 1.3, -0.15),
		} },
	},
}

-- Light 2: backhand slash, left to right.
raw.Light2 = {
	length = 0.34,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { 0, 28, 0, 0, -0.3, -0.1 }, Waist = { -6, 26, 0 }, Neck = { 0, -36, 0 },
			RHand = C(70, 1.15, 0.75), Blade = { 16, 150, 75 }, LHand = C(130, 1.2, -0.2),
			LFoot = { -0.15, 0, -0.9 }, RFoot = { 0.2, 0, 0.65 },
		} },
		{ t = 0.06, ease = "outQuad", pose = {
			Root = { 0, 32, 0, 0, -0.32, -0.1 }, RHand = C(78, 1.1, 0.8), Blade = { 18, 160, 75 },
		} },
		{ t = 0.11, ease = "outQuad", arc = true, pose = {
			Root = { -6, -22, 0, 0, -0.38, -0.3 }, Waist = { -10, -26, 0 }, Neck = { 0, 34, 0 },
			RHand = C(-30, 2.15, 0.1), Blade = { -4, -62, 85 }, LHand = C(40, 1.4, -0.1),
			LFoot = { -0.25, 0, -0.75 }, RFoot = { 0.15, 0, 1.0 },
		} },
		{ t = 0.19, ease = "outQuad", arc = true, pose = {
			Root = { -4, -28, 0, 0, -0.34, -0.3 }, Waist = { -8, -32, 0 }, Neck = { 0, 42, 0 },
			RHand = C(-80, 1.95, 0.0), Blade = { -12, -122, 85 },
		} },
		{ t = 0.34, ease = "inOut", arc = true, pose = {
			Root = { 0, -16, 0, 0, -0.26, -0.1 }, Waist = { -5, -4, 0 }, Neck = { 0, 16, 0 },
			RHand = C(-36, 1.65, -0.3), Blade = { 22, -10, 30 }, LHand = C(18, 1.35, -0.15),
		} },
	},
}

-- Light 3: crouch, then a hopping 360 spin slash (finisher).
raw.Light3 = {
	length = 0.56,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { -8, -40, 0, 0, -0.55, 0 }, Waist = { -14, -26, 0 }, Neck = { 6, 46, 0 },
			RHand = C(-140, 1.5, -0.2), Blade = { -4, -168, -80 }, LHand = C(40, 1.4, 0.1),
			LFoot = { -0.4, 0, -0.7 }, RFoot = { 0.4, 0, 0.6 },
		} },
		{ t = 0.12, ease = "outQuad", pose = {
			Root = { -10, -46, 0, 0, -0.62, 0 }, RHand = C(-146, 1.5, -0.2), Blade = { -4, -174, -80 },
		} },
		{ t = 0.17, ease = "linear", arc = true, pose = {
			Root = { -6, 60, 0, 0, 0.1, 0 }, Waist = { -6, 10, 0 }, Neck = { 0, 0, 0 },
			RHand = C(-70, 2.15, 0.15), Blade = { -6, -80, -85 }, LHand = C(110, 1.5, 0.3),
			LFoot = { -0.4, 0.35, -0.3 }, RFoot = { 0.4, 0.55, 0.3 },
		} },
		{ t = 0.21, ease = "linear", pose = { Root = { -6, 180, 0, 0, 0.35, 0 } } },
		{ t = 0.25, ease = "linear", pose = { Root = { -6, 300, 0, 0, 0.25, 0 } } },
		{ t = 0.29, ease = "outQuad", arc = true, pose = {
			Root = { -12, 372, 0, 0, -0.45, 0 }, Waist = { -12, 14, 0 },
			RHand = C(-10, 2.0, 0.0), Blade = { -10, 5, -85 },
			LFoot = { -0.45, 0, -0.75 }, RFoot = { 0.45, 0, 0.65 },
		} },
		{ t = 0.56, ease = "inOut", arc = true, pose = with(READY, { Root = { 0, -10, 0, 0, -0.26, 0 } }) },
	},
}

-- Heavy Slam: drop, rise with the blade overhead in both hands, hang, then slam into the floor.
raw.Heavy = {
	length = 0.92,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { -10, 0, 0, 0, -0.5, 0.1 }, Waist = { -16, 0, 0 }, Neck = { 10, 0, 0 },
			RHand = { 0.45, -1.0, -1.0 }, Blade = { -40, -4, 0 }, Hilt = 1,
			LFoot = { -0.3, 0, -0.5 }, RFoot = { 0.3, 0, 0.5 },
		} },
		{ t = 0.16, ease = "outCubic", pose = {
			Root = { 4, 0, 0, 0, 0.12, 0.15 }, Waist = { 8, 0, 0 }, Neck = { -4, 0, 0 },
			RHand = { 0.25, 2.35, 0.55 }, Blade = { 128, 0, 0 },
			LFoot = { -0.25, 0, -0.45 }, RFoot = { 0.25, 0, 0.55 },
		} },
		{ t = 0.33, ease = "linear", pose = {
			Root = { 5, 0, 0, 0, 0.18, 0.2 }, Waist = { 11, 0, 0 },
			RHand = { 0.25, 2.45, 0.75 }, Blade = { 138, 0, 0 },
		} },
		{ t = 0.37, ease = "inCubic", pose = {
			Root = { -4, 0, 0, 0, -0.1, -0.2 }, Waist = { -8, 0, 0 },
			RHand = { 0.25, 2.1, -1.5 }, Blade = { 70, 0, 0 },
		} },
		{ t = 0.4, ease = "linear", pose = {
			Root = { -14, 0, 0, 0, -0.7, -0.6 }, Waist = { -34, 0, 0 }, Neck = { 26, 0, 0 },
			RHand = { 0.25, -1.45, -2.05 }, Blade = { -20, 0, 0 },
			LFoot = { -0.3, 0, -1.25 }, RFoot = { 0.3, 0, 0.95 },
		} },
		{ t = 0.6, ease = "linear", pose = {
			Root = { -13, 0, 0, 0, -0.72, -0.6 }, Waist = { -32, 0, 0 },
		} },
		{ t = 0.92, ease = "inOut", pose = READY },
	},
}

-- Dash: squash down, stretch forward low with arms swept back, then land.
raw.Dash = {
	length = 0.27,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { -30, 0, 0, 0, -0.55, 0.2 }, Waist = { -12, 0, 0 }, Neck = { 22, 0, 0 },
			RHand = { 1.1, -0.7, 1.1 }, Blade = { -25, -165, 0 }, LHand = { -1.1, -0.6, 1.0 },
			LFoot = { -0.2, 0.25, -0.5 }, RFoot = { 0.2, 0.6, 1.0 },
		} },
		{ t = 0.12, ease = "outQuad", pose = {
			Root = { -38, 0, 0, 0, -0.25, -0.2 }, Waist = { -10, 0, 0 },
			RHand = { 1.15, -0.5, 1.4 }, LHand = { -1.15, -0.4, 1.3 },
			LFoot = { -0.2, 0.45, -0.2 }, RFoot = { 0.2, 0.7, 1.2 },
		} },
		{ t = 0.27, ease = "inOut", pose = with(READY, {
			Root = { -12, -8, 0, 0, -0.4, 0 }, Waist = { -8, 4, 0 }, Neck = { 6, 4, 0 },
			LFoot = { -0.2, 0, -0.6 }, RFoot = { 0.2, 0, 0.6 },
		}) },
	},
}

-- Parry: snap into a braced guard with the blade angled across the body.
local PARRY = {
	Root = { 4, 18, 0, 0, -0.38, 0.15 }, Waist = { 0, 20, 0 }, Neck = { -4, -30, 0 },
	RHand = { 0.55, -0.05, -1.35 }, Blade = { 52, 38, 75 }, LHand = { -0.35, 0.35, -1.45 },
	LFoot = { -0.3, 0, -0.45 }, RFoot = { 0.3, 0, 0.6 },
}
raw.Parry = {
	length = 0.46,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = PARRY },
		{ t = 0.17, ease = "linear", pose = { Root = { 6, 18, 0, 0, -0.4, 0.2 } } },
		{ t = 0.46, ease = "inOut", pose = READY },
	},
}

-- Riposte: the deflect flick that plays right after a successful parry.
raw.Riposte = {
	length = 0.32,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = PARRY },
		{ t = 0.07, ease = "outExpo", arc = true, pose = {
			Root = { -4, -20, 0, 0, -0.34, -0.1 }, Waist = { -6, -22, 0 }, Neck = { 0, 28, 0 },
			RHand = C(-15, 2.1, 0.25), Blade = { 8, -40, -70 }, LHand = C(90, 1.2, -0.3),
		} },
		{ t = 0.32, ease = "inOut", pose = READY },
	},
}

-- Hurt: knocked back off balance.
raw.Hurt = {
	length = 0.32,
	keys = {
		{ t = 0.0, ease = "outExpo", pose = {
			Root = { 20, 0, 0, 0, -0.3, 0.35 }, Waist = { 18, 0, 0 }, Neck = { 22, 0, 0 },
			RHand = { 1.6, 0.1, 0.2 }, Blade = { 45, -70, 0 }, LHand = { -1.6, 0.1, 0.2 },
			LFoot = { -0.25, 0, -0.2 }, RFoot = { 0.25, 0, 0.6 },
		} },
		{ t = 0.32, ease = "inOut", pose = READY },
	},
}

Player.clips = {}
for name, r in raw do
	Player.clips[name] = AnimCore.compile(r, Player.Ready)
end

-- Run pose pieces that do not depend on phase: lean in, blade trailing low behind.
local RUN_BASE = P({
	Root = { -12, 0, 0, 0, -0.32, 0 },
	Waist = { -6, 0, 0 },
	Neck = { 10, 0, 0 },
	RHand = { 1.05, -0.75, 0.35 },
	Blade = { -28, -160, 0 },
	LHand = { -1.05, -0.5, -0.3 },
}, Player.Ready)

-- st = { t, speed, moveLocal (unit vector in root space), phase }
-- Returns the locomotion pose (idle breathing blended with the run cycle).
function Player.locomotion(st)
	local breathe = sin(st.t * 2.2)
	local idle = AnimCore.copy(Player.Ready)
	AnimCore.addPre(idle, "Waist", CFrame.Angles(math.rad(breathe * 1.4), 0, 0))
	AnimCore.addPre(idle, "Root", CFrame.new(0, breathe * 0.03, 0))
	idle.hand.R = idle.hand.R + Vector3.new(0, breathe * 0.04, 0)
	idle.blade = idle.blade + Vector3.new(breathe * 1.5, 0, 0)

	local run01 = math.clamp(st.speed / 20, 0, 1)
	if run01 < 0.02 then
		return idle
	end

	local ph = st.phase
	local mv = st.moveLocal
	local stride = 1.35
	local lift = 0.75
	local run = AnimCore.copy(RUN_BASE)
	local cL, cR = cos(ph), cos(ph + math.pi)
	local sL, sR = sin(ph), sin(ph + math.pi)
	local mvFlat = Vector3.new(mv.X, 0, mv.Z)
	run.feet.L = Vector3.new(-0.05, lift * math.max(0, -sL), 0) + mvFlat * (stride * cL)
	run.feet.R = Vector3.new(0.05, lift * math.max(0, -sR), 0) + mvFlat * (stride * cR)
	local bob = abs(cL) * 0.16
	AnimCore.addPre(run, "Root", CFrame.new(0, bob, 0) * CFrame.Angles(0, math.rad(cL * 6), 0))
	AnimCore.addPre(run, "Waist", CFrame.Angles(0, math.rad(-cL * 10), 0))
	run.hand.L = run.hand.L + Vector3.new(0, 0.2 * abs(cL), 0.75 * cL)
	run.hand.R = run.hand.R + Vector3.new(0, 0.1 * abs(cR), 0.25 * cR)
	return AnimCore.blend(idle, run, run01)
end

-- How far (studs) the body travels per full run cycle.
Player.cycleDistance = 7.2

------------------------------------------------------------------------------------------------
-- Brute
------------------------------------------------------------------------------------------------
local Brute = {}
Clips.Brute = Brute

Brute.Idle = P({
	Root = { 0, 0, 0 },
	Waist = { -16, 0, 0 },
	Neck = { 14, 0, 0 },
	RShoulder = { 8, 0, 8 },
	RElbow = { 16, 0, 0 },
	LShoulder = { 8, 0, -8 },
	LElbow = { 16, 0, 0 },
	RHip = { 0, 0, 0 },
	LHip = { 0, 0, 0 },
})

local braw = {}

-- Windup is normalized to length 1: the client maps the real windup time onto it.
braw.Windup = {
	length = 1,
	keys = {
		{ t = 0.0, ease = "outQuad", pose = {
			Root = { 0, 0, 0, 0, -0.3, 0 }, Waist = { -24, 0, 0 },
			RShoulder = { 20, 0, 20 }, LShoulder = { 20, 0, -20 },
		} },
		{ t = 0.45, ease = "outCubic", pose = {
			Root = { 8, 0, 0, 0, 0.35, 0.3 }, Waist = { 14, 0, 0 }, Neck = { -4, 0, 0 },
			RShoulder = { 160, -12, 26 }, RElbow = { 34, 0, 0 },
			LShoulder = { 160, 12, -26 }, LElbow = { 34, 0, 0 },
			RHip = { -8, 0, 4 }, LHip = { 12, 0, -4 },
		} },
		{ t = 1.0, ease = "linear", pose = {
			Root = { 10, 0, 0, 0, 0.45, 0.4 }, Waist = { 18, 0, 0 },
			RShoulder = { 168, -12, 26 }, RElbow = { 40, 0, 0 },
			LShoulder = { 168, 12, -26 }, LElbow = { 40, 0, 0 },
		} },
	},
}

braw.Strike = {
	length = 0.25,
	keys = {
		{ t = 0.0, ease = "linear", pose = {
			Root = { 10, 0, 0, 0, 0.45, 0.4 }, Waist = { 18, 0, 0 }, Neck = { -4, 0, 0 },
			RShoulder = { 168, -12, 26 }, RElbow = { 40, 0, 0 },
			LShoulder = { 168, 12, -26 }, LElbow = { 40, 0, 0 },
			RHip = { -8, 0, 4 }, LHip = { 12, 0, -4 },
		} },
		{ t = 0.07, ease = "inQuart", pose = {
			Root = { -14, 0, 0, 0, -0.9, -0.9 }, Waist = { -42, 0, 0 }, Neck = { 30, 0, 0 },
			RShoulder = { 62, -16, 10 }, RElbow = { 4, 0, 0 },
			LShoulder = { 62, 16, -10 }, LElbow = { 4, 0, 0 },
			RHip = { -14, 0, 6 }, LHip = { 24, 0, -6 },
		} },
		{ t = 0.25, ease = "linear", pose = {
			Root = { -13, 0, 0, 0, -0.85, -0.85 }, Waist = { -40, 0, 0 },
		} },
	},
}

braw.Recover = {
	length = 0.75,
	keys = {
		{ t = 0.0, ease = "linear", pose = {
			Root = { -13, 0, 0, 0, -0.85, -0.85 }, Waist = { -40, 0, 0 }, Neck = { 30, 0, 0 },
			RShoulder = { 62, -16, 10 }, RElbow = { 4, 0, 0 },
			LShoulder = { 62, 16, -10 }, LElbow = { 4, 0, 0 },
			RHip = { -14, 0, 6 }, LHip = { 24, 0, -6 },
		} },
		{ t = 0.45, ease = "inOut", pose = {
			Root = { -8, 0, 0, 0, -0.6, -0.5 }, Waist = { -32, 0, 0 },
			RShoulder = { 40, -10, 10 }, LShoulder = { 40, 10, -10 },
		} },
		{ t = 0.75, ease = "inOut", pose = {
			Root = { 0, 0, 0 }, Waist = { -16, 0, 0 }, Neck = { 14, 0, 0 },
			RShoulder = { 8, 0, 8 }, RElbow = { 16, 0, 0 },
			LShoulder = { 8, 0, -8 }, LElbow = { 16, 0, 0 },
			RHip = { 0, 0, 0 }, LHip = { 0, 0, 0 },
		} },
	},
}

-- Spawn: climbs up out of the portal.
braw.Spawn = {
	length = 1.0,
	keys = {
		{ t = 0.0, ease = "linear", pose = {
			Root = { -30, 0, 0, 0, -2.6, 0 }, Waist = { -30, 0, 0 }, Neck = { 30, 0, 0 },
			RShoulder = { 90, 0, 30 }, LShoulder = { 90, 0, -30 },
		} },
		{ t = 0.7, ease = "outCubic", pose = {
			Root = { 6, 0, 0, 0, 0.2, 0 }, Waist = { 10, 0, 0 }, Neck = { -10, 0, 0 },
			RShoulder = { 40, 0, 60 }, RElbow = { 60, 0, 0 },
			LShoulder = { 40, 0, -60 }, LElbow = { 60, 0, 0 },
		} },
		{ t = 1.0, ease = "inOut", pose = {
			Root = { 0, 0, 0 }, Waist = { -16, 0, 0 }, Neck = { 14, 0, 0 },
			RShoulder = { 8, 0, 8 }, RElbow = { 16, 0, 0 },
			LShoulder = { 8, 0, -8 }, LElbow = { 16, 0, 0 },
		} },
	},
}

Brute.clips = {}
for name, r in braw do
	Brute.clips[name] = AnimCore.compile(r, Brute.Idle)
end

-- st = { t, speed, phase }
function Brute.locomotion(st)
	local breathe = sin(st.t * 1.6)
	local p = AnimCore.copy(Brute.Idle)
	AnimCore.addPre(p, "Waist", CFrame.Angles(math.rad(breathe * 2.5), 0, 0))
	AnimCore.addPre(p, "Root", CFrame.new(0, breathe * 0.05, 0))
	local w = math.clamp(st.speed / 12, 0, 1)
	if w > 0.02 then
		local ph = st.phase
		local s = sin(ph)
		AnimCore.addPre(p, "RHip", CFrame.Angles(math.rad(s * 28 * w), 0, 0))
		AnimCore.addPre(p, "LHip", CFrame.Angles(math.rad(-s * 28 * w), 0, 0))
		AnimCore.addPre(p, "RShoulder", CFrame.Angles(math.rad(-s * 22 * w), 0, 0))
		AnimCore.addPre(p, "LShoulder", CFrame.Angles(math.rad(s * 22 * w), 0, 0))
		AnimCore.addPre(p, "Root", CFrame.new(0, abs(cos(ph)) * 0.25 * w - 0.1 * w, 0) * CFrame.Angles(0, 0, math.rad(s * 5 * w)))
		AnimCore.addPre(p, "Waist", CFrame.Angles(math.rad(-6 * w), math.rad(s * 8 * w), 0))
	end
	return p
end

Brute.cycleDistance = 9

-- Stunned: dazed wobble (procedural, loops).
function Brute.stunned(t)
	local p = AnimCore.copy(Brute.Idle)
	p.j.Root = CFrame.new(0, -0.5, 0.3) * CFrame.Angles(math.rad(8), 0, math.rad(sin(t * 5) * 6))
	p.j.Waist = CFrame.Angles(math.rad(-30 + sin(t * 3) * 4), math.rad(sin(t * 2.4) * 12), 0)
	p.j.Neck = CFrame.Angles(math.rad(30), math.rad(sin(t * 4.2) * 25), math.rad(cos(t * 3.3) * 15))
	p.j.RShoulder = CFrame.Angles(math.rad(-4 + sin(t * 3) * 6), 0, math.rad(4))
	p.j.LShoulder = CFrame.Angles(math.rad(-4 - sin(t * 3) * 6), 0, math.rad(-4))
	p.j.RElbow = CFrame.Angles(math.rad(8), 0, 0)
	p.j.LElbow = CFrame.Angles(math.rad(8), 0, 0)
	return p
end

-- Keep MathUtil referenced for consumers that use Clips as their only animation import.
Clips.MathUtil = MathUtil

return Clips
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Config: every tuning number for the vertical slice lives here.
-- The in-game tuning panel (press T in Studio) edits the "Feel" and "Camera" values live on the client.
-- Values the server uses (enemy timings, damage) need a restart of the play session after editing.
-- All times are in seconds, distances in studs.

local Config = {}

Config.Player = {
	MaxHP = 100,
	WalkSpeed = 21,
	-- Walk speed kept while an attack plays (small drift keeps it from feeling sticky).
	AttackWalkSpeed = 4,
	-- How fast the character turns to face its move direction (higher = snappier).
	TurnSharpness = 28,
	-- After taking a hit: short stun, then mercy invulnerability.
	HurtStun = 0.32,
	HurtIFrames = 0.75,
	HurtKnockback = 34,
	-- Soft body radius used to keep the player from walking into enemies.
	BodyRadius = 1.4,
	-- Riposte: bonus damage window after a successful parry.
	RiposteDuration = 1.6,
	RiposteDamageMult = 1.5,
}

-- Game-feel values the tuning panel exposes.
Config.Feel = {
	HitstopLight = 0.06,
	HitstopFinisher = 0.11,
	HitstopHeavy = 0.17,
	HitstopCrystal = 0.07,
	HitstopParry = 0.09,
	-- Camera trauma added per event (0..1, shake strength grows with trauma squared).
	ShakeLight = 0.22,
	ShakeFinisher = 0.4,
	ShakeHeavy = 0.72,
	ShakeParry = 0.42,
	ShakeHurt = 0.5,
	ShakeSlamWhiff = 0.3,
	-- The enemy "glint" (flash + ping) appears this long before a strike lands. Reacting to it
	-- (~0.2s human reaction) lands your parry inside the parry window.
	GlintLead = 0.38,
	-- Parry slow-motion (real seconds and time scale).
	ParrySlowmoScale = 0.22,
	ParrySlowmoDuration = 0.38,
	-- Aim assist: attacks snap toward the best enemy inside this cone.
	SoftLockRange = 15,
	SoftLockAngle = 60,
	-- Light attacks pull you toward a locked target when it is within this distance.
	LungeMagnet = 9,
	-- Inputs pressed slightly early are remembered for this long.
	InputBuffer = 0.2,
	-- Global client time scale, for inspecting animations (tuning panel "Slow-mo").
	DebugTimeScale = 1,
}

Config.Camera = {
	Distance = 40,
	MinDistance = 26,
	MaxDistance = 58,
	Pitch = 54, -- degrees down from horizontal
	FOV = 52,
	FollowSharpness = 9,
	-- The camera leads slightly toward where you are moving / aiming.
	Lead = 3.5,
	ShakeMaxOffset = 1.1,
	ShakeMaxRoll = 2.6, -- degrees
	ShakeFrequency = 22,
	TraumaDecay = 1.9,
}

-- Every enemy attack has the same timeline shape: windup (telegraph) -> strike -> recover.
Config.Enemy = {
	Brute = {
		MaxHP = 120,
		MoveSpeed = 12.5,
		TurnSharpness = 7,
		Radius = 2.0,
		Mass = 30, -- only used for knockback feel scaling (bigger = flies less)
		AttackRange = 7.5, -- strike reach from its center
		AttackArc = 110, -- degrees
		Engage = 6.2, -- starts the windup when this close
		Windup = 0.72,
		-- During the last part of the windup the brute stops turning, so you can read and dodge it.
		TrackUntil = 0.55, -- fraction of the windup
		Recover = 0.75,
		Cooldown = 1.1,
		Damage = 18,
		StaggerResist = 0.0, -- 0 = light hits flinch it (outside windups)
		ParryStun = 1.7,
		SpawnTime = 1.0,
		XP = 10,
	},
	-- Seconds the server waits for a client to report how an incoming strike resolved.
	StrikeReportTimeout = 0.45,
	-- How long enemies stay slowed when someone parries nearby.
	ParrySlowRadius = 36,
}

Config.Crystal = {
	Common = {
		HP = 3, -- light hits chip 1, heavy shatters instantly
		Ore = 3,
		Color = Color3.fromRGB(80, 230, 255),
		Respawn = 9,
	},
	Spots = 3, -- active nodes at once in the slice
}

Config.Waves = {
	FirstDelay = 3.5,
	Breather = 6,
	SpawnInterval = 1.1,
	-- Enemies per wave = Base + (wave - 1) * Growth, capped.
	Base = 1,
	Growth = 1,
	Max = 7,
	HPScale = 0.1, -- +10% HP per wave
	WindupScale = 0.03, -- windups get 3% faster per wave
	MinWindup = 0.5,
}

Config.Arena = {
	Radius = 60,
}

-- Colors used across the game so the palette stays consistent.
Config.Palette = {
	Aether = Color3.fromRGB(70, 225, 255),
	AetherDeep = Color3.fromRGB(30, 120, 255),
	Ember = Color3.fromRGB(255, 136, 48),
	Molten = Color3.fromRGB(255, 78, 34),
	Gold = Color3.fromRGB(255, 214, 102),
	Danger = Color3.fromRGB(255, 60, 60),
	White = Color3.fromRGB(255, 255, 255),
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MathUtil</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MathUtil: easing curves, smoothing, springs and angle helpers shared by client, server and the preview tool.
-- Pure Luau (no Roblox services) so it can also run outside Roblox.

local MathUtil = {}

local TAU = math.pi * 2

function MathUtil.lerp(a, b, t)
	return a + (b - a) * t
end

-- 0..1 position of v between a and b, clamped.
function MathUtil.remap01(a, b, v)
	if b == a then
		return if v >= b then 1 else 0
	end
	return math.clamp((v - a) / (b - a), 0, 1)
end

-- Frame-rate independent exponential smoothing: higher sharpness = snappier.
function MathUtil.damp(current, target, sharpness, dt)
	return current + (target - current) * (1 - math.exp(-sharpness * dt))
end

-- Shortest signed difference b - a for angles in radians.
function MathUtil.angleDiff(a, b)
	return (b - a + math.pi) % TAU - math.pi
end

function MathUtil.dampAngle(current, target, sharpness, dt)
	return current + MathUtil.angleDiff(current, target) * (1 - math.exp(-sharpness * dt))
end

-- Yaw (radians, about +Y) whose CFrame.Angles(0, yaw, 0).LookVector points along dir (X/Z only).
function MathUtil.yawFromDir(dir)
	return math.atan2(-dir.X, -dir.Z)
end

function MathUtil.dirFromYaw(yaw)
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

function MathUtil.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function MathUtil.flatUnit(v, fallback)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return f.Unit
end

-- Implicit-Euler critically damped spring. Works for numbers and Vector3.
-- omega ~ responsiveness (rad/s). Returns new position, new velocity.
function MathUtil.spring(x, v, target, omega, dt)
	local f = 1 + 2 * dt * omega
	local oo = omega * omega
	local hoo = dt * oo
	local hhoo = dt * hoo
	local detInv = 1 / (f + hhoo)
	local nx = (x * f + v * dt + target * hhoo) * detInv
	local nv = (v + (target - x) * hoo) * detInv
	return nx, nv
end

-- Easing functions, t in 0..1 -> 0..1
local Ease = {}
Ease.linear = function(t)
	return t
end
Ease.inQuad = function(t)
	return t * t
end
Ease.outQuad = function(t)
	return 1 - (1 - t) * (1 - t)
end
Ease.inOut = function(t)
	return if t < 0.5 then 2 * t * t else 1 - ((-2 * t + 2) ^ 2) / 2
end
Ease.inCubic = function(t)
	return t * t * t
end
Ease.outCubic = function(t)
	return 1 - (1 - t) ^ 3
end
Ease.inOutCubic = function(t)
	return if t < 0.5 then 4 * t * t * t else 1 - ((-2 * t + 2) ^ 3) / 2
end
Ease.outQuart = function(t)
	return 1 - (1 - t) ^ 4
end
Ease.inQuart = function(t)
	return t ^ 4
end
Ease.outExpo = function(t)
	return if t >= 1 then 1 else 1 - 2 ^ (-10 * t)
end
Ease.inExpo = function(t)
	return if t <= 0 then 0 else 2 ^ (10 * t - 10)
end
Ease.outBack = function(t)
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end
-- Hold the previous key, then jump at the very end (for snaps).
Ease.step = function(t)
	return if t >= 1 then 1 else 0
end
MathUtil.Ease = Ease

-- 1D smooth noise in -1..1 used for camera shake, seeded per channel.
function MathUtil.noise1(t, seed)
	return math.noise(t, seed * 13.37, 0.5) * 2
end

-- Rotate vector v around unit axis k by angle a (Rodrigues).
function MathUtil.rotateAround(v, k, a)
	local c, s = math.cos(a), math.sin(a)
	return v * c + k:Cross(v) * s + k * (k:Dot(v) * (1 - c))
end

return MathUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Moves</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Moves: frame data for the player's moveset. Times are seconds from the start of the move.
--
--   active        window in which the hitbox is live (checked every frame)
--   chainFrom     earliest time a buffered attack can cancel into the next combo hit
--   comboGrace    after the move ends, pressing Light within this time continues the combo
--   dashCancel    list of {from, to} windows where a dash can cancel the move ("any" = always)
--   lunge         forward drive during startup {from, to, speed}
--   trail         weapon trail on/off window
--   hit           hitbox: "arc" (range + arc degrees in front) or "circle" (offset forward + radius)
--   hitstop/shake keys into Config.Feel so the tuning panel changes them live
--
-- The server re-checks range with some tolerance, and damage numbers come from here on both sides.

local Moves = {}

Moves.Light1 = {
	name = "Light1",
	kind = "Light",
	clip = "Light1",
	length = 0.34,
	active = { 0.065, 0.15 },
	chainFrom = 0.16,
	comboGrace = 0.32,
	dashCancel = "any",
	next = "Light2",
	damage = 9,
	crystalDamage = 1,
	knockback = 13,
	stagger = 0.3,
	hit = { shape = "arc", range = 7.8, arc = 130 },
	lunge = { from = 0.0, to = 0.1, speed = 22 },
	trail = { 0.03, 0.2 },
	hitstop = "HitstopLight",
	shake = "ShakeLight",
	swingSound = "Swing",
}

Moves.Light2 = {
	name = "Light2",
	kind = "Light",
	clip = "Light2",
	length = 0.34,
	active = { 0.065, 0.15 },
	chainFrom = 0.16,
	comboGrace = 0.32,
	dashCancel = "any",
	next = "Light3",
	damage = 10,
	crystalDamage = 1,
	knockback = 14,
	stagger = 0.3,
	hit = { shape = "arc", range = 7.8, arc = 130 },
	lunge = { from = 0.0, to = 0.1, speed = 22 },
	trail = { 0.03, 0.2 },
	hitstop = "HitstopLight",
	shake = "ShakeLight",
	swingSound = "Swing",
}

-- Finisher: a full spin that clears space around you.
Moves.Light3 = {
	name = "Light3",
	kind = "Light",
	clip = "Light3",
	length = 0.56,
	active = { 0.13, 0.27 },
	chainFrom = 999, -- combo ends here
	comboGrace = 0,
	dashCancel = "any",
	next = nil,
	damage = 16,
	crystalDamage = 1,
	knockback = 40,
	launch = 10,
	stagger = 0.55,
	hit = { shape = "circle", offset = 0.5, radius = 8.2 },
	lunge = { from = 0.02, to = 0.16, speed = 16 },
	trail = { 0.08, 0.32 },
	hitstop = "HitstopFinisher",
	shake = "ShakeFinisher",
	swingSound = "SwingBig",
}

-- Heavy Slam: big anticipation, ground impact, shatters crystals and breaks enemy windups.
Moves.Heavy = {
	name = "Heavy",
	kind = "Heavy",
	clip = "Heavy",
	length = 0.92,
	active = { 0.4, 0.47 },
	chainFrom = 0.66,
	comboGrace = 0,
	dashCancel = { { 0, 0.36 }, { 0.62, 0.92 } },
	next = nil,
	damage = 30,
	crystalDamage = 99,
	knockback = 70,
	launch = 22,
	stagger = 0.75,
	breaksWindup = true,
	hit = { shape = "circle", offset = 4.6, radius = 7.2 },
	lunge = { from = 0.3, to = 0.4, speed = 26 },
	trail = { 0.3, 0.5 },
	hitstop = "HitstopHeavy",
	shake = "ShakeHeavy",
	swingSound = "SwingHeavy",
}

Moves.Dash = {
	name = "Dash",
	kind = "Dash",
	clip = "Dash",
	length = 0.27,
	iframes = { 0, 0.21 },
	speedStart = 90,
	speedEnd = 26,
	cooldown = 0.4,
	-- You can attack out of a dash after this time (dash -> Light1 feels great for closing distance).
	attackFrom = 0.14,
}

Moves.Parry = {
	name = "Parry",
	kind = "Parry",
	clip = "Parry",
	length = 0.46,
	active = { 0.0, 0.17 },
	cooldown = 0.5,
}

-- Played after a successful parry; can be cancelled into anything immediately.
Moves.Riposte = {
	name = "Riposte",
	kind = "Riposte",
	clip = "Riposte",
	length = 0.32,
}

Moves.Hurt = {
	name = "Hurt",
	kind = "Hurt",
	clip = "Hurt",
	length = 0.32,
}

-- Server-side sanity limits: minimum seconds between two different swings of the same kind.
Moves.MinSwingInterval = {
	Light = 0.12,
	Heavy = 0.55,
}

-- Extra reach the server allows on top of the hitbox to cover latency.
Moves.ServerRangeTolerance = 6

return Moves
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Net: the RemoteEvents (declared in default.project.json under ReplicatedStorage.AetherNet).
--
-- Client -> Server
--   Action(kind, serverTime)                    a move started (for validation + other clients)
--   Hit(moveName, swingId, { targets })         the local hitbox touched these enemies/crystals
--   StrikeReport(enemy, strikeId, outcome)      how an enemy strike resolved for this player
--                                               ("parry" | "dodge" | "hurt" | "miss")
--   Debug(command, arg)                         Studio-only test commands (tuning panel)
-- Server -> Client
--   Fx(kind, data)                              effects other clients should see
--   Run(kind, data)                             wave / run flow (Wave, WaveCleared, Defeat, Reset)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:WaitForChild("AetherNet")

return {
	Action = folder:WaitForChild("Action") :: RemoteEvent,
	Hit = folder:WaitForChild("Hit") :: RemoteEvent,
	StrikeReport = folder:WaitForChild("StrikeReport") :: RemoteEvent,
	Debug = folder:WaitForChild("Debug") :: RemoteEvent,
	Fx = folder:WaitForChild("Fx") :: RemoteEvent,
	Run = folder:WaitForChild("Run") :: RemoteEvent,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RigBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- RigBuilder: turns a rig definition from Rigs.luau into real Parts, Motor6Ds and welds.
-- Used by the server (player StarterCharacter, Brutes) and by the client (afterimage ghosts).

local Rigs = require(script.Parent.Rigs)

local RigBuilder = {}

local function makePart(shape, size, color, material)
	local p
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "CornerWedge" then
		p = Instance.new("CornerWedgePart")
	else
		p = Instance.new("Part")
		if shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		elseif shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		end
	end
	p.Size = size
	p.Color = color or Color3.new(1, 1, 1)
	p.Material = Enum.Material[material or "SmoothPlastic"]
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end
RigBuilder.makePart = makePart

local function addLight(part, light)
	local l = Instance.new("PointLight")
	l.Color = light.color
	l.Range = light.range or 8
	l.Brightness = light.brightness or 1
	l.Shadows = false
	l.Parent = part
	return l
end
RigBuilder.addLight = addLight

-- Builds the model at the origin (feet on y = 0, facing -Z).
-- opts = { name, weapon = weaponDef?, collisionGroup = string? }
-- Returns model, { parts = {[name] = BasePart}, motors = {[jointName] = Motor6D} }
function RigBuilder.build(rig, opts)
	opts = opts or {}
	local joints, rest = Rigs.computeJoints(rig)
	local model = Instance.new("Model")
	model.Name = opts.name or "Rig"

	local parts = {}
	local root = makePart("Block", rig.root.size, Color3.new(1, 1, 1), "SmoothPlastic")
	root.Name = rig.root.name
	root.Transparency = 1
	root.CFrame = rest[rig.root.name]
	root.CanCollide = true
	root.CanTouch = false
	root.CastShadow = false
	root.Parent = model
	parts[rig.root.name] = root

	for _, b in rig.bones do
		local p = makePart(b.shape or "Block", b.size, b.color, b.material)
		p.Name = b.name
		p.CFrame = rest[b.name]
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		if b.invisible then
			p.Transparency = 1
			p.CastShadow = false
		end
		p.Parent = model
		parts[b.name] = p
	end

	local motors = {}
	for name, j in joints do
		local m = Instance.new("Motor6D")
		m.Name = name
		m.Part0 = parts[j.part0]
		m.Part1 = parts[j.part1]
		m.C0 = j.c0
		m.C1 = j.c1
		m.Parent = parts[j.part1]
		motors[name] = m
	end

	local function attach(bone, d, offset)
		local p = makePart(d.shape, d.size, d.color, d.material)
		p.Name = bone.Name .. "_Detail"
		p.CFrame = bone.CFrame * offset
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		if d.material == "Neon" then
			p.CastShadow = false
		end
		local w = Instance.new("Weld")
		w.Part0 = bone
		w.Part1 = p
		w.C0 = offset
		w.Parent = p
		p.Parent = model
		if d.light then
			addLight(p, d.light)
		end
		return p
	end

	for _, d in rig.decor do
		attach(parts[d.bone], d, Rigs.decorOffset(rest, d))
	end

	if opts.weapon and rig.weaponBone then
		local wb = parts[rig.weaponBone]
		for _, d in opts.weapon.parts do
			local p = attach(wb, d, d.cf)
			p.Name = "Blade_Detail"
		end
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailBase"
		a0.Position = opts.weapon.trailBase
		a0.Parent = wb
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailTip"
		a1.Position = opts.weapon.trailTip
		a1.Parent = wb
	end

	if opts.collisionGroup then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = opts.collisionGroup
			end
		end
	end

	model.PrimaryPart = root
	return model, { parts = parts, motors = motors }
end

-- Collect Motor6Ds of an existing model by joint name.
function RigBuilder.findMotors(model)
	local motors = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	return motors
end

return RigBuilder
]]></string>
        </Properties>
